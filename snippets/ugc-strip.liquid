{%- comment -%}
	ugc-strip — the scrolling row of UGC testimonial cards with its drag to
	scroll, auto-advance and video lightbox. Shared by sections/ugc-gallery
	(full overlay cards) and the kit buy box in sections/product (compact
	cards with the caption under the frame), so the behaviour lives once.
	The scroll maths is physical, so the track stays left to right on Arabic
	pages (CLAUDE.md rule 9); each card takes the page direction back through
	card_dir.
	Params:
		id             — unique per instance on the page (section.id or a word).
		entries        — the ugc_testimonial metaobject entries.
		layout         — optional. 'gallery' (default) or 'compact', passed to
		                 ugc-card.
		card_dir       — passed to ugc-card ('rtl' on Arabic pages).
		track_classes  — optional. Extra classes on the track, e.g. a top margin.
		progress_track — optional. Track classes for the progress bar under the
		                 row; blank hides the bar.
		progress_fill  — optional. Fill classes for that bar.
{%- endcomment -%}
{%- liquid
	assign strip_layout = layout | default: 'gallery'
-%}
<div data-ugc-strip="{{ id }}">
	{%- comment -%}
		data-poster-group: cards off to the side of this track only intersect
		once swiped or auto-advanced in, so assets/lazy-video.js sets every
		deferred poster in the track as soon as the first one comes near.
		data-tile-track: the observer root assets/lazy-video.js measures the
		tiles against for left and right (which are visible, which is next).
	{%- endcomment -%}
	<div class="flex gap-3 overflow-x-auto scrollbar-none cursor-grab scroll-smooth {{ track_classes }}" data-ugc-track data-poster-group data-tile-track dir="ltr">
		{%- for entry in entries -%}
			{%- render 'ugc-card', entry: entry, card_dir: card_dir, layout: strip_layout -%}
		{%- endfor -%}
	</div>

	{%- if progress_track != blank -%}
		<div class="mt-6 mx-auto w-48 md:w-64 h-1 rounded-full {{ progress_track }} overflow-hidden" dir="ltr">
			<div class="h-full rounded-full {{ progress_fill }} transition-[width] duration-100" data-ugc-progress style="width: 0%;"></div>
		</div>
	{%- endif -%}

	{%- comment -%}
		Video lightbox, one per strip, filled from the card's template on click.
		The close button has its own row above the video, never over it, and
		ugc-player-frame (assets/critical.source.css) sizes the 9:16 box from
		the visible screen height, so the box and its controls fit with the
		browser bars showing or hidden. The unmute button only shows when the
		browser refused sound and the video had to start muted.
	{%- endcomment -%}
	<div
		data-ugc-modal
		class="ugc-player fixed inset-0 z-100 hidden items-center justify-center bg-black/80"
		role="dialog"
		aria-modal="true"
		aria-hidden="true"
		aria-label="{{ 'sections.ugc_gallery.video_player' | t }}"
	>
		<div data-ugc-frame class="ugc-player-frame flex flex-col items-end gap-2">
			<button
				type="button"
				data-ugc-close
				class="shrink-0 w-11 h-11 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors"
				aria-label="{{ 'general.close_video' | t }}"
			>
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"/></svg>
			</button>
			<div class="relative w-full aspect-9/16">
				<div data-ugc-modal-holder class="absolute inset-0 rounded-2xl overflow-hidden bg-black"></div>
				<button
					type="button"
					data-ugc-unmute
					class="absolute top-3 start-3 w-11 h-11 rounded-full bg-black/60 hover:bg-black/80 text-white hidden items-center justify-center transition-colors"
					aria-label="{{ 'general.unmute_video' | t }}"
				>
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linejoin="round" d="M11 5 6 9H3v6h3l5 4z"/><path stroke-linecap="round" d="m16 9 5 6m0-6-5 6"/></svg>
				</button>
			</div>
		</div>
	</div>
</div>

<script>
(function () {
	var root = document.querySelector('[data-ugc-strip="{{ id }}"]');
	if (!root) return;
	var track = root.querySelector('[data-ugc-track]');
	var bar = root.querySelector('[data-ugc-progress]');
	if (!track) return;

	/* ── Scroll progress ── */
	function updateProgress() {
		if (!bar) return;
		var max = track.scrollWidth - track.clientWidth;
		if (max <= 0) { bar.style.width = '100%'; return; }
		var pct = (track.scrollLeft / max) * 100;
		bar.style.width = Math.max(5, Math.min(100, pct)) + '%';
	}
	track.addEventListener('scroll', updateProgress, { passive: true });
	updateProgress();

	/* ── Drag to scroll (desktop) ── */
	var isDown = false, startX = 0, scrollLeft = 0, hasDragged = false;

	track.addEventListener('mousedown', function (e) {
		isDown = true;
		hasDragged = false;
		startX = e.pageX - track.offsetLeft;
		scrollLeft = track.scrollLeft;
		track.style.cursor = 'grabbing';
		track.style.scrollBehavior = 'auto';
	});

	window.addEventListener('mousemove', function (e) {
		if (!isDown) return;
		var x = e.pageX - track.offsetLeft;
		var delta = startX - x;
		if (Math.abs(delta) > 4) hasDragged = true;
		track.scrollLeft = scrollLeft + delta;
	});

	window.addEventListener('mouseup', function () {
		if (!isDown) return;
		isDown = false;
		track.style.cursor = '';
		track.style.scrollBehavior = '';
		resetAutoplay();
	});

	track.addEventListener('click', function (e) {
		if (hasDragged) e.stopPropagation();
	}, true);

	/* ── Auto-scroll every 6 seconds ── */
	var autoTimer = null;
	var userTouching = false;
	var modalOpen = false;

	function getCardStep() {
		var card = track.firstElementChild;
		if (!card) return 200;
		return card.getBoundingClientRect().width + 12; /* 12 = gap-3 */
	}

	/* A step that would pass the end stops at the end, and the tick after
	   that goes back to the start, so the last card comes fully into view. */
	function autoScroll() {
		if (userTouching || isDown || document.hidden || modalOpen) return;
		var max = track.scrollWidth - track.clientWidth;
		if (track.scrollLeft >= max - 2) {
			track.scrollTo({ left: 0, behavior: 'smooth' });
		} else {
			track.scrollTo({ left: Math.min(track.scrollLeft + getCardStep(), max), behavior: 'smooth' });
		}
	}

	/* No restart while the player is open, whatever the pointer does over
	   the overlay; closeModal() starts it again. */
	function resetAutoplay() {
		clearInterval(autoTimer);
		if (modalOpen) return;
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		autoTimer = setInterval(autoScroll, 6000);
	}

	/* Pause on touch / hover */
	track.addEventListener('touchstart', function () { userTouching = true; clearInterval(autoTimer); }, { passive: true });
	track.addEventListener('touchend', function () { userTouching = false; resetAutoplay(); }, { passive: true });
	track.addEventListener('mouseenter', function () { clearInterval(autoTimer); });
	track.addEventListener('mouseleave', function () { if (!isDown) resetAutoplay(); });

	/* ── Video lightbox ── */
	var modal = root.querySelector('[data-ugc-modal]');
	var modalFrame = modal && modal.querySelector('[data-ugc-frame]');
	var modalHolder = modal && modal.querySelector('[data-ugc-modal-holder]');
	var closeBtn = modal && modal.querySelector('[data-ugc-close]');
	var unmuteBtn = modal && modal.querySelector('[data-ugc-unmute]');

	function showUnmute(on) {
		if (!unmuteBtn) return;
		unmuteBtn.classList.toggle('hidden', !on);
		unmuteBtn.classList.toggle('flex', on);
	}

	/* If the browser refuses sound, start muted and offer the unmute button. */
	function startPlayer(v) {
		var p = v.play();
		if (!p || typeof p.catch !== 'function') return;
		p.catch(function (err) {
			if (!err || err.name !== 'NotAllowedError' || v.muted) return;
			v.muted = true;
			showUnmute(true);
			var retry = v.play();
			if (retry && typeof retry.catch === 'function') retry.catch(function () {});
		});
	}

	function openModal(card) {
		var tpl = card.querySelector('[data-ugc-modal-content]');
		if (!tpl || !modalHolder || !modal) return;
		/* Every tile pauses and drops its file, and the row stops moving, so the
		   player has the connection to itself. */
		var lazy = window.airaLazyVideo;
		if (lazy && lazy.suspendTiles) lazy.suspendTiles(root);
		modalOpen = true;
		clearInterval(autoTimer);
		showUnmute(false);
		modalHolder.innerHTML = '';
		modalHolder.appendChild(tpl.content.cloneNode(true));
		modal.classList.remove('hidden');
		modal.classList.add('flex');
		modal.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
		var v = modalHolder.querySelector('video');
		if (!v) return;
		/* The player plays the file for this screen (720p below md, 1080p from
		   md up). A src attribute outranks the <source> list, so if that file
		   errors, dropping the attribute hands the browser today's sources:
		   the HLS stream, then the 1080p mp4. */
		var src = lazy && lazy.pickSource ? lazy.pickSource(v) : '';
		if (src) {
			v.setAttribute('src', src);
			v.addEventListener('error', function fallback() {
				v.removeEventListener('error', fallback);
				if (!v.hasAttribute('src')) return;
				v.removeAttribute('src');
				v.load();
				startPlayer(v);
			});
		}
		v.addEventListener('volumechange', function () {
			if (!v.muted) showUnmute(false);
		});
		/* iOS Safari does not run source selection on a <video> cloned out of a
		   <template>: without load() the player opens black at 00:00. load()
		   then play() inside the tap keeps the user gesture, so sound is allowed. */
		v.load();
		startPlayer(v);
	}

	function closeModal() {
		if (!modal || !modalHolder) return;
		var v = modalHolder.querySelector('video');
		if (v) {
			/* Drop the file so its download stops before the tiles come back. */
			v.pause();
			v.removeAttribute('src');
			v.innerHTML = '';
			v.load();
		}
		modalHolder.innerHTML = '';
		showUnmute(false);
		modal.classList.add('hidden');
		modal.classList.remove('flex');
		modal.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
		modalOpen = false;
		var lazy = window.airaLazyVideo;
		if (lazy && lazy.resumeTiles) lazy.resumeTiles(root);
		resetAutoplay();
	}

	if (unmuteBtn) {
		unmuteBtn.addEventListener('click', function () {
			var v = modalHolder.querySelector('video');
			if (v) v.muted = false;
			showUnmute(false);
		});
	}

	root.querySelectorAll('[data-ugc-card]').forEach(function (card) {
		card.addEventListener('click', function () {
			if (hasDragged) return;
			openModal(card);
		});
		card.addEventListener('keydown', function (e) {
			if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
				e.preventDefault();
				openModal(card);
			}
		});
	});

	if (closeBtn) closeBtn.addEventListener('click', closeModal);
	if (modal) {
		modal.addEventListener('click', function (e) {
			if (e.target === modal || e.target === modalFrame) closeModal();
		});
	}
	document.addEventListener('keydown', function (e) {
		if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) closeModal();
	});

	/* Start the auto-advance */
	resetAutoplay();
})();
</script>
