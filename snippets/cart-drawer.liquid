{%- comment -%}
	snippets/cart-drawer.liquid
	Slide-out cart drawer with refill upsell.
	Included once in theme.liquid before </body>.
{%- endcomment -%}

{%- assign refill_product = all_products['aira-refill-tabs'] -%}
{%- assign refill_variant = refill_product.selected_or_first_available_variant | default: refill_product.variants.first -%}

{%- comment -%}
	Launch offer: one free pouch per kit. The drawer keeps the gift line's
	quantity in step with the kit's, so the handle below names which lines count
	as kits. If that product is ever renamed the handle comes back blank and the
	sync stays out of the way, leaving quantities to Shopify.
{%- endcomment -%}
{%- assign kit_product = all_products['aira-kit'] -%}

<style>
	.cart-drawer-closed { transform: translateX(calc(100% + 0.75rem)); }
	.cart-drawer-open   { transform: translateX(0); }
</style>

{%- comment -%} Backdrop {%- endcomment -%}
<div
	data-cart-backdrop
	class="fixed inset-0 z-60 bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
	aria-hidden="true"
></div>

{%- comment -%} Drawer {%- endcomment -%}
<aside
	data-cart-drawer
	data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
	data-kit-handle="{{ kit_product.handle }}"
	style="max-width: min(32rem, calc(100vw - 1.5rem));"
	class="fixed top-3 right-3 bottom-3 z-61 w-full bg-bg shadow-2xl rounded-2xl transition-transform duration-300 ease-out flex flex-col overflow-hidden cart-drawer-closed"
	aria-label="Shopping cart"
>
	{%- comment -%} Header {%- endcomment -%}
	<div class="flex items-center justify-between px-6 py-5 border-b border-bg-muted">
		<h2 class="font-heading font-semibold text-title text-xl">Your cart</h2>
		<button data-cart-close class="text-copy hover:text-title transition-colors cursor-pointer" aria-label="Close cart">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
			</svg>
		</button>
	</div>

	{%- comment -%} Scrollable body — data-lenis-prevent keeps native scroll here (Lenis ignores it) {%- endcomment -%}
	<div class="flex-1 overflow-y-auto px-6 py-5" data-cart-body data-lenis-prevent>

		{%- comment -%} Empty state {%- endcomment -%}
		<div data-cart-empty class="hidden flex-col items-center justify-center text-center py-16 gap-4">
			<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" class="text-copy opacity-25">
				<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
			</svg>
			<p class="text-copy text-base">Your cart is empty</p>
			{%- render 'cta-button',
				label: 'Get my kit',
				url: '/products/aira-kit',
				variant: 'solid'
			-%}
		</div>

		{%- comment -%} Line items (rendered by JS) {%- endcomment -%}
		<div data-cart-items class="flex flex-col gap-4"></div>

		{%- comment -%} Upsell — refill tabs {%- endcomment -%}
		{%- if refill_product != blank and refill_variant != blank -%}
			<div data-cart-upsell class="hidden mt-6 p-5 rounded-2xl border border-border bg-bg-soft">
				<p class="text-xs font-bold uppercase tracking-widest text-highlight mb-3">Complete your kit</p>
				<div class="flex items-center gap-4">
					{%- if refill_product.featured_image -%}
						<a href="{{ refill_product.url }}" class="shrink-0 w-16 h-16 rounded-xl overflow-hidden bg-bg-muted">
							{{ refill_product.featured_image | image_url: width: 128 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover' }}
						</a>
					{%- endif -%}
					<div class="flex-1 min-w-0">
						<p class="font-heading font-semibold text-title text-base leading-snug truncate">{%- render 'product-title', title: refill_product.title -%}</p>
						<p class="text-copy text-base mt-0.5">{{ refill_variant.price | money }}</p>
					</div>
					{%- capture upsell_attrs -%}data-upsell-add data-upsell-variant-id="{{ refill_variant.id }}"{%- endcapture -%}
					{%- render 'cta-button',
						label: 'Add',
						variant: 'outline',
						size: 'sm',
						element: 'button',
						attributes: upsell_attrs,
						extra_classes: 'shrink-0'
					-%}
				</div>
			</div>
		{%- endif -%}

		{%- comment -%} Trust badge {%- endcomment -%}
		<div class="mt-8 text-center text-copy/30 text-xs">
			<p class="flex items-center justify-center gap-2">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
					<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
					<path d="M7 11V7a5 5 0 0110 0v4"></path>
				</svg>
				Secure checkout
			</p>
		</div>

	</div>

	{%- comment -%} Footer — subtotal + checkout {%- endcomment -%}
	<div data-cart-footer class="hidden border-t border-border px-6 py-5 flex-col gap-4">
		<div class="flex items-center justify-between">
			<span class="font-heading font-semibold text-title text-lg">Subtotal</span>
			<span class="font-heading font-bold text-title text-xl" data-cart-subtotal></span>
		</div>
		<p class="text-center text-highlight text-sm font-semibold">Free shipping to the UAE and Saudi Arabia.</p>
		{%- render 'cta-button',
			label: 'Checkout',
			url: '/checkout',
			variant: 'solid',
			size: 'lg',
			full_width: true,
			attributes: 'data-cart-checkout',
			extra_classes: '!px-6 !font-bold'
		-%}
		<button type="button" data-cart-close class="w-full text-center text-copy text-sm font-semibold hover:text-title transition-colors cursor-pointer">
			Continue shopping
		</button>
	</div>
</aside>

<script>
(function () {
	/* ── Refs ── */
	var backdrop = document.querySelector('[data-cart-backdrop]');
	var drawer   = document.querySelector('[data-cart-drawer]');
	var currency = drawer.getAttribute('data-currency');
	var itemsEl  = document.querySelector('[data-cart-items]');
	var emptyEl  = document.querySelector('[data-cart-empty]');
	var upsellEl = document.querySelector('[data-cart-upsell]');
	var footerEl = document.querySelector('[data-cart-footer]');
	var subtotalEl = document.querySelector('[data-cart-subtotal]');
	var upsellBtn  = document.querySelector('[data-upsell-add]');

	var REFILL_HANDLE = 'aira-refill-tabs';
	var KIT_HANDLE = drawer.getAttribute('data-kit-handle');
	var isOpen = false;
	/* Last rendered cart, so a click resolves its line against real state
	   rather than the markup, and clicks queue instead of racing each other. */
	var currentCart = null;
	var queue = Promise.resolve();

	/* ── Gift opt-out ──
	   A visitor who removes the free pouch has said no to it, so it stays out
	   for the rest of this tab's session rather than returning on the next
	   add-to-cart. sessionStorage, not localStorage: a new tab or a new visit
	   is a fresh start, and the flag also clears once the cart renders empty. */
	var GIFT_REMOVED_KEY = 'aira.cart.giftRemoved';

	function giftRemoved() {
		try { return sessionStorage.getItem(GIFT_REMOVED_KEY) === '1'; } catch (e) { return false; }
	}

	function markGiftRemoved() {
		try { sessionStorage.setItem(GIFT_REMOVED_KEY, '1'); } catch (e) {}
	}

	function clearGiftRemoved() {
		try { sessionStorage.removeItem(GIFT_REMOVED_KEY); } catch (e) {}
	}

	/* ── Open / close ── */
	function open() {
		if (isOpen) return;
		isOpen = true;
		backdrop.classList.remove('opacity-0', 'pointer-events-none');
		backdrop.classList.add('opacity-100', 'pointer-events-auto');
		drawer.classList.remove('cart-drawer-closed');
		drawer.classList.add('cart-drawer-open');
		document.body.style.overflow = 'hidden';
	}

	function close() {
		if (!isOpen) return;
		isOpen = false;
		backdrop.classList.add('opacity-0', 'pointer-events-none');
		backdrop.classList.remove('opacity-100', 'pointer-events-auto');
		drawer.classList.remove('cart-drawer-open');
		drawer.classList.add('cart-drawer-closed');
		document.body.style.overflow = '';
	}

	document.querySelectorAll('[data-cart-close]').forEach(function (b) { b.addEventListener('click', close); });
	backdrop.addEventListener('click', close);
	document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });

	/* ── Cart icon clicks → open drawer ── */
	document.querySelectorAll('[data-cart-toggle]').forEach(function (el) {
		el.addEventListener('click', function (e) {
			e.preventDefault();
			open();
			fetchAndRender();
		});
	});

	/* ── Intercept all add-to-cart forms ── */
	document.addEventListener('submit', function (e) {
		var form = e.target;
		if (!form.matches('form[action*="/cart/add"]')) return;
		e.preventDefault();

		var formData = new FormData(form);
		var btn = form.querySelector('[data-add-to-cart]');
		/* Keep the markup: the label can be two lines, so restore rather than retype */
		var btnMarkup = btn ? btn.innerHTML : '';
		function resetBtn() {
			if (!btn) return;
			btn.disabled = false;
			btn.innerHTML = btnMarkup;
		}
		if (btn) { btn.disabled = true; btn.textContent = 'Adding...'; }

		fetch('/cart/add.js', {
			method: 'POST',
			body: formData
		})
		.then(function (r) { return r.json(); })
		.then(function () {
			return addGift(form.getAttribute('data-gift-variant-id'));
		})
		.then(function () {
			return fetchAndRender();
		})
		.then(function () {
			open();
			resetBtn();
		})
		.catch(resetBtn);
	});

	/* ── Free gift ──
	   A Buy X Get Y automatic discount only zeroes the gift once the gift is
	   in the cart, so a form carrying data-gift-variant-id adds it here.
	   The cart is read first, so a repeat add-to-cart never stacks a second one:
	   a second kit raises the quantity of the line already there instead.
	   A visitor who removed the gift this session is not handed it again. */
	function addGift(giftId) {
		var id = parseInt(giftId, 10);
		if (!id || giftRemoved()) return Promise.resolve();

		return fetchCart()
			.then(function (cart) {
				var alreadyThere = cart.items.some(function (item) {
					return item.variant_id === id;
				});
				if (alreadyThere) return;

				return fetch('/cart/add.js', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ items: [{ id: id, quantity: 1 }] })
				});
			})
			.catch(function () {});
	}

	/* ── Upsell add ── */
	if (upsellBtn) {
		upsellBtn.addEventListener('click', function () {
			var vid = upsellBtn.getAttribute('data-upsell-variant-id');
			upsellBtn.disabled = true;
			upsellBtn.textContent = 'Adding...';

			fetch('/cart/add.js', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ items: [{ id: parseInt(vid, 10), quantity: 1 }] })
			})
			.then(function () { return fetchAndRender(); })
			.then(function () {
				upsellBtn.disabled = false;
				upsellBtn.textContent = 'Add';
			})
			.catch(function () {
				upsellBtn.disabled = false;
				upsellBtn.textContent = 'Add';
			});
		});
	}

	/* ── Cart requests ── */
	function fetchCart() {
		return fetch('/cart.js').then(function (r) { return r.json(); });
	}

	function changeLine(key, qty) {
		return fetch('/cart/change.js', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ id: key, quantity: qty })
		})
		.then(function (r) { return r.json(); })
		.then(function (cart) {
			/* A refused change (stock, stale key) answers with an error body, so
			   fall back to the real cart rather than rendering nothing. */
			return cart && cart.items ? cart : fetchCart();
		});
	}

	/* ── Free gift quantity ──
	   The offer gives a free pouch per kit, and Shopify only zeroes the pouches
	   it can already see in the cart. While the two counts disagree it splits the
	   kit across a discounted line and an undiscounted one, which is what showed
	   up as a duplicate kit row. Keeping the gift line level with the kit both
	   scales the offer and keeps the kit on one line. */
	function isFreeGift(item) {
		return item.final_line_price === 0 && item.line_level_total_discount > 0;
	}

	function giftLine(cart) {
		return cart.items.filter(isFreeGift)[0];
	}

	function kitQty(cart) {
		if (!KIT_HANDLE) return 0;
		return cart.items.reduce(function (total, item) {
			return item.handle === KIT_HANDLE ? total + item.quantity : total;
		}, 0);
	}

	function variantQty(cart, variantId) {
		return cart.items.reduce(function (total, item) {
			return item.variant_id === variantId ? total + item.quantity : total;
		}, 0);
	}

	/* Moves the gift variant to `want`, re-reading the cart between steps because
	   Shopify rewrites line keys as the discount moves between lines. */
	function syncGift(cart, want, guard) {
		var gift = giftLine(cart);
		/* No zeroed line means no live offer, so pouches here were paid for. */
		if (!gift || want < 1 || guard > 3) return Promise.resolve(cart);

		var lines = cart.items.filter(function (item) {
			return item.variant_id === gift.variant_id;
		});
		var total = lines.reduce(function (n, item) { return n + item.quantity; }, 0);
		if (want === total) return Promise.resolve(cart);

		var target, qty;
		if (want > total) {
			target = gift;
			qty = gift.quantity + (want - total);
		} else {
			/* Any surplus sits on the undiscounted portion, so take it from there. */
			var paid = lines.filter(function (item) { return !isFreeGift(item); })[0];
			target = paid || gift;
			qty = Math.max(0, target.quantity - (total - want));
		}

		return changeLine(target.key, qty).then(function (next) {
			return syncGift(next, want, guard + 1);
		});
	}

	/* ── Fetch cart & render ── */
	function fetchAndRender() {
		return fetchCart()
			.then(function (cart) {
				/* Top up only. A cart left from before the counts were kept in step
				   still shows the kit split in two until the pouches catch up, and
				   only ever raising the count keeps paid pouches untouched. */
				var gift = giftLine(cart);
				if (!gift) return cart;
				var want = Math.max(variantQty(cart, gift.variant_id), kitQty(cart));
				return syncGift(cart, want, 0);
			})
			.then(render);
	}

	function render(cart) {
		var hasItems = cart.item_count > 0;
		currentCart = cart;
		/* An empty cart ends the visitor's earlier no to the gift. */
		if (!hasItems) clearGiftRemoved();

		/* Toggle empty / filled states */
		emptyEl.classList.toggle('hidden', hasItems);
		emptyEl.classList.toggle('flex', !hasItems);
		itemsEl.classList.toggle('hidden', !hasItems);
		footerEl.classList.toggle('hidden', !hasItems);
		footerEl.classList.toggle('flex', hasItems);

		/* Update header cart counts */
		document.querySelectorAll('[data-cart-count]').forEach(function (el) {
			el.textContent = cart.item_count;
			el.closest('[data-cart-count-bubble]').classList.toggle('hidden', cart.item_count === 0);
		});

		/* Subtotal */
		if (subtotalEl) subtotalEl.textContent = formatMoney(cart.total_price);

		/* Check if refills already in cart */
		var hasRefills = cart.items.some(function (item) {
			return item.handle === REFILL_HANDLE;
		});
		if (upsellEl) {
			upsellEl.classList.toggle('hidden', !hasItems || hasRefills);
		}

		/* Build line items */
		itemsEl.innerHTML = cart.items.map(function (item) {
			/* The product title sits beside the thumbnail, so the image only
			   speaks when the merchant has written an alt on it. Otherwise it
			   stays empty and screen readers skip past it to the title. */
			var img = item.featured_image && item.featured_image.url
				? '<img src="' + sizedImg(item.featured_image.url, '160x') + '" alt="' + escAttr(item.featured_image.alt || '') + '" class="w-full h-full object-cover" loading="lazy">'
				: '';
			var props = '';
			if (item.variant_title) {
				props = '<p class="text-copy text-sm mt-0.5">' + escHtml(item.variant_title) + '</p>';
			}
			/* Discount labels, always read off the line's allocations, never static
			   copy. Only allocations that actually discount this line: the Buy X
			   Get Y discount also attaches a zero-amount allocation to the kit line.
			   A zeroed gift line reads as the one offer that freed it (title only,
			   largest allocation, so a stray allocation can never relabel the gift).
			   A paid line shows each discount with the amount it took off, e.g.
			   "Refill pack saving −$3.99", summed per title in case Shopify ever
			   spreads one discount over several allocations of the line. */
			var allocs = (item.line_level_discount_allocations || []).filter(function (alloc) {
				return alloc.amount > 0;
			});
			var discounts = '';
			if (isFreeGift(item)) {
				var top = allocs.sort(function (a, b) { return b.amount - a.amount; })[0];
				var giftTitle = top && (top.discount_application ? top.discount_application.title : top.title);
				discounts = giftTitle ? '<p class="text-highlight text-sm font-semibold mt-0.5">' + escHtml(giftTitle) + '</p>' : '';
			} else {
				var byTitle = {};
				allocs.forEach(function (alloc) {
					var title = alloc.discount_application ? alloc.discount_application.title : alloc.title;
					if (!title) return;
					byTitle[title] = (byTitle[title] || 0) + alloc.amount;
				});
				discounts = Object.keys(byTitle).map(function (title) {
					return '<p class="text-highlight text-sm font-semibold mt-0.5">' + escHtml(title) + ' −' + formatMoney(byTitle[title]) + '</p>';
				}).join('');
			}
			/* A fully free gift line has no stepper: its quantity follows the kit,
			   and remove stays. Paying for more refills happens on the product page,
			   and a paid line reprices above zero, so the stepper returns there. */
			var qtyControls = isFreeGift(item)
				? '<div class="flex items-center border border-bg-muted rounded-lg">'
					+ '<span class="w-8 h-8 flex items-center justify-center text-base font-semibold text-title">' + item.quantity + '</span>'
				+ '</div>'
				: '<div class="flex items-center border border-bg-muted rounded-lg">'
					+ '<button type="button" data-qty-change="-1" data-line-key="' + item.key + '" class="w-8 h-8 flex items-center justify-center text-copy hover:text-title transition-colors text-base cursor-pointer">−</button>'
					+ '<span class="w-8 h-8 flex items-center justify-center text-base font-semibold text-title">' + item.quantity + '</span>'
					+ '<button type="button" data-qty-change="1" data-line-key="' + item.key + '" class="w-8 h-8 flex items-center justify-center text-copy hover:text-title transition-colors text-base cursor-pointer">+</button>'
				+ '</div>';
			return '<div class="flex gap-4 items-start" data-line-key="' + item.key + '">'
				+ '<a href="' + item.url + '" class="shrink-0 w-20 h-20 rounded-xl overflow-hidden bg-bg-muted">' + img + '</a>'
				+ '<div class="flex-1 min-w-0">'
					+ '<p class="font-heading font-semibold text-title text-base leading-snug">' + brandTitle(item.product_title) + '</p>'
					+ props
					+ discounts
					+ '<div class="flex items-center gap-3 mt-2">'
						+ qtyControls
						+ '<span class="shrink-0 font-heading font-bold text-title text-base">' + formatMoney(item.final_line_price) + '</span>'
					+ '</div>'
					+ '<button type="button" data-line-remove data-line-key="' + item.key + '" class="text-copy/40 hover:text-highlight transition-colors mt-1 cursor-pointer" aria-label="Remove"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"></path></svg></button>'
				+ '</div>'
			+ '</div>';
		}).join('');
	}

	/* ── Quantity change / remove (event delegation) ── */
	itemsEl.addEventListener('click', function (e) {
		var qtyBtn = e.target.closest('[data-qty-change]');
		var removeBtn = e.target.closest('[data-line-remove]');

		if (qtyBtn) {
			var delta = parseInt(qtyBtn.getAttribute('data-qty-change'), 10);
			enqueue(qtyBtn.getAttribute('data-line-key'), function (line) {
				return updateLine(line.key, Math.max(0, line.quantity + delta));
			});
		}

		if (removeBtn) {
			enqueue(removeBtn.getAttribute('data-line-key'), function (line) {
				/* Removing the free pouch is a choice, remembered for this session
				   so the next add-to-cart does not put it straight back. */
				if (isFreeGift(line)) markGiftRemoved();
				return updateLine(line.key, 0);
			});
		}
	});

	/* Clicks run one at a time and resolve their line when their turn comes:
	   a cart change can rewrite line keys, and the quantity has to come from the
	   cart rather than markup a queued click has already outdated. */
	function enqueue(key, run) {
		queue = queue
			.then(function () {
				var line = lineFor(key);
				if (line) return run(line);
			})
			.catch(function () { return fetchAndRender(); });
		return queue;
	}

	function lineFor(key) {
		if (!currentCart || !key) return null;
		var exact = currentCart.items.filter(function (item) { return item.key === key; })[0];
		if (exact) return exact;
		/* Key churn: the line merged, so fall back to the variant it merged into. */
		var variantId = parseInt(key.split(':')[0], 10);
		return currentCart.items.filter(function (item) {
			return item.variant_id === variantId;
		})[0] || null;
	}

	function updateLine(key, qty) {
		var before = currentCart;
		return changeLine(key, qty)
			.then(function (cart) {
				var delta = before ? kitQty(cart) - kitQty(before) : 0;
				var gift = before ? giftLine(before) : null;
				if (!delta || !gift) return cart;
				/* Pouches follow the kit one for one. The floor of one keeps the
				   long-standing behaviour where removing the kit leaves a single
				   pouch behind to reprice rather than emptying the cart. */
				var want = Math.max(1, variantQty(before, gift.variant_id) + delta);
				return syncGift(cart, want, 0);
			})
			.then(render);
	}

	/* ── Helpers ── */
	function formatMoney(cents) {
		return (cents / 100).toLocaleString(undefined, { style: 'currency', currency: currency });
	}

	function sizedImg(url, size) {
		/* Shopify CDN: insert _160x before the file extension */
		return url.replace(/(\.\w+)(\?|$)/, '_' + size + '$1$2');
	}

	function escHtml(str) {
		var d = document.createElement('div');
		d.textContent = str;
		return d.innerHTML;
	}

	/* escHtml leaves quotes alone, which is fine inside an element but not
	   inside a double-quoted attribute value. */
	function escAttr(str) {
		return escHtml(str).replace(/"/g, '&quot;');
	}

	/* The Ajax cart returns raw admin product titles ("Aira Kit"), so the
	   brand is lowercased here to match the product-title snippet used
	   everywhere the titles are rendered in Liquid. */
	function brandTitle(str) {
		return escHtml(str).replace(/\bAIRA\b/g, 'aira').replace(/\bAira\b/g, 'aira');
	}

	/* ── Init: pre-load cart state ── */
	fetchAndRender();
})();
</script>
