{%- comment -%}
	snippets/cart-drawer.liquid
	Slide-out cart drawer with refill upsell.
	Included once in theme.liquid before </body>.

	Every Shopify cart write costs most of a second (0.7 to 0.9 s measured on
	2026-09-22, a read about 0.3 s), so the script spends as few as it can.
	An add-to-cart is one add call that carries the kit and its free pouch
	together, then one read. A quantity change is one update call, keyed by
	line position, that moves the kit and the pouch in step. Quantities change
	on screen the moment they are tapped, and a submitted form draws its rows
	at once from the catalogue written below; prices and totals keep their
	last known values, dimmed, until Shopify answers. The Checkout link waits
	for anything still in flight.

	The drawer does no price maths (redesign brief, 2026-10-13): every amount
	on screen is a figure from /cart.js or a sum of them, so it matches
	checkout to the cent. Shopify can split one variant over several lines (a
	free pouch beside a paid one), so the drawer shows one row per variant and
	a tap acts on the variant.
{%- endcomment -%}

{%- assign refill_product = all_products['aira-refill-tabs'] -%}
{%- assign refill_variant = refill_product.selected_or_first_available_variant | default: refill_product.variants.first -%}

{%- comment -%}
	Launch offer: one free pouch per kit. The drawer keeps the gift line's
	quantity in step with the kit's, so the handle below names which lines count
	as kits. If that product is ever renamed the handle comes back blank and the
	sync stays out of the way, leaving quantities to Shopify.
{%- endcomment -%}
{%- assign kit_product = all_products['aira-kit'] -%}
{%- assign kit_variant = kit_product.selected_or_first_available_variant | default: kit_product.variants.first -%}

<style>
	.cart-drawer-closed { transform: translateX(calc(100% + 0.75rem)); }
	.cart-drawer-open   { transform: translateX(0); }
</style>

{%- comment -%} Backdrop {%- endcomment -%}
<div
	data-cart-backdrop
	class="fixed inset-0 z-60 bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
	aria-hidden="true"
></div>

{%- comment -%}
	Drawer. `group` plus aria-busy lets the prices dim through the
	group-aria-busy: utilities while a cart call is in flight.
{%- endcomment -%}
<aside
	data-cart-drawer
	data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
	data-kit-handle="{{ kit_product.handle }}"
	style="max-width: min(32rem, calc(100vw - 1.5rem));"
	class="group fixed top-3 right-3 bottom-3 z-61 w-full bg-bg shadow-2xl rounded-2xl transition-transform duration-300 ease-out flex flex-col overflow-hidden cart-drawer-closed"
	aria-label="{{ 'snippets.cart_drawer.shopping_cart' | t }}"
	aria-busy="false"
	data-i18n-updating="{{ 'snippets.cart_drawer.updating' | t | escape_once }}"
	data-i18n-adding="{{ 'snippets.cart_drawer.adding' | t | escape_once }}"
	data-i18n-add="{{ 'general.add' | t | escape_once }}"
	data-i18n-add-failed="{{ 'snippets.cart_drawer.add_failed' | t | escape_once }}"
	data-i18n-update-failed="{{ 'snippets.cart_drawer.update_failed' | t | escape_once }}"
	data-i18n-decrease="{{ 'snippets.cart_drawer.decrease_quantity' | t | escape_once }}"
	data-i18n-increase="{{ 'snippets.cart_drawer.increase_quantity' | t | escape_once }}"
	data-i18n-remove="{{ 'cart.remove' | t | escape_once }}"
	data-i18n-free="{{ 'snippets.cart_drawer.free' | t | escape_once }}"
	data-i18n-free-gift="{{ 'snippets.cart_drawer.free_gift' | t | escape_once }}"
	data-i18n-you-save="{{ 'snippets.cart_drawer.you_save' | t: amount: '__AMOUNT__' | escape_once }}"
	data-i18n-code-percent="{{ 'snippets.cart_drawer.code_percent_off' | t: code: '__CODE__', percent: '__PERCENT__' | escape_once }}"
	data-i18n-remove-code="{{ 'snippets.cart_drawer.remove_code' | t: code: '__CODE__' | escape_once }}"
	data-i18n-code-invalid="{{ 'snippets.cart_drawer.code_invalid' | t | escape_once }}"
	data-i18n-code-refused="{{ 'snippets.cart_drawer.code_refused' | t | escape_once }}"
	data-i18n-code-two-kits="{{ 'snippets.cart_drawer.code_two_kits' | t | escape_once }}"
>
	{%- comment -%} Header {%- endcomment -%}
	<div class="flex items-center justify-between px-6 py-5 border-b border-bg-muted">
		<h2 class="font-heading font-semibold text-title text-xl">{{ 'snippets.cart_drawer.your_cart' | t }}</h2>
		<button type="button" data-cart-close class="relative rounded-md text-copy hover:text-title transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-main pointer-coarse:before:absolute pointer-coarse:before:-inset-2.5" aria-label="{{ 'snippets.cart_drawer.close_cart' | t }}">
			<svg class="block" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true" focusable="false">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
			</svg>
		</button>
	</div>

	{%- comment -%} Scrollable body — data-lenis-prevent keeps native scroll here (Lenis ignores it) {%- endcomment -%}
	<div class="flex-1 overflow-y-auto px-6 py-4" data-cart-body data-lenis-prevent>

		{%- comment -%}
			Review strip: the rating the kit page states (Theme settings > Reviews)
			beside up to three reviewer photos. The script shows it only while the
			cart has items; with no rating set it is left out.
		{%- endcomment -%}
		{%- if settings.reviews_rating_value != blank and settings.reviews_rating_count != blank -%}
			{%- capture reviewer_photos -%}
				{%- for i in (1..3) -%}
					{%- assign photo_key = 'reviews_photo_' | append: i -%}
					{%- assign photo = settings[photo_key] -%}
					{%- if photo != blank -%}
						{{ photo | image_url: width: 84, height: 84, crop: 'center' | image_tag:
							width: 28,
							height: 28,
							widths: '56, 84',
							sizes: '28px',
							alt: '',
							loading: 'lazy',
							class: 'size-7 rounded-full object-cover ring-2 ring-bg -ms-2 first:ms-0'
						}}
					{%- endif -%}
				{%- endfor -%}
			{%- endcapture -%}
			<div data-cart-reviews class="hidden items-center gap-2.5 px-3 py-2.5 rounded-xl bg-cream-light">
				{%- if reviewer_photos != blank -%}
					<div class="flex shrink-0">{{ reviewer_photos }}</div>
				{%- endif -%}
				{%- render 'rating-summary', rating: settings.reviews_rating_value, count: settings.reviews_rating_count, star_size: 12 -%}
			</div>
		{%- endif -%}

		{%- comment -%}
			Empty state. "Get my kit" adds the kit (and, under the launch offer,
			its free pouch) through the drawer's own add path, so the drawer
			fills without closing; it stays a link to the kit page, which is
			where the script sends the visitor if the add is refused. The pouch
			variant mirrors the buy box's "Launch offer" defaults, which this
			snippet cannot read (sections/product.liquid, as the offer popup's
			hidden form does): when the launch offer ends, untick it there and
			take data-gift-variant-id off here.
		{%- endcomment -%}
		<div data-cart-empty class="hidden flex-col items-center justify-center text-center py-16 gap-4">
			<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" class="text-copy opacity-25">
				<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
			</svg>
			<p class="text-copy text-base">{{ 'snippets.cart_drawer.empty' | t }}</p>
			{%- assign empty_cta_label = 'snippets.cart_drawer.empty_cta' | t -%}
			{%- capture empty_cta_attrs -%}data-cart-empty-add data-variant-id="{{ kit_variant.id }}"{% if refill_variant %} data-gift-variant-id="{{ refill_variant.id }}"{% endif %}{%- endcapture -%}
			{%- render 'cta-button',
				label: empty_cta_label,
				url: kit_product.url,
				variant: 'solid',
				attributes: empty_cta_attrs,
				extra_classes: 'aria-busy:opacity-60 aria-busy:pointer-events-none'
			-%}
		</div>

		{%- comment -%}
			Line items, one row per variant (rendered by JS). The list runs edge
			to edge so the hairlines between rows span the drawer.
		{%- endcomment -%}
		<div data-cart-items class="-mx-6 flex flex-col divide-y divide-bg-muted"></div>

		{%- comment -%}
			Status line: "Updating your cart" while a call is in flight, or the
			reason Shopify refused one. Filled by JS, read out by screen readers.
		{%- endcomment -%}
		<p data-cart-status role="status" aria-live="polite" class="hidden text-copy text-sm text-center mt-4"></p>

		{%- comment -%}
			Second kit offer (Theme settings > Offers). The script shows it
			while the cart holds exactly one kit, in place of the refill upsell.
			The price is the kit's price less the saving setting, the one sum
			the kit page's picker shows too, never typed; under it only the
			pouch sentence, and no thumbnail (Tom, 21 Oct 2026). Add is the kit
			row's + in another place: one more kit, and the free pouch that
			comes with it. The amount sits in <bdi> for Arabic.
		{%- endcomment -%}
		{%- if settings.second_kit_row_enabled and kit_product != blank -%}
			{%- liquid
				assign second_saving = settings.bundle_saving | times: 100 | round
				assign second_price = kit_variant.price | minus: second_saving
			-%}
			{%- if second_saving > 0 -%}
				{%- capture second_price_html -%}<bdi>{{ second_price | money }}</bdi>{%- endcapture -%}
				{%- comment -%} `t` escapes what it interpolates, so the <bdi> amount goes in after it. {%- endcomment -%}
				{%- capture second_kit_body -%}
					<div class="flex-1 min-w-0">
						<p class="font-heading font-semibold text-title text-base leading-snug">{{ 'snippets.cart_drawer.second_kit_title' | t: price: '__PRICE__' | replace: '__PRICE__', second_price_html }}</p>
						<p class="text-copy text-sm mt-0.5">{{ 'snippets.cart_drawer.second_kit_line' | t }}</p>
					</div>
				{%- endcapture -%}
				{%- assign second_kit_label = 'snippets.cart_drawer.second_kit_add' | t -%}
				{%- render 'cart-upsell-box',
					attrs: 'data-cart-second-kit',
					body: second_kit_body,
					button_label: second_kit_label,
					button_attrs: 'data-second-kit-add'
				-%}
			{%- endif -%}
		{%- endif -%}

		{%- comment -%} Upsell — refill tabs {%- endcomment -%}
		{%- if refill_product != blank and refill_variant != blank -%}
			{%- capture upsell_body -%}
				{%- if refill_product.featured_image -%}
					<a href="{{ refill_product.url }}" class="shrink-0 w-16 h-16 rounded-xl overflow-hidden bg-bg-muted">
						{{ refill_product.featured_image | image_url: width: 128 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover' }}
					</a>
				{%- endif -%}
				<div class="flex-1 min-w-0">
					<p class="font-heading font-semibold text-title text-base leading-snug truncate">{%- render 'product-title', title: refill_product.title -%}</p>
					<p class="text-copy text-base mt-0.5">{{ refill_variant.price | money }}</p>
				</div>
			{%- endcapture -%}
			{%- capture upsell_attrs -%}data-upsell-add data-upsell-variant-id="{{ refill_variant.id }}"{%- endcapture -%}
			{%- assign upsell_label = 'general.add' | t -%}
			{%- assign upsell_eyebrow = 'snippets.cart_drawer.complete_your_kit' | t -%}
			{%- render 'cart-upsell-box',
				attrs: 'data-cart-upsell',
				eyebrow: upsell_eyebrow,
				body: upsell_body,
				button_label: upsell_label,
				button_attrs: upsell_attrs
			-%}
		{%- endif -%}

	</div>

	{%- comment -%} Footer, pinned under the scrolling body: codes, subtotal and saving, checkout, trust row {%- endcomment -%}
	{%- comment -%}
		The footer starts in the state Liquid knows (shown with items, hidden
		without), so a drawer that loads with a filled cart has its express
		buttons laid out before it ever opens; the script keeps it right.
	{%- endcomment -%}
	<div data-cart-footer class="{% if cart.item_count > 0 %}flex{% else %}hidden{% endif %} border-t border-bg-muted px-6 pt-4 pb-5 flex-col gap-3">
		{%- comment -%}
			One row per code on the cart, filled by JS from the cart's order-level
			discount applications. Line discounts (the free pouch, pack prices)
			show on their rows and in "You save", never here.
		{%- endcomment -%}
		<div data-cart-codes class="hidden flex-col gap-2"></div>
		<div class="flex items-center justify-between gap-3">
			<div class="flex flex-wrap items-center gap-x-2 gap-y-1 min-w-0">
				<span class="font-heading font-semibold text-title text-base">{{ 'snippets.cart_drawer.subtotal' | t }}</span>
				<span data-cart-savings class="hidden rounded-md bg-highlight px-2 py-0.5 text-xs font-bold text-white transition-opacity group-aria-busy:opacity-40"></span>
			</div>
			<span class="shrink-0 font-heading font-bold text-title text-2xl transition-opacity group-aria-busy:opacity-40" data-cart-subtotal></span>
		</div>
		{%- comment -%}
			Shown by the script only while the signup code is remembered
			(localStorage aira_popup_code) and no code row is on screen: the
			fallback for a code that did not reach the cart.
		{%- endcomment -%}
		<p class="text-center text-highlight-green text-sm font-semibold" data-cart-offer-note hidden>{{ 'snippets.cart_drawer.discount_applied' | t }}</p>
		{%- comment -%}
			"Got a code?" (brief of 21 Oct, part B): a muted link that opens a
			code input with Apply, above the Checkout button, because the wallet
			sheets have no code box of their own. The script hides the whole field
			while a code row is on screen (an automatic discount's row leaves it)
			and writes the typed code onto the cart as _aira_code_entered whether
			or not Shopify applies it, so an affiliate's code that does not
			combine with the 2-kit offer still reaches the order. The × on a code
			row clears that note again. A refused code gets "isn't valid" when
			the store does not have it (checked through the Storefront API),
			"can't be used" otherwise. Codes are Latin: the input uppercases
			only a to z, so an Arabic keyboard is left alone.
		{%- endcomment -%}
		<div data-cart-code-field class="flex flex-col items-start gap-2" hidden>
			<button type="button" data-code-toggle class="inline-flex min-h-11 items-center text-sm text-copy underline underline-offset-2 cursor-pointer transition-colors hover:text-main focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-main">{{ 'snippets.cart_drawer.code_link' | t }}</button>
			<form data-code-form class="flex w-full items-center gap-2" novalidate hidden>
				<label for="cart-code-input" class="sr-only">{{ 'snippets.cart_drawer.code_placeholder' | t }}</label>
				<input id="cart-code-input" type="text" name="discount" data-code-input dir="auto" placeholder="{{ 'snippets.cart_drawer.code_placeholder' | t | escape }}" autocapitalize="characters" autocomplete="off" autocorrect="off" spellcheck="false" enterkeyhint="done" class="min-w-0 flex-1 h-11 rounded-xl border border-main/20 bg-bg px-4 text-sm text-main uppercase placeholder:normal-case focus:outline-none focus:border-main">
				{%- assign code_apply_label = 'snippets.cart_drawer.code_apply' | t -%}
				{%- render 'cta-button', label: code_apply_label, variant: 'outline', size: 'sm', element: 'button', button_type: 'submit', attributes: 'data-code-apply', extra_classes: 'shrink-0' -%}
			</form>
			<p data-code-error class="text-sm text-highlight" role="alert" hidden></p>
		</div>
		{%- capture checkout_label -%}
			<svg class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path></svg>
			{{- 'cart.checkout' | t -}}
		{%- endcapture -%}
		{%- comment -%} Built from the locale root, so Arabic visitors reach /ar/checkout and an Arabic checkout. {%- endcomment -%}
		{%- assign checkout_url = routes.root_url | append: '/checkout' | replace: '//', '/' -%}
		{%- render 'cta-button',
			label: checkout_label,
			url: checkout_url,
			variant: 'solid',
			size: 'lg',
			full_width: true,
			attributes: 'data-cart-checkout',
			extra_classes: '!px-6 !text-base !font-bold aria-busy:opacity-60 aria-busy:pointer-events-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-main'
		-%}
		{%- comment -%}
			Express pay (Theme settings > Cart drawer): Shopify's own Apple Pay
			and Google Pay buttons for the whole cart, so the free pouch rides
			along (snippets/express-buttons.liquid). Shopify fills their wallet
			configuration only when it renders for a cart with items, so with
			items at page load they render here, laid out before the drawer
			opens; with an empty cart a placeholder of the row's height waits
			instead, and the script fetches sections/cart-express.liquid the
			moment the first add has landed and mounts the buttons into that
			space. From then on the markup stays and the script only toggles
			classes, so Shopify's component keeps its state and always reads
			the current cart. The footer hides with the empty state and takes
			the buttons with it.
		{%- endcomment -%}
		{%- if settings.drawer_express_enabled and additional_checkout_buttons -%}
			{%- if cart.item_count > 0 -%}
				{%- render 'express-buttons' -%}
			{%- else -%}
				<div class="min-h-12 rounded-xl bg-cream-light" data-drawer-express-slot></div>
			{%- endif -%}
		{%- endif -%}
		{%- comment -%}
			Accepted payment marks and their line (brief of 22 Oct): customers
			learn Apple Pay and Google Pay are taken, then meet them at checkout,
			where the delivery country shows. Under the express block, so with
			express pay off they sit straight under Checkout; never a link.
		{%- endcomment -%}
		{%- render 'payment-marks', show_line: true, id_scope: 'drawer' -%}
		<ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-copy" role="list">
			<li class="flex items-center gap-1.5">
				<svg class="shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
				{{- 'snippets.cart_drawer.guarantee' | t -}}
			</li>
			<li class="flex items-center gap-1.5">
				<svg class="shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
				{{- 'general.free_shipping_short' | t -}}
			</li>
		</ul>
	</div>
</aside>

{%- comment -%}
	What a form can add, keyed by variant id (the id the form sends), so the
	drawer can draw a row the moment a form is submitted instead of after
	Shopify answers. The rows also read here a product's short name and cart
	thumbnail (product fields custom.short_name and custom.cart_thumbnail;
	blank falls back to the title and the cart's own image) and whether it
	has more than one variant worth naming under the title. Images are sized
	to match the rows drawn from the cart JSON. A variant missing here still
	adds; its row waits for the reply.
{%- endcomment -%}
{%- liquid
	assign catalogue_variants = '' | split: ','
	if kit_product != blank
		assign catalogue_variants = catalogue_variants | concat: kit_product.variants
	endif
	if refill_product != blank
		assign catalogue_variants = catalogue_variants | concat: refill_product.variants
	endif
-%}
<script type="application/json" data-cart-catalogue>
{
	{%- for v in catalogue_variants -%}
		{%- liquid
			assign v_image = v.featured_image | default: v.product.featured_image
			assign v_thumb = v.product.metafields.custom.cart_thumbnail.value
		-%}
		"{{ v.id }}": {"title": {{ v.product.title | json }}, "name": {{ v.product.metafields.custom.short_name.value | default: '' | json }}, "handle": {{ v.product.handle | json }}, "single": {% if v.product.variants.size == 1 %}true{% else %}false{% endif %}, "url": {{ v.product.url | json }}, "image": {% if v_image %}{{ v_image | image_url: width: 240 | json }}{% else %}""{% endif %}, "alt": {{ v_image.alt | default: '' | json }}, "thumb": {% if v_thumb %}{{ v_thumb | image_url: width: 240 | json }}{% else %}""{% endif %}, "thumbAlt": {{ v_thumb.alt | default: '' | json }}}{% unless forloop.last %},{% endunless %}
	{%- endfor -%}
}
</script>

{%- comment -%}
	The gift chip's "1 free gift", "2 free gifts"… worked out here, where `t`
	knows the page language's plural forms (Arabic has five), for 1 to 11.
	Above 11 the script reuses the 11 entry with the number swapped: in Arabic
	that is the form for 11 to 99.
{%- endcomment -%}
<script type="application/json" data-cart-free-gifts>
{
	{%- for n in (1..11) -%}
		"{{ n }}": {{ 'snippets.cart_drawer.free_gifts' | t: count: n | json }}{% unless forloop.last %},{% endunless %}
	{%- endfor -%}
}
</script>

<script>
(function () {
	/* Locale-aware root ("/" in English, "/ar/" under /ar): every cart call carries it */
	var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

	/* ── Refs ── */
	var backdrop = document.querySelector('[data-cart-backdrop]');
	var drawer   = document.querySelector('[data-cart-drawer]');
	var currency = drawer.getAttribute('data-currency');
	/* UI strings from the locale files, so the drawer speaks the page's language */
	var i18n     = drawer.dataset;
	var closeBtn = drawer.querySelector('[data-cart-close]');
	var reviewsEl = document.querySelector('[data-cart-reviews]');
	var itemsEl  = document.querySelector('[data-cart-items]');
	var emptyEl  = document.querySelector('[data-cart-empty]');
	var upsellEl = document.querySelector('[data-cart-upsell]');
	var footerEl = document.querySelector('[data-cart-footer]');
	var codesEl = document.querySelector('[data-cart-codes]');
	var savingsEl = document.querySelector('[data-cart-savings]');
	var subtotalEl = document.querySelector('[data-cart-subtotal]');
	var statusEl = document.querySelector('[data-cart-status]');
	var checkoutEl = document.querySelector('[data-cart-checkout]');
	var upsellBtn  = document.querySelector('[data-upsell-add]');
	var secondKitEl = document.querySelector('[data-cart-second-kit]');
	var secondKitBtn = document.querySelector('[data-second-kit-add]');
	/* The express pay buttons: the placeholder they mount into when the cart
	   was empty at page load, and whether the feature is on at all. */
	var expressSlot = document.querySelector('[data-drawer-express-slot]');
	var expressOn = !!(expressSlot || document.querySelector('[data-drawer-express]'));
	var expressFetched = false;
	var catalogue = readJson('[data-cart-catalogue]');
	var freeGifts = readJson('[data-cart-free-gifts]');

	var REFILL_HANDLE = 'aira-refill-tabs';
	var KIT_HANDLE = drawer.getAttribute('data-kit-handle');

	/* ── Checkout carries the signup code ──
	   Belt and braces for the /discount/<code> call snippets/signup-offer.liquid
	   makes on signup: while localStorage holds aira_popup_code, the Checkout
	   link appends ?discount=<code> so the 10% reaches the order even if that
	   cookie did not take. Re-read on every open: the popup can set it
	   mid-session. The href is read at click time (see the busy path), so a
	   rewritten attribute is enough for both paths. */
	var CHECKOUT_BASE = checkoutEl ? checkoutEl.getAttribute('href') : '';
	var offerNoteEl = document.querySelector('[data-cart-offer-note]');
	var offerCode = '';
	/* A code typed into the drawer that Shopify applied: the Checkout link
	   carries it in place of the signup code. */
	var appliedCode = '';
	var codeRowsShown = false;
	function tagCheckout() {
		var code = '';
		try { code = localStorage.getItem('aira_popup_code') || ''; } catch (e) {}
		offerCode = code;
		var link = appliedCode || code;
		if (checkoutEl) {
			checkoutEl.setAttribute('href', link
				? CHECKOUT_BASE + (CHECKOUT_BASE.indexOf('?') > -1 ? '&' : '?') + 'discount=' + encodeURIComponent(link)
				: CHECKOUT_BASE);
		}
		refreshOfferNote();
	}

	/* The "10% off applied at checkout." line above the button: only while
	   the code is held and the cart shows no code row of its own, so it is
	   the fallback for a code that did not reach the cart. */
	function refreshOfferNote() {
		if (offerNoteEl) { offerNoteEl.hidden = !offerCode || codeRowsShown; }
	}
	tagCheckout();

	/* A code the visitor took off is forgotten: the Checkout link and the
	   express pay step would otherwise put it straight back. */
	function forgetOfferCode() {
		try { localStorage.removeItem('aira_popup_code'); } catch (e) {}
		tagCheckout();
	}

	/* ── Removing a code ──
	   The × on a code row takes that code off the cart. Shopify replaces the
	   cart's whole code list on each update, so the other codes are sent
	   again, and the cookie its /discount/ links leave for the checkout is
	   brought into line too (dropped, or re-set to the codes that stay), or
	   the checkout would put the code straight back. The reply is rendered
	   like any other cart answer. */
	codesEl.addEventListener('click', function (e) {
		var btn = e.target.closest('[data-code-remove]');
		if (!btn || !currentCart) return;
		var code = btn.getAttribute('data-code-remove') || '';
		var keep = (currentCart.discount_codes || []).map(function (c) { return c.code; }).filter(function (c) {
			return String(c).toUpperCase() !== code.toUpperCase();
		});
		errorMsg = '';
		if (offerCode && offerCode.toUpperCase() === code.toUpperCase()) forgetOfferCode();
		codeTried = code;
		pendingDiscount = '';
		if (appliedCode.toUpperCase() === code.toUpperCase()) { appliedCode = ''; tagCheckout(); }
		enqueue(function () {
			return postJson(ROOT + 'cart/update.js', { discount: keep.join(','), attributes: { _aira_code_entered: '' } })
				.then(function (res) {
					if (keep.length) {
						fetch(ROOT + 'discount/' + encodeURIComponent(keep.join(',')), { redirect: 'manual' }).catch(function () {});
					} else {
						document.cookie = 'discount_code=; Max-Age=0; path=/';
					}
					return res.ok && res.body && res.body.items ? res.body : fetchCart();
				})
				.then(render);
		});
	});
	/* ── "Got a code?" ──
	   The link opens the input; Apply (or Enter) sends the code and the
	   note _aira_code_entered in one update call, so the note lands on the
	   cart whether Shopify applies the code or not (an affiliate's code that
	   does not combine with the 2-kit offer still earns its credit from the
	   order). Applied: the code row takes over and the field goes with it.
	   Refused (no applicable entry): the field stays open with the typed
	   value and one line explains: "isn't valid" for a code the store does
	   not have, otherwise "can't be used", plus the 2-kit line when the cart
	   holds two or more kits (the offer already gives more). The queue keeps
	   Checkout and the wallet buttons waiting for Shopify's answer, as for
	   every write; the validity check after a refusal is not a cart write
	   and runs outside it. */
	var codeFieldEl = document.querySelector('[data-cart-code-field]');
	var codeToggle = codeFieldEl ? codeFieldEl.querySelector('[data-code-toggle]') : null;
	var codeForm = codeFieldEl ? codeFieldEl.querySelector('[data-code-form]') : null;
	var codeInput = codeFieldEl ? codeFieldEl.querySelector('[data-code-input]') : null;
	var codeErrorEl = codeFieldEl ? codeFieldEl.querySelector('[data-code-error]') : null;

	/* Shown whenever no code row is on screen; collapsed back to the link
	   each time a code row appears. */
	function refreshCodeField() {
		if (!codeFieldEl) return;
		codeFieldEl.hidden = codeRowsShown;
		if (codeRowsShown) {
			codeForm.hidden = true;
			codeToggle.hidden = false;
			codeErrorEl.hidden = true;
			codeInput.value = '';
		}
	}

	/* /cart.js answers applicable: false alike for a code the store does not
	   have and for a real one this cart refuses (one that does not combine
	   with the 2-kit offer). A throwaway Storefront API cart with no lines
	   tells them apart: an unknown code comes back with the warning
	   DISCOUNT_NOT_FOUND, a real one without it. Cart calls need no token
	   there, and the visitor's own cart and cookie are left alone. Resolves
	   true only for an unknown code; any failure resolves false, so the
	   "can't be used" message stands. */
	var CODE_CHECK_QUERY = 'mutation ($input: CartInput!) { cartCreate(input: $input) { warnings { code } } }';
	function codeUnknown(code) {
		var input = { discountCodes: [code] };
		if (window.Shopify && window.Shopify.country) input.buyerIdentity = { countryCode: window.Shopify.country };
		return postJson(ROOT + 'api/2026-07/graphql.json', { query: CODE_CHECK_QUERY, variables: { input: input } })
			.then(function (res) {
				var payload = res.ok && res.body && res.body.data && res.body.data.cartCreate;
				return !!payload && (payload.warnings || []).some(function (w) { return w.code === 'DISCOUNT_NOT_FOUND'; });
			})
			.catch(function () { return false; });
	}

	function showCodeError(cart, unknown) {
		var lines = [unknown ? i18n.i18nCodeInvalid : i18n.i18nCodeRefused];
		if (!unknown && cart && kitQty(cart) >= 2) lines.push(i18n.i18nCodeTwoKits);
		codeErrorEl.innerHTML = lines.map(function (line) { return '<span class="block">' + escHtml(line) + '</span>'; }).join('');
		codeErrorEl.hidden = false;
	}

	if (codeFieldEl) {
		codeToggle.addEventListener('click', function () {
			codeToggle.hidden = true;
			codeForm.hidden = false;
			codeInput.focus();
		});
		/* Latin letters to upper case as they are typed, the caret kept;
		   anything else (an Arabic keyboard) passes untouched. */
		codeInput.addEventListener('input', function () {
			var v = codeInput.value;
			var up = v.replace(/[a-z]+/g, function (m) { return m.toUpperCase(); });
			if (up !== v) {
				var pos = codeInput.selectionStart;
				codeInput.value = up;
				try { codeInput.setSelectionRange(pos, pos); } catch (e) {}
			}
			codeErrorEl.hidden = true;
		});
		codeForm.addEventListener('submit', function (e) {
			e.preventDefault();
			var code = (codeInput.value || '').trim().toUpperCase();
			if (!code || !currentCart) return;
			errorMsg = '';
			codeTried = code;
			pendingDiscount = '';
			codeErrorEl.hidden = true;
			enqueue(function () {
				return postJson(ROOT + 'cart/update.js', { attributes: { _aira_code_entered: code }, discount: code })
					.then(function (res) { return res.ok && res.body && res.body.items ? res.body : fetchCart(); })
					.then(function (cart) {
						var applied = (cart.discount_codes || []).some(function (c) {
							return String(c.code).toUpperCase() === code && c.applicable;
						});
						if (applied) {
							appliedCode = code;
							tagCheckout();
						} else {
							/* Shown once the check answers, and only while the
							   field still holds this code. */
							codeUnknown(code).then(function (unknown) {
								if (codeForm.hidden || (codeInput.value || '').trim().toUpperCase() !== code) return;
								showCodeError(currentCart || cart, unknown);
							});
						}
						clarity('drawer_code', applied ? 'applied' : 'refused');
						render(cart);
					});
			});
		});
	}
	/* Taps within this many ms of each other travel in one update call. */
	var FLUSH_DELAY = 200;
	var isOpen = false;

	/* ── State ──
	   currentCart is the last cart Shopify sent, and the only thing taps are
	   resolved against; the markup is never read back. Every cart call runs
	   through `queue`, one at a time, so a tap can never race an add and the
	   Checkout link can wait for the lot. Taps park in `pending` until the
	   flush timer sends them; `inflight` holds the batch on its way to Shopify
	   so the numbers on screen keep showing where the cart is heading. Each
	   op is { variantId, delta, remove }: a row stands for a variant, which
	   can sit on several lines, and the op is spread over that variant's
	   lines when the call is planned. `pendingAdds` holds the { id, quantity }
	   lines of adds on their way, drawn as rows until the reply has been read. */
	var currentCart = null;
	var queue = Promise.resolve();
	var pending = [];
	var inflight = [];
	var pendingAdds = [];
	var flushTimer = null;
	var queued = 0;
	var errorMsg = '';
	/* The signup code already sent to the cart for the express buttons (see render). */
	var codeTried = '';
	/* Whether the second-kit offer has been noted as shown during this open. */
	var secondKitNoted = false;
	/* The signup code booked onto the next write (express pay, see planCodeApply). */
	var pendingDiscount = '';
	/* The express pay wrapper, once mounted. */
	var expressEl = null;
	/* render()'s verdict on the refill upsell, from the cart Shopify sent. */
	var upsellWanted = false;

	/* ── Cart attributes ──
	   Notes the drawer leaves on the cart: `_aira_bundle` when the kit
	   page's 2-kit option was added, `_aira_second_kit_offer` when the
	   drawer's second-kit row was used. They travel with a call the drawer
	   makes anyway: the update that moves the quantities, or, after an add,
	   the read that follows it, which becomes an update carrying only the
	   notes and answers with the same cart JSON. `_aira_bundle` is cleared
	   again (an empty value removes it) once the cart is planned to hold
	   fewer than two kits. */
	var pendingAttrs = {};

	function hasAttrs(attrs) {
		for (var key in attrs) { if (Object.prototype.hasOwnProperty.call(attrs, key)) return true; }
		return false;
	}

	/* Reads a form's data-cart-attributes (a JSON object) into the notes. */
	function noteAttrs(json) {
		if (!json) return;
		try {
			var attrs = JSON.parse(json);
			for (var key in attrs) { if (Object.prototype.hasOwnProperty.call(attrs, key)) pendingAttrs[key] = String(attrs[key]); }
		} catch (e) {}
	}

	/* The notes to send with an update that leaves the cart's lines at `qty`
	   (quantities in cart order), or null when there is nothing to say. */
	function attrsFor(cart, qty) {
		var attrs = {};
		for (var key in pendingAttrs) { if (Object.prototype.hasOwnProperty.call(pendingAttrs, key)) attrs[key] = pendingAttrs[key]; }
		if (cart && cart.attributes && cart.attributes._aira_bundle && plannedKits(cart, qty) < 2) attrs._aira_bundle = '';
		return hasAttrs(attrs) ? attrs : null;
	}

	function clearSentAttrs(attrs) {
		for (var key in attrs) { if (pendingAttrs[key] === attrs[key]) delete pendingAttrs[key]; }
	}

	function plannedKits(cart, qty) {
		if (!KIT_HANDLE) return 0;
		return cart.items.reduce(function (total, item, i) {
			return item.handle === KIT_HANDLE ? total + (qty ? qty[i] : item.quantity) : total;
		}, 0);
	}

	/* Microsoft Clarity tags, when its script is on the page. */
	function clarity(key, value) {
		if (typeof window.clarity === 'function') window.clarity('set', key, value);
	}

	/* ── Gift opt-out ──
	   A visitor who removes the free pouch has said no to it, so it stays out
	   for the rest of this tab's session rather than returning on the next
	   add-to-cart. sessionStorage, not localStorage: a new tab or a new visit
	   is a fresh start, and the flag also clears once the cart renders empty. */
	var GIFT_REMOVED_KEY = 'aira.cart.giftRemoved';

	function giftRemoved() {
		try { return sessionStorage.getItem(GIFT_REMOVED_KEY) === '1'; } catch (e) { return false; }
	}

	function markGiftRemoved() {
		try { sessionStorage.setItem(GIFT_REMOVED_KEY, '1'); } catch (e) {}
	}

	function clearGiftRemoved() {
		try { sessionStorage.removeItem(GIFT_REMOVED_KEY); } catch (e) {}
	}

	/* ── Open / close ── */
	/* Off-canvas is not out of reach: the closed drawer is inert, so its
	   Checkout link and wallet buttons are neither tabbable nor exposed to
	   assistive tech until it opens. */
	drawer.inert = true;

	function open() {
		if (isOpen) return;
		isOpen = true;
		drawer.inert = false;
		backdrop.classList.remove('opacity-0', 'pointer-events-none');
		backdrop.classList.add('opacity-100', 'pointer-events-auto');
		drawer.classList.remove('cart-drawer-closed');
		drawer.classList.add('cart-drawer-open');
		document.body.style.overflow = 'hidden';
		secondKitNoted = false;
		tagCheckout();
	}

	function close() {
		if (!isOpen) return;
		isOpen = false;
		drawer.inert = true;
		backdrop.classList.add('opacity-0', 'pointer-events-none');
		backdrop.classList.remove('opacity-100', 'pointer-events-auto');
		drawer.classList.remove('cart-drawer-open');
		drawer.classList.add('cart-drawer-closed');
		document.body.style.overflow = '';
		/* Nothing tapped should outlive the drawer being dismissed. */
		flushNow();
	}

	document.querySelectorAll('[data-cart-close]').forEach(function (b) { b.addEventListener('click', close); });
	backdrop.addEventListener('click', close);
	document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });

	/* ── Cart icon clicks → open drawer ── */
	document.querySelectorAll('[data-cart-toggle]').forEach(function (el) {
		el.addEventListener('click', function (e) {
			e.preventDefault();
			open();
			/* Re-read in case another tab changed the cart; queued so it
			   cannot overtake a tap that is on its way. */
			enqueue(function () { return fetchCart().then(settle); });
		});
	});

	/* ── Busy state ──
	   The drawer is busy from the moment a tap is parked until Shopify's
	   answer is on screen. aria-busy dims the prices (group-aria-busy: in the
	   markup) and the status line says so; a refused call leaves its reason
	   there until the next tap or add. */
	function isBusy() {
		return queued > 0 || flushTimer !== null || pending.length > 0 || inflight.length > 0;
	}

	function refreshStatus() {
		var busy = isBusy();
		drawer.setAttribute('aria-busy', busy ? 'true' : 'false');
		if (checkoutEl && !busy) checkoutEl.removeAttribute('aria-busy');
		/* The wallet buttons wait for the cart as the Checkout link does:
		   inert for the keyboard here, dimmed and untappable through the
		   group-aria-busy utilities on the wrapper. */
		if (expressEl) expressEl.inert = busy;
		statusEl.textContent = errorMsg || (busy ? i18n.i18nUpdating : '');
		statusEl.classList.toggle('hidden', statusEl.textContent === '');
	}

	/* Runs `work` after everything already queued. A failure inside falls
	   back to re-reading the cart so the drawer never shows a stale guess. */
	function enqueue(work) {
		queued += 1;
		refreshStatus();
		queue = queue
			.then(work)
			.catch(function () { return fetchCart().then(render).catch(function () {}); })
			.then(function () { queued -= 1; refreshStatus(); });
		return queue;
	}

	/* ── Cart requests ── */
	function request(url, options) {
		return fetch(url, options).then(function (r) {
			return r.json().then(function (body) { return { ok: r.ok, body: body }; });
		});
	}

	function postJson(url, body, keepalive) {
		return request(url, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(body),
			keepalive: !!keepalive
		});
	}

	function fetchCart() {
		return request(ROOT + 'cart.js').then(function (res) { return res.body; });
	}

	/* The read after an add: cart.js, or, with notes or a code waiting to go
	   on the cart, an update carrying only those, which answers with the
	   same cart JSON in place of the read it replaces. */
	function readCart() {
		if (!hasAttrs(pendingAttrs) && !pendingDiscount) return fetchCart();
		var attrs = attrsFor(null, null);
		var code = pendingDiscount;
		var body = {};
		if (attrs) body.attributes = attrs;
		if (code) body.discount = code;
		return postJson(ROOT + 'cart/update.js', body).then(function (res) {
			if (res.ok && res.body && res.body.items) { clearSentAttrs(attrs); noteCodeSent(code); return res.body; }
			return fetchCart();
		});
	}

	/* One update call for the whole cart. `quantities` is the full list in
	   cart order, so lines are addressed by position, never by line key
	   (keys change as the discount moves between lines). Shopify answers
	   422 "Cart changed" when the line count moved under us, and the caller
	   re-reads and plans again. `attrs`, when given, and a booked code ride
	   along. */
	function updateLines(quantities, keepalive, attrs) {
		var body = { updates: quantities };
		var code = pendingDiscount;
		if (attrs) body.attributes = attrs;
		if (code) body.discount = code;
		return postJson(ROOT + 'cart/update.js', body, keepalive).then(function (res) {
			if (res.ok && res.body && res.body.items) { clearSentAttrs(attrs); noteCodeSent(code); }
			return res;
		});
	}

	/* ── Express pay and the signup code ──
	   The wallet buttons read the cart as it stands, not the Checkout link's
	   ?discount= tag, so a remembered signup code goes on the cart before a
	   wallet can be tapped: once per code per page view, only while express
	   pay is on and the cart carries no code of its own (applicable or not:
	   a code already there is never replaced). planCodeApply books it onto
	   the next write the drawer makes anyway (an add's follow-up, a tap's
	   update); render() sends a write of its own only when none is coming. */
	function planCodeApply(cart) {
		if (!expressOn || !offerCode || codeTried === offerCode || pendingDiscount) return;
		if (!cart || (cart.discount_codes || []).length) return;
		pendingDiscount = offerCode;
	}

	function noteCodeSent(code) {
		if (!code) return;
		codeTried = code;
		if (pendingDiscount === code) pendingDiscount = '';
	}

	/* ── Adds ──
	   One path for every add: the forms intercepted below and the empty
	   state's "Get my kit". `item` is the Ajax line, `giftId` the free pouch
	   to send along, `btn` the control that shows "Adding..." until the
	   drawer shows Shopify's answer, `attrsJson` notes the form wants on the
	   cart once the add has gone through (the kit page's 2-kit cards write
	   `_aira_bundle`), and `onRefused` runs when Shopify refused the add or
	   the request dropped. */
	function addToCart(item, giftId, btn, attrsJson, onRefused) {
		/* Keep the markup: the label can be two lines, so restore rather than retype */
		var btnMarkup = btn ? btn.innerHTML : '';
		function resetBtn() {
			if (!btn) return;
			btn.removeAttribute('aria-busy');
			if ('disabled' in btn) btn.disabled = false;
			btn.innerHTML = btnMarkup;
		}
		if (btn) {
			btn.setAttribute('aria-busy', 'true');
			if ('disabled' in btn) btn.disabled = true;
			btn.textContent = i18n.i18nAdding;
		}
		errorMsg = '';
		/* Open at once and draw the rows this add will make, worked out from
		   the cart the drawer holds; the same maths runs again in the queue
		   against whatever the cart is by the time the call goes. Anything
		   tapped goes first so the order holds. */
		open();
		flushNow();
		/* With express pay on, the remembered code rides this add's follow-up,
		   and Shopify's wallet script starts loading now, during the add,
		   rather than once the buttons mount (its bootstrap exposes init for
		   exactly this; it is a no-op after the first call). */
		planCodeApply(currentCart);
		warmExpress();
		var done = noteAdds(addItems(currentCart, item, giftId));
		var refused = false;
		enqueue(function () {
			var body = { items: addItems(currentCart, item, giftId) };
			/* The express buttons still to mount: Shopify renders their section
			   inside this very call, after the add, so they arrive with the
			   reply instead of after a second round trip. */
			if (expressSlot && !expressEl) body.sections = 'cart-express';
			/* Only the add call itself can refuse: a dropped follow-up read
			   falls back to a re-read, with the items already in the cart. */
			return postJson(ROOT + 'cart/add.js', body)
				.then(null, function (err) { refused = true; throw err; })
				.then(function (res) {
					if (!res.ok) {
						refused = true;
						errorMsg = (res.body && res.body.description) || i18n.i18nAddFailed;
					} else {
						noteAttrs(attrsJson);
						mountExpress(res.body && res.body.sections && res.body.sections['cart-express']);
					}
					return readCart();
				})
				.then(function (cart) { done(); return settle(cart); }, function (err) { done(); throw err; });
		}).then(function () {
			resetBtn();
			if (refused && onRefused) onRefused();
			/* The page's own scripts may want to re-sync a label they own
			   (the kit page's cards) now that the control is back. */
			if (btn) btn.dispatchEvent(new CustomEvent('aira:add-settled', { bubbles: true }));
		});
	}

	/* ── Intercept all add-to-cart forms ── */
	document.addEventListener('submit', function (e) {
		var form = e.target;
		if (!form.matches('form[action*="/cart/add"]')) return;
		e.preventDefault();
		var giftId = parseInt(form.getAttribute('data-gift-variant-id'), 10) || 0;
		addToCart(formItem(form), giftId, form.querySelector('[data-add-to-cart]'), form.getAttribute('data-cart-attributes'));
	});

	/* ── Empty state: "Get my kit" adds the kit ──
	   The same add as the kit page's form, so the free pouch comes along and
	   the drawer fills without closing. Without a variant to add, or when
	   Shopify refuses the add, the link does what it always did and goes to
	   the kit page. */
	var emptyAdd = document.querySelector('[data-cart-empty-add]');
	if (emptyAdd) {
		emptyAdd.addEventListener('click', function (e) {
			var id = parseInt(emptyAdd.getAttribute('data-variant-id'), 10);
			if (!id) return;
			e.preventDefault();
			if (emptyAdd.getAttribute('aria-busy') === 'true') return;
			clarity('drawer_empty_get_kit', 'add');
			var giftId = parseInt(emptyAdd.getAttribute('data-gift-variant-id'), 10) || 0;
			addToCart({ id: id, quantity: 1 }, giftId, emptyAdd, null, function () {
				window.location.href = emptyAdd.getAttribute('href');
			});
		});
	}

	/* The lines one add call carries: the form's item, then the free pouch
	   when the offer calls for it. */
	function addItems(cart, item, giftId) {
		var items = [item];
		var giftQty = giftToAdd(cart, giftId, item.quantity);
		if (giftQty > 0) items.push({ id: giftId, quantity: giftQty });
		return items;
	}

	/* The form's fields as one Ajax line: id, quantity, selling plan and any
	   properties[...] inputs. */
	function formItem(form) {
		var data = new FormData(form);
		var item = {
			id: parseInt(data.get('id'), 10),
			quantity: parseInt(data.get('quantity'), 10) || 1
		};
		var plan = data.get('selling_plan');
		if (plan) item.selling_plan = plan;
		var props = {};
		var hasProps = false;
		data.forEach(function (value, name) {
			var m = name.match(/^properties\[(.+)\]$/);
			if (m) { props[m[1]] = value; hasProps = true; }
		});
		if (hasProps) item.properties = props;
		return item;
	}

	/* ── Free gift ──
	   A Buy X Get Y automatic discount only zeroes the gift once the gift is
	   in the cart, so a form carrying data-gift-variant-id (the kit's forms)
	   gets the pouch sent along in the same add call, as many as it takes to
	   land the pouch count level with the kit count. The cart the drawer
	   already holds says how many that is, so nothing is read first. A
	   visitor who removed the gift this session is not handed it again. With
	   pouches already there, more only come while Shopify is zeroing one (the
	   offer is live), and only by the number the kits now outnumber them, so
	   paid pouches are left alone. */
	function giftToAdd(cart, giftId, qty) {
		if (!giftId || giftRemoved()) return 0;
		if (!cart) return qty;
		var kitsAfter = kitQty(cart) + qty;
		var pouches = variantQty(cart, giftId);
		if (pouches === 0) return Math.max(1, kitsAfter);
		return giftLine(cart) ? Math.max(0, kitsAfter - pouches) : 0;
	}

	/* ── Upsell add ── */
	if (upsellBtn) {
		upsellBtn.addEventListener('click', function () {
			var vid = parseInt(upsellBtn.getAttribute('data-upsell-variant-id'), 10);
			upsellBtn.disabled = true;
			upsellBtn.textContent = i18n.i18nAdding;
			errorMsg = '';
			function resetUpsell() {
				upsellBtn.disabled = false;
				upsellBtn.textContent = i18n.i18nAdd;
			}
			flushNow();
			var entry = { id: vid, quantity: 1 };
			var done = noteAdds([entry]);
			enqueue(function () {
				return postJson(ROOT + 'cart/add.js', { items: [entry] })
					.then(function (res) {
						if (!res.ok) errorMsg = (res.body && res.body.description) || i18n.i18nAddFailed;
						return readCart();
					})
					.then(function (cart) { done(); return settle(cart); }, function (err) { done(); throw err; });
			}).then(resetUpsell, resetUpsell);
		});
	}

	/* ── Second kit offer ──
	   The row's Add is the kit row's + in another place: a parked tap on the
	   kit's variant, so the free pouch follows through planQuantities (and
	   stays away for a visitor who binned it). The note goes with that
	   update. The row only shows while the kit is in the cart Shopify sent
	   (never for a kit still on its way), so the line is always there. */
	if (secondKitBtn) {
		secondKitBtn.addEventListener('click', function () {
			if (!currentCart || !KIT_HANDLE) return;
			var kit = currentCart.items.filter(function (item) { return item.handle === KIT_HANDLE; })[0];
			if (!kit) return;
			errorMsg = '';
			pendingAttrs._aira_second_kit_offer = 'added';
			addOp({ variantId: kit.variant_id, delta: 1, remove: false });
			clarity('second_kit_offer', 'added');
		});
	}

	/* ── Express pay ──
	   Mounted once, the first time the drawer shows a cart with items, from
	   a fetch of sections/cart-express.liquid (see the slot's comment in the
	   markup). Shopify's own bootstrap watches the page for the component
	   and loads its script when it appears, so nothing wallet-related loads
	   on a page whose drawer never shows items. Shopify draws the buttons
	   inside the component; a browser with no wallet to offer, or an empty
	   cart, draws nothing, and the wrapper's class then cancels the
	   footer's gap above it (the markup is never hidden, so the component
	   keeps its state). A tap on a wallet is a composed click, so it reaches
	   the wrapper. A failed fetch is tried again on the next render. */
	function wireExpress(block) {
		expressEl = block;
		refreshStatus();
		if (typeof ResizeObserver === 'function') {
			var watch = new ResizeObserver(function () {
				block.classList.toggle('drawer-express-empty', block.getBoundingClientRect().height === 0);
			});
			watch.observe(block);
			Array.prototype.forEach.call(block.children, function (child) { watch.observe(child); });
		}
		/* A tap on a wallet button, not on the row's empty space: the click
		   is composed, so its path crosses the component's shadow boundary. */
		block.addEventListener('click', function (e) {
			var path = typeof e.composedPath === 'function' ? e.composedPath() : [e.target];
			var onWallet = path.some(function (node) {
				return node && node.tagName && /(-pay-button|wallet-button)$/i.test(node.tagName);
			});
			if (onWallet) clarity('drawer_express', 'tap');
		});
	}

	/* Rendered by Liquid when the cart had items at page load; otherwise
	   fetched into the placeholder the first time the cart has items. */
	if (document.querySelector('[data-drawer-express]')) wireExpress(document.querySelector('[data-drawer-express]'));

	/* Loads Shopify's wallet script ahead of the buttons: the bootstrap in
	   content_for_header leaves Shopify.PaymentButton.init for the page to
	   call, and only the placeholder case needs it (with the buttons in the
	   markup at load the bootstrap has called it already). */
	function warmExpress() {
		if (!expressSlot || expressEl) return;
		var pb = window.Shopify && window.Shopify.PaymentButton;
		if (pb && typeof pb.init === 'function') { try { pb.init(); } catch (e) {} }
	}

	/* Mounts the buttons into the placeholder from `html` (the section as an
	   add call rendered it) or, without it, from a fetch of the section. */
	function mountExpress(html) {
		if (!expressSlot || expressEl || expressFetched) return;
		expressFetched = true;
		var source = html ? Promise.resolve(html) : fetch(ROOT + '?section_id=cart-express').then(function (r) { return r.ok ? r.text() : ''; });
		source
			.then(function (markup) {
				var block = new DOMParser().parseFromString(markup, 'text/html').querySelector('[data-drawer-express]');
				if (!expressSlot.parentNode) return;
				/* No block in the answer (an error page, a half-deployed theme):
				   try again on the next render, as after a failed fetch. */
				if (!block) { expressFetched = false; return; }
				expressSlot.parentNode.replaceChild(block, expressSlot);
				wireExpress(block);
			})
			.catch(function () { expressFetched = false; });
	}

	/* ── Free gift quantity ──
	   The offer gives a free pouch per kit, and Shopify only zeroes the pouches
	   it can already see in the cart. While the two counts disagree it splits the
	   kit across a discounted line and an undiscounted one, which is what showed
	   up as a duplicate kit row. Keeping the gift line level with the kit both
	   scales the offer and keeps the kit on one line. */
	function isFreeGift(item) {
		return item.final_line_price === 0 && item.line_level_total_discount > 0;
	}

	function giftLine(cart) {
		return cart.items.filter(isFreeGift)[0];
	}

	function kitQty(cart) {
		if (!KIT_HANDLE) return 0;
		return cart.items.reduce(function (total, item) {
			return item.handle === KIT_HANDLE ? total + item.quantity : total;
		}, 0);
	}

	function variantQty(cart, variantId) {
		return cart.items.reduce(function (total, item) {
			return item.variant_id === variantId ? total + item.quantity : total;
		}, 0);
	}

	/* Moves the lines of the anchor's variant in `qty` (quantities in cart
	   order) so they total `want`: raised on the anchor, lowered from the
	   other lines first so the anchor goes last. With the free pouch as the
	   anchor, paid pouches go before the free one. */
	function applyVariantWant(cart, qty, anchor, want) {
		var anchorIndex = cart.items.indexOf(anchor);
		var indexes = [];
		cart.items.forEach(function (item, i) {
			if (item.variant_id === anchor.variant_id) indexes.push(i);
		});
		var total = indexes.reduce(function (n, i) { return n + qty[i]; }, 0);
		if (want > total) {
			qty[anchorIndex] += want - total;
			return;
		}
		var surplus = total - want;
		indexes.filter(function (i) { return i !== anchorIndex; }).concat([anchorIndex]).forEach(function (i) {
			var take = Math.min(qty[i], surplus);
			qty[i] -= take;
			surplus -= take;
		});
	}

	/* The line a variant's taps land on: its free line when it has one, so
	   a minus takes a paid pouch first, otherwise its first line. */
	function anchorLine(cart, variantId) {
		var lines = cart.items.filter(function (item) { return item.variant_id === variantId; });
		return lines.filter(isFreeGift)[0] || lines[0];
	}

	function firstIndexOfVariant(cart, variantId) {
		for (var i = 0; i < cart.items.length; i++) {
			if (cart.items[i].variant_id === variantId) return i;
		}
		return -1;
	}

	/* ── Adds on their way ──
	   An add is drawn before it is sent: a variant already in the cart has
	   its row's quantity raised, any other gets a provisional row from the
	   catalogue. The entries leave `pendingAdds` once the reply has been
	   read, whichever way the call went, and the next render draws the truth. */
	function noteAdds(entries) {
		entries.forEach(function (entry) { pendingAdds.push(entry); });
		paintPending();
		return function () {
			pendingAdds = pendingAdds.filter(function (entry) { return entries.indexOf(entry) < 0; });
		};
	}

	/* Applies ops to a cart snapshot and returns the quantity every line
	   should have, in cart order. Each op sets its variant's total and
	   spreads it over that variant's lines. The free pouch follows the kit
	   one for one, with a floor of one so removing the kit leaves a single
	   pouch behind to reprice rather than emptying the cart, unless the
	   same batch binned the pouches too. */
	function planQuantities(cart, ops) {
		var qty = cart.items.map(function (item) { return item.quantity; });
		var kitDelta = 0;
		var changed = false;
		ops.forEach(function (op) {
			var anchor = anchorLine(cart, op.variantId);
			if (!anchor) return;
			var have = cart.items.reduce(function (n, item, i) {
				return item.variant_id === op.variantId ? n + qty[i] : n;
			}, 0);
			var want = op.remove ? 0 : Math.max(0, have + op.delta);
			if (want === have) return;
			if (KIT_HANDLE && anchor.handle === KIT_HANDLE) kitDelta += want - have;
			applyVariantWant(cart, qty, anchor, want);
			changed = true;
		});
		var gift = giftLine(cart);
		var giftBinned = gift && ops.some(function (op) { return op.remove && op.variantId === gift.variant_id; });
		if (kitDelta && gift && !giftBinned) {
			var pouches = cart.items.reduce(function (n, item, i) {
				return item.variant_id === gift.variant_id ? n + qty[i] : n;
			}, 0);
			applyVariantWant(cart, qty, gift, Math.max(1, pouches + kitDelta));
		}
		return { qty: qty, changed: changed };
	}

	/* ── Sending taps ── */
	function scheduleFlush() {
		if (flushTimer) clearTimeout(flushTimer);
		flushTimer = setTimeout(function () { flushTimer = null; flushNow(); }, FLUSH_DELAY);
		refreshStatus();
	}

	/* Sends whatever is parked, after anything already queued. Returns the
	   queue, which settles once the drawer shows Shopify's answer. */
	function flushNow(keepalive) {
		if (flushTimer) { clearTimeout(flushTimer); flushTimer = null; }
		if (!pending.length) { refreshStatus(); return queue; }
		return enqueue(function () {
			if (!pending.length || !currentCart) return;
			inflight = pending;
			pending = [];
			return sendOps(currentCart, inflight, 0, keepalive)
				.then(function (cart) { inflight = []; return settle(cart); });
		});
	}

	/* One update call. A refusal (the line count moved, or Shopify capped a
	   line) re-reads the cart and plans once more from what is really there;
	   a second refusal shows its reason and settles on Shopify's cart. */
	function sendOps(cart, ops, tries, keepalive) {
		var plan = planQuantities(cart, ops);
		if (!plan.changed) return Promise.resolve(cart);
		return updateLines(plan.qty, keepalive, attrsFor(cart, plan.qty)).then(function (res) {
			if (res.ok && res.body && res.body.items) return res.body;
			return fetchCart().then(function (fresh) {
				if (tries < 1) return sendOps(fresh, ops, tries + 1, keepalive);
				errorMsg = (res.body && res.body.description) || i18n.i18nUpdateFailed;
				return fresh;
			});
		});
	}

	/* A tab going away with taps still parked: send them now, keepalive so
	   the call outlives the page. A batch already in flight is not waited
	   for, so a tap made during it can be lost to navigation; the next page
	   renders whatever Shopify has. */
	window.addEventListener('pagehide', function () {
		if (pending.length && queued === 0) flushNow(true);
	});

	/* Back from the checkout through the back-forward cache: the page comes
	   back as it was, cart and all, so the cart is read again (the drawer,
	   wallet buttons included, is busy until the answer is on screen). */
	window.addEventListener('pageshow', function (e) {
		if (e.persisted) enqueue(function () { return fetchCart().then(settle); });
	});

	/* ── Checkout waits for the cart ──
	   Only the quantities on screen are ahead of Shopify; the checkout must
	   not be. With anything parked or in flight the click sends it all and
	   follows the link once the drawer shows Shopify's answer. */
	if (checkoutEl) {
		checkoutEl.addEventListener('click', function (e) {
			if (!isBusy()) return;
			e.preventDefault();
			if (checkoutEl.getAttribute('aria-busy') === 'true') return;
			checkoutEl.setAttribute('aria-busy', 'true');
			var href = checkoutEl.getAttribute('href');
			var go = function () { window.location.href = href; };
			flushNow().then(go, go);
		});
	}

	/* ── Settle & render ──
	   Renders the cart, after one top-up when it holds fewer pouches than
	   kits (a cart from before the two were kept in step). Top up only, so
	   paid pouches are never touched. */
	function settle(cart) {
		if (!cart || !cart.items) return;
		var gift = giftLine(cart);
		if (gift) {
			var have = variantQty(cart, gift.variant_id);
			var want = Math.max(have, kitQty(cart));
			if (want > have) {
				var qty = cart.items.map(function (item) { return item.quantity; });
				applyVariantWant(cart, qty, gift, want);
				return updateLines(qty, false, attrsFor(cart, qty))
					.then(function (res) { return res.ok && res.body && res.body.items ? res.body : fetchCart(); })
					.then(render);
			}
		}
		render(cart);
	}

	/* ── Row markup ──
	   One template for every row: the variants Shopify sent and the
	   provisional rows an add draws while it is on its way. */
	var SVG_OPEN = '<svg class="shrink-0 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"';
	var ICON_MINUS = SVG_OPEN + ' width="14" height="14"><path d="M5 12h14"/></svg>';
	var ICON_PLUS = SVG_OPEN + ' width="14" height="14"><path d="M12 5v14M5 12h14"/></svg>';
	var ICON_BIN = SVG_OPEN + ' width="16" height="16"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"></path></svg>';
	var ICON_GIFT = SVG_OPEN + ' width="12" height="12"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg>';
	var ICON_TAG = SVG_OPEN + ' width="12" height="12"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>';
	/* The light blue pill the gift chip and the code row share, and the
	   square controls: hover and keyboard focus show on every one, and the
	   ::before widens the tap target to 44px on touch screens without
	   moving anything. */
	var CHIP = 'inline-flex items-center gap-1 rounded-md bg-tertiary-light/15 px-2 py-0.5 text-xs font-semibold text-main';
	var ICON_X = SVG_OPEN + ' width="12" height="12"><path d="M6 18L18 6M6 6l12 12"/></svg>';
	/* The × on a code chip: a small round target, widened to 44px on touch screens by its ::before. */
	var CODE_REMOVE = 'relative -me-1 ms-0.5 flex size-5 shrink-0 items-center justify-center rounded-full cursor-pointer transition-colors hover:bg-tertiary-light/30 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-main pointer-coarse:before:absolute pointer-coarse:before:-inset-3';
	var CONTROL = 'relative flex size-8 shrink-0 items-center justify-center rounded-md cursor-pointer transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-main pointer-coarse:before:absolute pointer-coarse:before:-inset-1.5';
	var STEP = CONTROL + ' border border-border text-title enabled:hover:border-main disabled:cursor-not-allowed disabled:opacity-40';

	function imgTag(src, alt) {
		return '<img src="' + escAttr(src) + '" alt="' + escAttr(alt) + '" class="w-full h-full object-contain" loading="lazy">';
	}

	function qtyMarkup(quantity, stepper, minusOff) {
		var span = '<span data-line-qty class="min-w-4 text-center text-base font-semibold text-title">' + quantity + '</span>';
		if (!stepper) return '<div class="flex items-center gap-1.5">' + span + '</div>';
		return '<div class="flex items-center gap-1.5">'
			+ '<button type="button" data-qty-change="-1" class="' + STEP + '" aria-label="' + escAttr(i18n.i18nDecrease) + '"' + (minusOff ? ' disabled' : '') + '>' + ICON_MINUS + '</button>'
			+ span
			+ '<button type="button" data-qty-change="1" class="' + STEP + '" aria-label="' + escAttr(i18n.i18nIncrease) + '">' + ICON_PLUS + '</button>'
			+ '</div>';
	}

	function removeMarkup() {
		return '<button type="button" data-line-remove class="' + CONTROL + ' text-copy hover:text-highlight" aria-label="' + escAttr(i18n.i18nRemove) + '">' + ICON_BIN + '</button>';
	}

	/* The price block, Shopify's figures only: the original struck through
	   when the row came down, then "Free" when it came to nothing or the
	   amount it costs. */
	function priceBlock(original, final) {
		var struck = original > final ? '<s class="block text-xs text-copy"><bdi>' + formatMoney(original) + '</bdi></s>' : '';
		return struck + (final === 0
			? '<span class="block font-heading font-bold text-base text-highlight">' + escHtml(i18n.i18nFree) + '</span>'
			: '<span class="block font-heading font-bold text-base text-title"><bdi>' + formatMoney(final) + '</bdi></span>');
	}

	/* "Free gift" when the row's one pouch is free, "2 free gifts" or
	   "1 free gift" beside paid ones, nothing when no pouch is free. */
	function giftChip(free, final) {
		if (free < 1) return '';
		var label = free === 1 && final === 0 ? i18n.i18nFreeGift : freeGiftsLabel(free);
		return '<p class="mt-1"><span class="' + CHIP + '">' + ICON_GIFT + '<span>' + escHtml(label) + '</span></span></p>';
	}

	function freeGiftsLabel(n) {
		if (freeGifts[n]) return freeGifts[n];
		return String(freeGifts[11] || '').replace('11', String(n));
	}

	function lineRow(o) {
		return '<div class="flex items-start gap-3 md:gap-4 px-6 py-4" ' + o.attrs + '>'
			+ '<a href="' + escAttr(o.url) + '" aria-label="' + escAttr(o.name) + '" class="shrink-0 size-20 md:size-24 overflow-hidden rounded-xl border border-bg-muted bg-bg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-main">' + o.img + '</a>'
			+ '<div class="flex-1 min-w-0">'
				+ '<div class="flex items-start justify-between gap-3">'
					+ '<div class="min-w-0">'
						+ '<p class="font-heading font-semibold text-title text-base leading-snug">' + escHtml(o.name) + '</p>'
						+ (o.props || '')
						+ (o.chip || '')
					+ '</div>'
					+ '<div data-line-price class="shrink-0 text-end leading-snug transition-opacity group-aria-busy:opacity-40">' + o.price + '</div>'
				+ '</div>'
				+ '<div class="mt-2 flex items-center gap-3">' + o.controls + '</div>'
			+ '</div>'
		+ '</div>';
	}

	/* A row for a variant not yet in the cart, drawn from the catalogue the
	   Liquid above wrote. No stepper, no remove and no price until Shopify
	   has priced it: the discount decides whether a pouch is free. */
	function pendingRow(add) {
		var known = catalogue[add.id];
		if (!known) return '';
		var src = known.thumb || known.image;
		return lineRow({
			attrs: 'data-line-pending data-rank="' + rank(known.handle) + '"',
			url: known.url,
			img: src ? imgTag(src, (known.thumb ? known.thumbAlt : known.alt) || '') : '',
			name: known.name || brandTitle(known.title),
			controls: qtyMarkup(add.quantity, false),
			price: ''
		});
	}

	/* Kit first, then refills, then anything else. */
	function rank(handle) {
		if (KIT_HANDLE && handle === KIT_HANDLE) return 0;
		return handle === REFILL_HANDLE ? 1 : 2;
	}

	/* The cart as one entry per variant, its lines summed, in rank order
	   (cart order within a rank). */
	function variantRows(cart) {
		var rows = [];
		var byId = {};
		cart.items.forEach(function (item) {
			var row = byId[item.variant_id];
			if (!row) {
				row = byId[item.variant_id] = { item: item, quantity: 0, original: 0, final: 0, discount: 0, hasFree: false };
				rows.push(row);
			}
			row.quantity += item.quantity;
			row.original += item.original_line_price;
			row.final += item.final_line_price;
			row.discount += item.line_level_total_discount;
			if (isFreeGift(item)) row.hasFree = true;
		});
		return rows.sort(function (a, b) { return rank(a.item.handle) - rank(b.item.handle); });
	}

	/* Free pouches on the refill row, from Shopify's numbers only: the
	   discount on its lines over one pouch's price, rounded down (a pack
	   price takes off less than a pouch). Never more than the kits in the
	   cart, as a guard: the offer is one free pouch per kit. */
	function freePouches(row) {
		if (!row.item.original_price) return 0;
		return Math.min(Math.floor(row.discount / row.item.original_price), kitQty(currentCart));
	}

	/* One row per variant. The refill row carries the gift chip and holds
	   its free count, which − stops at: the kit sync would put those
	   pouches straight back. The thumbnail sits beside the name, so the
	   image only speaks when the merchant has written an alt on it. */
	function rowMarkup(row) {
		var item = row.item;
		var known = catalogue[item.variant_id] || {};
		var isRefill = item.handle === REFILL_HANDLE;
		var free = isRefill ? freePouches(row) : 0;
		var single = typeof known.single === 'boolean' ? known.single : item.product_has_only_default_variant;
		var cartImg = item.featured_image && item.featured_image.url ? item.featured_image : null;
		var src = known.thumb || (cartImg ? sizedImg(cartImg.url, '240x') : '');
		var alt = known.thumb ? known.thumbAlt : (cartImg && cartImg.alt);
		return lineRow({
			attrs: 'data-variant="' + item.variant_id + '" data-rank="' + rank(item.handle) + '"' + (isRefill ? ' data-free="' + free + '"' : '') + (row.hasFree ? ' data-has-free' : ''),
			url: item.url,
			img: src ? imgTag(src, alt || '') : '',
			name: known.name || brandTitle(item.product_title),
			props: !single && item.variant_title ? '<p class="text-copy text-sm mt-0.5">' + escHtml(item.variant_title) + '</p>' : '',
			chip: isRefill ? giftChip(free, row.final) : '',
			controls: qtyMarkup(row.quantity, true, isRefill && row.quantity <= free) + removeMarkup(),
			price: priceBlock(row.original, row.final)
		});
	}

	/* The order-level discount applications on a cart. /cart.js lists them
	   flat; /cart/update.js and /cart/change.js answer with each one wrapped
	   as { amount, discount_application } (seen 2026-10-21), which used to
	   drop the code row after a tap while the code was still on the cart.
	   Both shapes are read. */
	function cartCodes(cart) {
		return (cart.cart_level_discount_applications || []).map(function (app) {
			return app.discount_application || app;
		});
	}

	/* One order-level discount on the cart as a row: an automatic discount
	   ("2 kits for $69.99", the title Shopify sends, no suffix, no ×: an
	   automatic application is nothing update.js can take off) or a code
	   ("AIRA10 · 10% off" for a percentage, its title otherwise, with the ×
	   that takes it off), and what it took off the order. cart.js sends an
	   automatic application with an empty type and update.js with
	   "automatic", so a code is recognised by its type, nothing else. */
	function isCodeApp(app) {
		return app.type === 'discount_code';
	}

	function codeRow(app) {
		var code = '<bdi>' + escHtml(String(app.title || '').trim()) + '</bdi>';
		var label = isCodeApp(app) && app.value_type === 'percentage'
			? escHtml(i18n.i18nCodePercent).replace('__CODE__', code).replace('__PERCENT__', escHtml(String(parseFloat(app.value))))
			: code;
		return '<div class="flex items-center justify-between gap-3">'
			+ '<span class="' + CHIP + '">' + ICON_TAG + '<span>' + label + '</span>'
			+ (isCodeApp(app)
				? '<button type="button" data-code-remove="' + escAttr(app.title) + '" class="' + CODE_REMOVE + '" aria-label="' + escAttr(i18n.i18nRemoveCode.replace('__CODE__', app.title)) + '">' + ICON_X + '</button>'
				: '')
			+ '</span>'
			+ '<span class="shrink-0 font-heading font-semibold text-base text-title transition-opacity group-aria-busy:opacity-40"><bdi>−' + formatMoney(app.total_allocated_amount) + '</bdi></span>'
			+ '</div>';
	}

	function render(cart) {
		if (!cart || !cart.items) return;
		var hasItems = cart.item_count > 0;
		currentCart = cart;
		/* An empty cart ends the visitor's earlier no to the gift. */
		if (!hasItems) clearGiftRemoved();

		/* Toggle empty / filled states */
		emptyEl.classList.toggle('hidden', hasItems);
		emptyEl.classList.toggle('flex', !hasItems);
		itemsEl.classList.toggle('hidden', !hasItems);
		footerEl.classList.toggle('hidden', !hasItems);
		footerEl.classList.toggle('flex', hasItems);

		/* Update header cart counts */
		document.querySelectorAll('[data-cart-count]').forEach(function (el) {
			el.textContent = cart.item_count;
			el.closest('[data-cart-count-bubble]').classList.toggle('hidden', cart.item_count === 0);
		});

		/* One row per order-level discount the cart carries: automatic
		   discounts first, then codes, each in Shopify's order. */
		var apps = cartCodes(cart).filter(function (app) {
			return app.total_allocated_amount > 0;
		});
		var codes = apps.filter(function (app) { return !isCodeApp(app); }).concat(apps.filter(isCodeApp));
		codesEl.innerHTML = codes.map(codeRow).join('');
		codesEl.classList.toggle('hidden', codes.length === 0);
		codesEl.classList.toggle('flex', codes.length > 0);
		codeRowsShown = apps.some(isCodeApp);
		refreshOfferNote();
		refreshCodeField();

		/* "You save": Shopify's own total of every discount on the cart, the
		   line discounts (free pouches) and the order-level ones together. */
		var saved = cart.total_discount > 0;
		savingsEl.innerHTML = saved ? escHtml(i18n.i18nYouSave).replace('__AMOUNT__', '<bdi>' + formatMoney(cart.total_discount) + '</bdi>') : '';
		savingsEl.classList.toggle('hidden', !saved);

		/* Total, after every discount */
		subtotalEl.innerHTML = '<bdi>' + formatMoney(cart.total_price) + '</bdi>';

		/* The refill upsell: with items and no refill among them. The
		   second-kit offer may stand in front of it (refreshUpsells). */
		var hasRefills = cart.items.some(function (item) {
			return item.handle === REFILL_HANDLE;
		});
		upsellWanted = hasItems && !hasRefills;
		if (upsellEl) {
			upsellEl.classList.toggle('hidden', !upsellWanted);
		}

		/* The signup code for express pay (see planCodeApply) when no write
		   is coming to carry it: the drawer opened on a cart that already
		   had items. Runs in the queue, so Checkout waits for it. */
		if (expressOn && isOpen && hasItems && offerCode && codeTried !== offerCode && !pendingDiscount && !(cart.discount_codes || []).length) {
			var code = offerCode;
			codeTried = code;
			enqueue(function () {
				return postJson(ROOT + 'cart/update.js', { discount: code })
					.then(function (res) { return res.ok && res.body && res.body.items ? res.body : fetchCart(); })
					.then(render);
			});
		}
		if (isOpen && hasItems) mountExpress();

		/* Build the rows. Rows carry their variant id, which is what a tap is
		   resolved against; the update call still goes by line position. A
		   control that had focus gets it back on the new row. */
		var focused = focusedControl();
		itemsEl.innerHTML = variantRows(cart).map(rowMarkup).join('');

		paintPending();
		restoreFocus(focused);
		refreshStatus();
	}

	/* Paints what the parked taps and the adds on their way will produce, so
	   a tap or an add shows at once. Only quantities and rows move: prices
	   and the totals keep their last known values, dimmed by aria-busy,
	   until Shopify answers. An empty cart with an add on its way shows the
	   rows in place of the empty state, and no total, as none is known. */
	function paintPending() {
		if (!currentCart) return;
		var ops = inflight.concat(pending);
		var qty = ops.length ? planQuantities(currentCart, ops).qty : currentCart.items.map(function (item) { return item.quantity; });
		/* What each variant's row will hold: its lines as planned, plus adds on their way */
		var want = {};
		currentCart.items.forEach(function (item, i) {
			want[item.variant_id] = (want[item.variant_id] || 0) + qty[i];
		});
		var fresh = [];
		pendingAdds.forEach(function (add) {
			if (want[add.id] !== undefined) { want[add.id] += add.quantity; return; }
			var same = fresh.filter(function (f) { return f.id === add.id; })[0];
			if (same) same.quantity += add.quantity;
			else fresh.push({ id: add.id, quantity: add.quantity });
		});
		itemsEl.querySelectorAll('[data-variant]').forEach(function (row) {
			var n = want[row.getAttribute('data-variant')] || 0;
			row.querySelector('[data-line-qty]').textContent = n;
			row.classList.toggle('hidden', n === 0);
			/* − stops at the free pouches, here as the row will be once Shopify answers */
			var free = row.getAttribute('data-free');
			var minus = row.querySelector('[data-qty-change="-1"]');
			if (minus && free !== null) {
				var off = n <= parseInt(free, 10);
				if (off && document.activeElement === minus) row.querySelector('[data-qty-change="1"]').focus();
				minus.disabled = off;
			}
		});
		itemsEl.querySelectorAll('[data-line-pending]').forEach(function (row) { row.remove(); });
		/* Provisional rows slot in by rank, so the rows already drawn (and the
		   control that has focus) never move. */
		var drawn = fresh.filter(function (add) { return catalogue[add.id]; });
		drawn.forEach(function (add) {
			var r = rank(catalogue[add.id].handle);
			var before = Array.prototype.filter.call(itemsEl.children, function (el) {
				return parseInt(el.getAttribute('data-rank'), 10) > r;
			})[0];
			if (before) before.insertAdjacentHTML('beforebegin', pendingRow(add));
			else itemsEl.insertAdjacentHTML('beforeend', pendingRow(add));
		});
		var showRows = currentCart.item_count > 0 || drawn.length > 0;
		emptyEl.classList.toggle('hidden', showRows);
		emptyEl.classList.toggle('flex', !showRows);
		itemsEl.classList.toggle('hidden', !showRows);
		footerEl.classList.toggle('hidden', !showRows);
		footerEl.classList.toggle('flex', showRows);
		if (reviewsEl) {
			reviewsEl.classList.toggle('hidden', !showRows);
			reviewsEl.classList.toggle('flex', showRows);
		}
		if (currentCart.item_count === 0) subtotalEl.innerHTML = drawn.length ? '' : '<bdi>' + formatMoney(currentCart.total_price) + '</bdi>';
		refreshUpsells(want, fresh, showRows);
	}

	/* The second-kit offer, from the planned quantities so it follows a tap
	   at once: shown while exactly one kit is in the cart and none is on
	   its way. While it shows the refill upsell stands aside; otherwise the
	   refill upsell keeps render()'s verdict. Nothing here runs without the
	   row, so the refill upsell behaves as it always has. */
	function refreshUpsells(want, fresh, showRows) {
		if (!secondKitEl) return;
		var kits = 0;
		var kitPending = false;
		Object.keys(want).forEach(function (id) {
			if (variantHandle(id) === KIT_HANDLE) kits += want[id];
		});
		fresh.forEach(function (add) {
			if (variantHandle(add.id) === KIT_HANDLE) { kits += add.quantity; kitPending = true; }
		});
		var secondShown = showRows && kits === 1 && !kitPending;
		if (!secondShown) handOffFocus(secondKitEl);
		secondKitEl.classList.toggle('hidden', !secondShown);
		if (secondShown && isOpen && !secondKitNoted) {
			secondKitNoted = true;
			clarity('second_kit_offer', 'shown');
		}
		if (upsellEl) {
			var upsellShown = upsellWanted && !secondShown;
			if (!upsellShown) handOffFocus(upsellEl);
			upsellEl.classList.toggle('hidden', !upsellShown);
		}
	}

	/* A box about to hide while one of its controls has focus hands it on,
	   as a binned row does: to a kit row's +, else the close button. */
	function handOffFocus(box) {
		if (box.classList.contains('hidden') || !box.contains(document.activeElement)) return;
		var plus = itemsEl.querySelector('[data-variant]:not(.hidden) [data-qty-change="1"]');
		(plus || closeBtn).focus({ preventScroll: true });
	}

	/* A variant's product handle, from the catalogue or the cart line. */
	function variantHandle(id) {
		var known = catalogue[id];
		if (known) return known.handle;
		var line = currentCart ? currentCart.items.filter(function (item) { return String(item.variant_id) === String(id); })[0] : null;
		return line ? line.handle : '';
	}

	/* ── Focus across a re-render ──
	   A render rebuilds the rows, which would drop keyboard focus. The
	   control that had it is noted first and focused again on its variant's
	   new row (+ when − has just been switched off); a binned row hands
	   focus to the close button. */
	function focusedControl() {
		var el = document.activeElement;
		var row = el && itemsEl.contains(el) ? el.closest('[data-variant]') : null;
		if (!row) return null;
		return {
			variant: row.getAttribute('data-variant'),
			selector: el.hasAttribute('data-line-remove') ? '[data-line-remove]' : '[data-qty-change="' + el.getAttribute('data-qty-change') + '"]'
		};
	}

	function restoreFocus(focused) {
		if (!focused) return;
		var row = itemsEl.querySelector('[data-variant="' + focused.variant + '"]:not(.hidden)');
		var el = row && row.querySelector(focused.selector);
		if (el && el.disabled) el = row.querySelector('[data-qty-change="1"]');
		(el || closeBtn).focus({ preventScroll: true });
	}

	/* ── Quantity change / remove (event delegation) ──
	   A tap is parked, painted, and sent with any others that follow within
	   FLUSH_DELAY as one update call. It acts on the row's variant: + adds
	   one, − takes one off (a paid pouch first), the bin clears every line
	   of the variant. */
	itemsEl.addEventListener('click', function (e) {
		var qtyBtn = e.target.closest('[data-qty-change]');
		var removeBtn = e.target.closest('[data-line-remove]');
		var row = e.target.closest('[data-variant]');
		if (!row || (!qtyBtn && !removeBtn) || !currentCart) return;
		if (qtyBtn && qtyBtn.disabled) return;

		var variantId = parseInt(row.getAttribute('data-variant'), 10);
		if (firstIndexOfVariant(currentCart, variantId) < 0) return;
		errorMsg = '';

		if (removeBtn) {
			/* Binning free pouches is a choice, remembered for this session
			   so the next add-to-cart does not put them straight back. */
			if (row.hasAttribute('data-has-free') || parseInt(row.getAttribute('data-free'), 10) > 0) markGiftRemoved();
			addOp({ variantId: variantId, delta: 0, remove: true });
		} else {
			addOp({ variantId: variantId, delta: parseInt(qtyBtn.getAttribute('data-qty-change'), 10), remove: false });
		}
	});

	function addOp(op) {
		var same = pending.filter(function (p) { return p.variantId === op.variantId; })[0];
		if (same) {
			same.delta += op.delta;
			same.remove = same.remove || op.remove;
		} else {
			pending.push(op);
		}
		paintPending();
		scheduleFlush();
	}

	/* ── Helpers ── */
	function readJson(selector) {
		var el = document.querySelector(selector);
		try { return JSON.parse(el.textContent) || {}; } catch (e) { return {}; }
	}

	/* Always the store's "$49.99", with Western digits, whatever language
	   the browser runs in: a browser locale gave Arabic phones "٤٩٫٩٩ US$"
	   and UK ones "US$49.99". */
	function formatMoney(cents) {
		return (cents / 100).toLocaleString('en-US', { style: 'currency', currency: currency });
	}

	function sizedImg(url, size) {
		/* Shopify CDN: insert _240x (the size asked for) before the file extension */
		return url.replace(/(\.\w+)(\?|$)/, '_' + size + '$1$2');
	}

	function escHtml(str) {
		var d = document.createElement('div');
		d.textContent = str;
		return d.innerHTML;
	}

	/* escHtml leaves quotes alone, which is fine inside an element but not
	   inside a double-quoted attribute value. */
	function escAttr(str) {
		return escHtml(str).replace(/"/g, '&quot;');
	}

	/* The Ajax cart returns raw admin product titles ("Aira Kit"), so the
	   brand is lowercased here to match the product-title snippet used
	   everywhere the titles are rendered in Liquid. Plain text: escape it
	   where it lands. */
	function brandTitle(str) {
		return String(str).replace(/\bAIRA\b/g, 'aira').replace(/\bAira\b/g, 'aira');
	}

	/* ── Init: pre-load cart state, first in the queue so an early tap or
	   add-to-cart plans against a real cart ── */
	enqueue(function () { return fetchCart().then(settle); });
})();
</script>
