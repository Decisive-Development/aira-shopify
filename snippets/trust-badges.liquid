{%- comment -%}
	trust-badges — the trust badge row under a product buy box: three plain
	columns, outline icons, label from the block, optional
	per-badge link (Tom, 2026-10-11: tiles dropped for the flat row).
	Params:
		blocks — the section's trust_badge blocks.
{%- endcomment -%}
{%- if blocks.size > 0 -%}
	<div class="grid grid-cols-3 gap-3 py-2">
		{%- for block in blocks -%}
			{%- capture badge_classes -%}flex flex-col items-center justify-start text-center gap-2 px-1{%- endcapture -%}
			{%- capture badge_inner -%}
				{%- case block.settings.icon_type -%}
					{%- when 'research' -%}
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-main" aria-hidden="true"><path d="M9 3h6M10 3v6.3L4.6 18.6A1.5 1.5 0 005.9 21h12.2a1.5 1.5 0 001.3-2.4L14 9.3V3"/><path d="M7.5 15h9"/></svg>
					{%- when 'patented' -%}
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-main" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
					{%- when 'doctor' -%}
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-main" aria-hidden="true"><path d="M10 13a5 5 0 007.1.1l3-3a5 5 0 00-7.1-7.1l-1.7 1.7"/><path d="M14 11a5 5 0 00-7.1-.1l-3 3a5 5 0 007.1 7.1l1.7-1.7"/></svg>
					{%- when 'shield' -%}
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-main" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
					{%- else -%}
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-main" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
				{%- endcase -%}
				<span class="font-heading font-semibold text-title text-xs leading-tight">{{ block.settings.text }}</span>
			{%- endcapture -%}
			{%- if block.settings.link != blank -%}
				<a href="{{ block.settings.link }}" class="{{ badge_classes }} hover:opacity-80 transition-opacity" {{ block.shopify_attributes }}>{{ badge_inner }}</a>
			{%- else -%}
				<div class="{{ badge_classes }}" {{ block.shopify_attributes }}>{{ badge_inner }}</div>
			{%- endif -%}
		{%- endfor -%}
	</div>
{%- endif -%}
