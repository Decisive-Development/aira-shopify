<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- comment -%}
  Per-page SEO title + description are owned in code via the seo-meta snippet.
  Any page it does not map falls back to the Shopify admin "Search engine
  listing" fields (page_title / page_description). Edit copy in seo-meta.liquid.
{%- endcomment -%}
{%- capture seo_title -%}{%- render 'seo-meta', field: 'title' -%}{%- endcapture -%}
{%- capture seo_description -%}{%- render 'seo-meta', field: 'description' -%}{%- endcapture -%}
{%- liquid
  assign seo_title = seo_title | strip
  assign seo_description = seo_description | strip

  assign seo_title_is_custom = false
  if seo_title != blank
    assign seo_title_is_custom = true
  else
    assign seo_title = page_title
  endif
  if seo_description == blank
    assign seo_description = page_description
  endif

  comment
    Every policy now lives twice: Shopify's own /policies/<handle> URL and the
    /pages/<handle> version the sitemap and the footer point at, both rendered
    from the same native policy fields. The /pages/* copy is the canonical one,
    so point /policies/* at it whenever a page with the matching handle exists.
  endcomment
  assign canonical_href = canonical_url
  if request.page_type == 'policy'
    assign policy_handle = request.path | split: '/' | last
    assign policy_mirror_page = pages[policy_handle]
    if policy_mirror_page.handle != blank
      assign canonical_href = policy_mirror_page.url | prepend: shop.url
    endif
  endif

  assign og_title = seo_title | default: shop.name
  assign og_url = canonical_href | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign append_brand = true
  if seo_title_is_custom
    assign append_brand = false
  elsif seo_title contains shop.name
    assign append_brand = false
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- comment -%}
  Brand-level structured data. Organization and WebSite describe the site as a
  whole, so they render once, on the homepage, alongside the page-level Product
  and FAQPage blocks that belong to their own templates.

  sameAs is deliberately absent. It needs the live social profile URLs, which
  are not confirmed yet; add the array here once they land and never guess one.
{%- endcomment -%}
{%- if request.page_type == 'index' -%}
  {%- liquid
    assign brand_logo_url = 'aira-logo-text-blue.svg' | asset_url
    if settings.brand_logo != blank
      assign brand_logo_url = settings.brand_logo | image_url: width: 512
    endif
    unless brand_logo_url contains 'https:'
      assign brand_logo_url = brand_logo_url | prepend: 'https:'
    endunless

    assign brand_url = shop.url | append: '/'
    assign organization_id = shop.url | append: '/#organization'
    assign website_id = shop.url | append: '/#website'
    assign search_url_template = shop.url | append: '/search?q={search_term_string}'
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ organization_id | json }},
          "name": "aira",
          "legalName": "AIRA WELLNESS ECOM FZCO",
          "url": {{ brand_url | json }},
          "logo": {{ brand_logo_url | json }}
          {%- if settings.support_email != blank -%}
            , "email": {{ settings.support_email | json }}
          {%- endif -%}
          {%- if settings.support_whatsapp_number != blank -%}
            , "telephone": {{ settings.support_whatsapp_number | prepend: '+' | json }}
          {%- endif -%}
        },
        {
          "@type": "WebSite",
          "@id": {{ website_id | json }},
          "name": "aira",
          "url": {{ brand_url | json }},
          "publisher": { "@id": {{ organization_id | json }} },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": {{ search_url_template | json }}
            },
            "query-input": "required name=search_term_string"
          }
        }
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ seo_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- if append_brand %} &ndash; {{ shop.name }}{% endif -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_href }}"
>

{% if seo_description != blank %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
