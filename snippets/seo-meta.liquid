{%- comment -%}
  seo-meta — code-owned per-page meta copy (title + description).

  Rendered from meta-tags.liquid, which falls back to the Shopify admin
  "Search engine listing" fields (page_title / page_description) for any page
  not mapped here. Pass field: 'title' or field: 'description'.

  The wording lives in locales/en.default.json (snippets.seo_meta), with the
  Arabic in locales/ar.json. The keys end in _html so t returns the text
  unescaped and meta-tags.liquid escapes it once, as it did the literals.

  Editing rules (see .claude/rules/copy.md and the SEO brief):
    - Titles <= 60 characters, descriptions <= 155.
    - UK English, aira lowercase, no em-dashes or arrows, brand last in titles.
    - Product handles, page handles and template suffixes must match the live
      store.

  Coverage notes: /pages/returns (suffix 'returns') and /collections/all
  (collection handle 'all') are mapped below. Any other collection falls back
  to the admin "Search engine listing" fields on purpose. Pages on the default
  page template carry no suffix, so they are mapped by page handle after the
  suffix lookup.
{%- endcomment -%}
{%- liquid
  assign seo_title = ''
  assign seo_description = ''

  case request.page_type
    when '404'
      assign seo_title = 'snippets.seo_meta.not_found_title_html' | t
      assign seo_description = 'snippets.seo_meta.not_found_description_html' | t

    when 'index'
      assign seo_title = 'snippets.seo_meta.index_title_html' | t
      assign seo_description = 'snippets.seo_meta.index_description_html' | t

    when 'product'
      case product.handle
        when 'aira-kit'
          assign seo_title = 'snippets.seo_meta.kit_title_html' | t
          # The sentence "$49.99 with a free refill pack at launch." in
          # snippets.seo_meta.kit_description_html (both locale files) is tied to
          # the launch offer. When the offer ends, drop that sentence and keep
          # the description under 155 characters.
          assign seo_description = 'snippets.seo_meta.kit_description_html' | t
        when 'aira-refill-tabs'
          assign seo_title = 'snippets.seo_meta.refill_title_html' | t
          assign seo_description = 'snippets.seo_meta.refill_description_html' | t
      endcase

    when 'collection'
      case collection.handle
        when 'all'
          assign seo_title = 'snippets.seo_meta.collection_all_title_html' | t
          assign seo_description = 'snippets.seo_meta.collection_all_description_html' | t
      endcase

    when 'page'
      case template.suffix
        when 'faq'
          assign seo_title = 'snippets.seo_meta.faq_title_html' | t
          assign seo_description = 'snippets.seo_meta.faq_description_html' | t
        when 'how-it-works'
          assign seo_title = 'snippets.seo_meta.how_it_works_title_html' | t
          assign seo_description = 'snippets.seo_meta.how_it_works_description_html' | t
        when 'backed-by-science'
          assign seo_title = 'snippets.seo_meta.backed_by_science_title_html' | t
          assign seo_description = 'snippets.seo_meta.backed_by_science_description_html' | t
        when 'contact'
          assign seo_title = 'snippets.seo_meta.contact_title_html' | t
          assign seo_description = 'snippets.seo_meta.contact_description_html' | t
        when 'our-story'
          assign seo_title = 'snippets.seo_meta.our_story_title_html' | t
          assign seo_description = 'snippets.seo_meta.our_story_description_html' | t
        when 'privacy-policy'
          assign seo_title = 'snippets.seo_meta.privacy_policy_title_html' | t
          assign seo_description = 'snippets.seo_meta.privacy_policy_description_html' | t
        when 'shipping-policy'
          assign seo_title = 'snippets.seo_meta.shipping_policy_title_html' | t
          assign seo_description = 'snippets.seo_meta.shipping_policy_description_html' | t
        when 'terms-of-service'
          assign seo_title = 'snippets.seo_meta.terms_of_service_title_html' | t
          assign seo_description = 'snippets.seo_meta.terms_of_service_description_html' | t
        when 'refund-policy'
          assign seo_title = 'snippets.seo_meta.refund_policy_title_html' | t
          assign seo_description = 'snippets.seo_meta.refund_policy_description_html' | t
        when 'returns'
          assign seo_title = 'snippets.seo_meta.returns_title_html' | t
          assign seo_description = 'snippets.seo_meta.returns_description_html' | t
      endcase

      comment
        Pages that run on the default page template have no suffix to match
        on, so they are mapped by handle instead. Both affiliate spellings are
        listed until the admin-side rename and its 301 land.
      endcomment
      if seo_title == blank
        case page.handle
          when 'affiliate-program' or 'affilliate-program'
            assign seo_title = 'snippets.seo_meta.affiliate_title_html' | t
            assign seo_description = 'snippets.seo_meta.affiliate_description_html' | t
        endcase
      endif
  endcase

  if field == 'title'
    echo seo_title
  else
    echo seo_description
  endif
-%}
