{%- comment -%}
  seo-meta — code-owned per-page meta copy (title + description).

  Rendered from meta-tags.liquid, which falls back to the Shopify admin
  "Search engine listing" fields (page_title / page_description) for any page
  not mapped here. Pass field: 'title' or field: 'description'.

  Editing rules (see .claude/rules/copy.md and the SEO brief):
    - Titles <= 60 characters, descriptions <= 155.
    - UK English, aira lowercase, no em-dashes or arrows, brand last in titles.
    - Product handles, page handles and template suffixes must match the live
      store.

  Coverage notes: /pages/returns (suffix 'returns') and /collections/all
  (collection handle 'all') are mapped below. Any other collection falls back
  to the admin "Search engine listing" fields on purpose. Pages on the default
  page template carry no suffix, so they are mapped by page handle after the
  suffix lookup.
{%- endcomment -%}
{%- liquid
  assign seo_title = ''
  assign seo_description = ''

  case request.page_type
    when 'index'
      assign seo_title = "Reusable magnetic nasal strips | aira"
      assign seo_description = "Reusable magnetic nasal strips that hold your nose open all night. Less snoring, deeper sleep, easier training. Free shipping in the UAE and Saudi Arabia."

    when 'product'
      case product.handle
        when 'aira-kit'
          assign seo_title = "Reusable magnetic nasal strip kit, 30 nights of tabs | aira"
          # The sentence "$49.99 with a free refill pack at launch." is tied to
          # the launch offer. When the offer ends, drop that sentence and keep
          # the description under 155 characters.
          assign seo_description = "One reusable band, four sizes in the box, 30 nights of 3M tabs. $49.99 with a free refill pack at launch. 30-night guarantee, free UAE and Saudi delivery."
        when 'aira-refill-tabs'
          assign seo_title = "Nasal strip refill tabs, 30 to 90 pairs | aira"
          assign seo_description = "Refill tabs for your aira band. 30 fresh pairs a month, 3M medical-grade adhesive, delivered across the GCC. Packs of 30, 60 or 90 pairs, from $19.99."
      endcase

    when 'collection'
      case collection.handle
        when 'all'
          assign seo_title = "Shop nasal strips and refills | aira"
          assign seo_description = "Two products, one job: keeping your airway open. Start with the aira kit or top up refill tabs. Free delivery across the UAE and Saudi Arabia."
      endcase

    when 'page'
      case template.suffix
        when 'faq'
          assign seo_title = "Nasal strip questions, answered | aira"
          assign seo_description = "Do nasal strips work for snoring? How do magnetic nasal strips stay on? Answers on fit, sizing, the 3M adhesive, shipping and the 30-night guarantee."
        when 'how-it-works'
          assign seo_title = "How magnetic nasal strips work | aira"
          assign seo_description = "One magnetic band, a fresh pair each night, ten seconds to put on. See how the aira strip holds your nose open all night, and how to fit your size."
        when 'backed-by-science'
          assign seo_title = "Backed by science | aira"
          assign seo_description = "Seven peer-reviewed studies on nasal dilation, snoring and sleep, and what they do and don't prove. The research behind the aira strip, cited in full."
        when 'contact'
          assign seo_title = "Contact | aira"
          assign seo_description = "Questions about your order, fit or shipping across the GCC? Message the aira team and we'll sort it."
        when 'our-story'
          assign seo_title = "Our story | aira"
          assign seo_description = "Why two founders in the UAE built a reusable magnetic nasal strip, and what we're building next. The people and the thinking behind aira."
        when 'privacy-policy'
          assign seo_title = "Privacy policy | aira"
          assign seo_description = "How aira collects, uses and protects your data when you shop with us."
        when 'shipping-policy'
          assign seo_title = "Shipping policy | aira"
          assign seo_description = "Delivery times, costs and coverage for aira orders across the GCC."
        when 'terms-of-service'
          assign seo_title = "Terms of service | aira"
          assign seo_description = "The terms that apply when you buy from aira."
        when 'refund-policy'
          assign seo_title = "Refund policy | aira"
          assign seo_description = "Try aira for 30 nights. If it's not for you, send it back for a refund. How returns, refunds and the guarantee work across the GCC."
        when 'returns'
          assign seo_title = "Returns and the 30-night guarantee | aira"
          assign seo_description = "Not sleeping better after 30 nights? Start a return in a few clicks. Eligibility, steps and refund timelines for UAE and Saudi orders."
      endcase

      comment
        Pages that run on the default page template have no suffix to match
        on, so they are mapped by handle instead. Both affiliate spellings are
        listed until the admin-side rename and its 301 land.
      endcomment
      if seo_title == blank
        case page.handle
          when 'affiliate-program' or 'affilliate-program'
            assign seo_title = "Affiliate program | aira"
            assign seo_description = "Earn commission promoting aira magnetic nasal strips. Simple terms, honest products, and a team that answers. Apply to join the aira affiliate programme."
        endcase
      endif
  endcase

  if field == 'title'
    echo seo_title
  else
    echo seo_description
  endif
-%}
