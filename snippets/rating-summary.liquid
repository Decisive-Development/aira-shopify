{%- comment -%}
	rating-summary — five stars and the rating line ("4.9 from 82 reviews").
	The stars come from rating-stars (shared with featured-review) and the
	wording from the same locale key as the summary under the reviews section
	heading, so the two always read alike. Renders nothing unless both values
	are set.
	Params:
		rating — the average rating, e.g. "4.9".
		count  — the number of reviews, e.g. 82.
		url    — optional. Makes the line a link, e.g. "#reviews" to jump to the
		         reviews section. The ::before halo widens the tap target to 44px
		         on coarse pointers without changing the line box.
{%- endcomment -%}
{%- if rating != blank and count != blank -%}
	{%- liquid
		assign rating_number = rating | times: 1.0
		assign rating_display = rating_number | round: 1
	-%}
	{%- capture rating_inner -%}
		{%- render 'rating-stars', rating: rating_number -%}
		<span>{{ 'sections.custom_reviews.summary' | t: count: count, rating: rating_display }}</span>
	{%- endcapture -%}
	{%- if url != blank -%}
		<a href="{{ url }}" class="relative self-start flex items-center gap-2 text-sm text-copy hover:text-highlight transition-colors pointer-coarse:before:absolute pointer-coarse:before:inset-x-0 pointer-coarse:before:-inset-y-3" data-rating-link>{{ rating_inner }}</a>
	{%- else -%}
		<div class="flex items-center gap-2 text-sm text-copy">{{ rating_inner }}</div>
	{%- endif -%}
{%- endif -%}
