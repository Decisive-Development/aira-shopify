{%- comment -%}
	whatsapp-link — the one click-to-WhatsApp anchor. Every placement (product
	buy box, footer, contact page, FAQ) renders this. The number comes from
	Theme settings → Support & contact and appears nowhere in code. A blank
	number renders nothing, so callers wrap any lead-in text in the same check
	to avoid an orphaned "Questions?".

	Params:
	  source    {String}  'pdp' | 'footer' | 'contact' | 'faq' (required). Lands
	                      in data-wa-source for the aira_whatsapp_click event
	                      the footer's delegated listener publishes.
	  label     {String}  visible link text, already translated (required)
	  message   {String}  pre-filled first message, already translated
	  variant   {String}  'inline' (text link, default) | 'button' (cta-button)
	                      | 'bubble' (floating door, see snippets/whatsapp-bubble)
	  surface   {String}  'light' (navy text, default) | 'dark' (cream text)
	  icon_size {Number}  glyph size in px. Default 18. Pass 0 for no icon
	                      (running text).

	Liquid gotcha: render arguments take no filters, so translate first:
	  {%- assign wa_label = 'contact.whatsapp_cta' | t -%}
	  {%- assign wa_msg   = 'contact.whatsapp_prefill' | t -%}
	  {%- render 'whatsapp-link', source: 'footer', label: wa_label, message: wa_msg -%}
{%- endcomment -%}
{%- if settings.support_whatsapp_number != blank -%}
	{%- liquid
		assign wa_variant = variant | default: 'inline'
		assign wa_surface = surface | default: 'light'
		assign wa_icon = icon_size | default: 18

		# url_encode turns spaces into "+", which several WhatsApp clients show
		# as a literal plus in the message. wa.me wants %20.
		assign wa_text = message | url_encode | replace: '+', '%20'
		assign wa_href = 'https://wa.me/' | append: settings.support_whatsapp_number | append: '?text=' | append: wa_text
		assign wa_attrs = 'target="_blank" rel="noopener" data-wa-source="' | append: source | append: '"'

		if wa_surface == 'dark'
			assign wa_color = 'text-secondary'
		else
			assign wa_color = 'text-main'
		endif
	-%}
	{%- capture wa_inner -%}
		{%- if wa_icon != 0 -%}{%- render 'icon-whatsapp', size: wa_icon -%}{%- endif -%}
		<span>{{ label }}</span>
	{%- endcapture -%}
	{%- if wa_variant == 'button' -%}
		{%- render 'cta-button', label: wa_inner, url: wa_href, variant: 'solid', surface: wa_surface, attributes: wa_attrs -%}
	{%- elsif wa_variant == 'bubble' -%}
		{%- comment -%}
			Floating bubble: 56px circle below lg, pill with the label from lg.
			The label stays in the DOM as sr-only below lg, so the accessible
			name is always the visible text and no aria-label is needed.
		{%- endcomment -%}
		<a href="{{ wa_href }}" class="wa-bubble fixed z-40 inline-flex items-center justify-center gap-2 h-14 w-14 rounded-full shadow-lg font-body text-sm font-semibold tracking-wide lg:h-13 lg:w-auto lg:px-5" {{ wa_attrs }}>{%- render 'icon-whatsapp', size: wa_icon -%}<span class="sr-only lg:not-sr-only">{{ label }}</span></a>
	{%- else -%}
		{%- comment -%}
			Inline text link: inherits the surrounding font size, underlines on
			hover and keyboard focus. The ::before halo widens the tap target to
			44px on coarse pointers without changing the line box (CLS 0).
		{%- endcomment -%}
		<a href="{{ wa_href }}" class="relative inline-flex items-center gap-1.5 font-semibold {{ wa_color }} underline-offset-4 hover:underline focus-visible:underline pointer-coarse:before:absolute pointer-coarse:before:inset-x-0 pointer-coarse:before:-inset-y-3" {{ wa_attrs }}>{{ wa_inner }}</a>
	{%- endif -%}
{%- endif -%}
