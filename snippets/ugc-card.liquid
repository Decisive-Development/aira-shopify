{%- comment -%}
	Snippet: ugc-card
	One UGC testimonial card for the gallery, sourced from a `ugc_testimonial`
	metaobject entry (the shared list, edited once in the admin and shown on
	every page).

	Params:
	  entry    {Object}  the metaobject entry
	  card_dir {String}  optional. dir attribute for the card ('rtl' on Arabic
	                     pages, the track itself is ltr).
	  layout   {String}  optional. 'gallery' (default): a 9:16 tile with the
	                     quote over the frame. 'compact': a bare 3:4 tile, no caption, for the
	                     kit buy box (Tom, 2026-10-11: names and copy off).
{%- endcomment -%}

{%- liquid
	assign card_quote = entry.quote.value
	assign card_name  = entry.name.value
	assign m_image    = entry.image.value
	assign m_video    = entry.video.value
	assign has_video  = false
	assign has_image  = false
	if m_video != blank
		assign has_video = true
	endif
	if m_image != blank
		assign has_image = true
	endif
	assign card_layout = layout | default: 'gallery'
-%}

{%- if card_layout == 'compact' -%}
<div
	class="shrink-0 w-[38%] md:w-[30%]{% if has_video %} group cursor-pointer{% endif %}"{% if card_dir != blank %} dir="{{ card_dir }}"{% endif %}
	{% if has_video %}data-ugc-card role="button" tabindex="0" aria-label="{{ 'snippets.ugc_card.play_video' | t }}"{% endif %}
>
	<div class="relative rounded-2xl overflow-hidden bg-bg-muted" style="aspect-ratio: 3 / 4;">
		{%- if has_video -%}
			{%- comment -%}
				The tile renders about 138px wide on a phone and 169px on desktop,
				so a 480px poster covers a 3x screen; it waits for the tile to come
				near (poster_defer) so it never competes with the hero. The muted
				box behind it stands in until then.
				Shopify names each video file by the height of its encoded frame,
				so for a portrait upload "480p" is 270x480 and "720p" is 404x720
				(a phone clip stored landscape with a rotation flag gives 480x852
				and 720x1280 instead). The tile plays 480p on a phone and 720p
				from md up, where a 2x laptop needs about 340px of video (UGC
				tiles brief v2, 13 Oct 2026). The player below opens on the same
				poster URL, which the tile has already fetched.
			{%- endcomment -%}
			{%- render 'lazy-video',
				video: m_video,
				mode: 'tile',
				class: 'absolute inset-0 w-full h-full object-cover',
				poster_width: 480,
				poster_defer: true
			-%}
			{%- comment -%} A small soft play glyph, no disc (Tom, 2026-10-11). {%- endcomment -%}
			<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
				<svg width="28" height="28" viewBox="0 0 24 24" fill="white" class="opacity-70 drop-shadow-sm transition-opacity group-hover:opacity-90" aria-hidden="true"><path d="M8 5.5c0-.8.9-1.3 1.6-.9l9.2 6.5c.6.4.6 1.3 0 1.7l-9.2 6.5c-.7.5-1.6 0-1.6-.9z"/></svg>
			</div>
			<template data-ugc-modal-content>
				{%- render 'lazy-video',
					video: m_video,
					quality: 'full',
					mode: 'modal',
					class: 'w-full h-full object-contain bg-black',
					poster_width: 480
				-%}
			</template>
		{%- elsif has_image -%}
			{{ m_image | image_url: width: 400 | image_tag: loading: 'lazy', decoding: 'async', class: 'absolute inset-0 w-full h-full object-cover', widths: '200, 300, 400', draggable: 'false' }}
		{%- endif -%}
	</div>
</div>
{%- else -%}
<div
	class="relative shrink-0 w-[65%] md:w-[22%] rounded-2xl overflow-hidden{% if has_video %} group cursor-pointer{% endif %}"
	style="aspect-ratio: 9 / 16;"{% if card_dir != blank %} dir="{{ card_dir }}"{% endif %}
	{% if has_video %}data-ugc-card role="button" tabindex="0" aria-label="{{ 'snippets.ugc_card.play_video' | t }}"{% endif %}
>
	{%- if has_video -%}
		{%- comment -%}
			The tile renders at 260px wide on a phone and about a fifth of the
			row on desktop. Shopify names each video file by the height of its
			encoded frame, so for a portrait upload "480p" is 270x480, "720p"
			is 404x720 and "1080p" is 606x1080 (a clip stored landscape with a
			rotation flag gives 480x852, 720x1280 and 1080x1920 instead).
			The tile plays 480p on a phone and 720p from md up; the player
			below plays 720p on a phone and 1080p from md up, and opens on the
			tile's poster URL (the default 800px in both renders). Neither
			loads before it is needed.
		{%- endcomment -%}
		{%- render 'lazy-video',
			video: m_video,
			mode: 'tile',
			class: 'absolute inset-0 w-full h-full object-cover'
		-%}
	{%- elsif has_image -%}
		{{ m_image | image_url: width: 600 | image_tag: loading: 'lazy', decoding: 'async', class: 'absolute inset-0 w-full h-full object-cover', widths: '300, 400, 600', draggable: 'false' }}
	{%- else -%}
		<div class="absolute inset-0 bg-bg-muted"></div>
	{%- endif -%}

	<div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/30 to-transparent"></div>

	{%- if has_video -%}
		<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
			<span class="w-14 h-14 rounded-full bg-black/45 ring-1 ring-white/30 flex items-center justify-center transition-colors group-hover:bg-black/65">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
			</span>
		</div>
		<template data-ugc-modal-content>
			{%- render 'lazy-video',
				video: m_video,
				quality: 'full',
				mode: 'modal',
				class: 'w-full h-full object-contain bg-black'
			-%}
		</template>
	{%- endif -%}

	{%- if card_quote != blank or card_name != blank -%}
		<div class="absolute bottom-0 left-0 right-0 p-4 md:p-5">
			{%- if card_quote != blank -%}
				<p class="text-white text-sm md:text-base font-medium leading-snug">"{{ card_quote }}"</p>
			{%- endif -%}
			{%- if card_name != blank -%}
				<p class="text-white/70 text-xs mt-1">{{ card_name }}</p>
			{%- endif -%}
		</div>
	{%- endif -%}
</div>
{%- endif -%}
