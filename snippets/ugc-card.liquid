{%- comment -%}
	Snippet: ugc-card
	One UGC testimonial card for the gallery, sourced from a `ugc_testimonial`
	metaobject entry (the shared list, edited once in the admin and shown on
	every page).

	Params:
	  entry {Object}  the metaobject entry
{%- endcomment -%}

{%- liquid
	assign card_quote = entry.quote.value
	assign card_name  = entry.name.value
	assign m_image    = entry.image.value
	assign m_video    = entry.video.value
	assign has_video  = false
	assign has_image  = false
	if m_video != blank
		assign has_video = true
	endif
	if m_image != blank
		assign has_image = true
	endif
-%}

<div
	class="relative shrink-0 w-[65%] md:w-[22%] rounded-2xl overflow-hidden{% if has_video %} group cursor-pointer{% endif %}"
	style="aspect-ratio: 9 / 16;"
	{% if has_video %}data-ugc-card role="button" tabindex="0" aria-label="Play video"{% endif %}
>
	{%- if has_video -%}
		{%- comment -%}
			The tile renders at 260px wide on a phone and about a fifth of the
			row on desktop, so the smallest mp4 is plenty. The lightbox below
			gets the 720p rendition. Neither loads before it is needed.
		{%- endcomment -%}
		{%- render 'lazy-video',
			video: m_video,
			quality: 'card',
			class: 'absolute inset-0 w-full h-full object-cover'
		-%}
	{%- elsif has_image -%}
		{{ m_image | image_url: width: 600 | image_tag: loading: 'lazy', decoding: 'async', class: 'absolute inset-0 w-full h-full object-cover', widths: '300, 400, 600', draggable: 'false' }}
	{%- else -%}
		<div class="absolute inset-0 bg-bg-muted"></div>
	{%- endif -%}

	<div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/30 to-transparent"></div>

	{%- if has_video -%}
		<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
			<span class="w-14 h-14 rounded-full bg-black/45 ring-1 ring-white/30 flex items-center justify-center transition-colors group-hover:bg-black/65">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
			</span>
		</div>
		<template data-ugc-modal-content>
			{%- render 'lazy-video',
				video: m_video,
				quality: 'full',
				mode: 'modal',
				class: 'w-full h-full object-contain bg-black'
			-%}
		</template>
	{%- endif -%}

	{%- if card_quote != blank or card_name != blank -%}
		<div class="absolute bottom-0 left-0 right-0 p-4 md:p-5">
			{%- if card_quote != blank -%}
				<p class="text-white text-sm md:text-base font-medium leading-snug">"{{ card_quote }}"</p>
			{%- endif -%}
			{%- if card_name != blank -%}
				<p class="text-white/70 text-xs mt-1">{{ card_name }}</p>
			{%- endif -%}
		</div>
	{%- endif -%}
</div>
