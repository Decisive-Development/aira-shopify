{%- comment -%}
	Snippet: ugc-card
	One UGC testimonial card for the gallery, sourced from a `ugc_testimonial`
	metaobject entry (the shared list, edited once in the admin and shown on
	every page).

	Params:
	  entry    {Object}  the metaobject entry
	  card_dir {String}  optional. dir attribute for the card ('rtl' on Arabic
	                     pages, the track itself is ltr).
	  layout   {String}  optional. 'gallery' (default): a 9:16 tile with the
	                     quote over the frame. 'compact': a bare 3:4 tile, no caption, for the
	                     kit buy box (Tom, 2026-10-11: names and copy off).
{%- endcomment -%}

{%- liquid
	assign card_quote = entry.quote.value
	assign card_name  = entry.name.value
	assign m_image    = entry.image.value
	assign m_video    = entry.video.value
	assign has_video  = false
	assign has_image  = false
	if m_video != blank
		assign has_video = true
	endif
	if m_image != blank
		assign has_image = true
	endif
	assign card_layout = layout | default: 'gallery'
-%}

{%- if card_layout == 'compact' -%}
<div
	class="shrink-0 w-[38%] md:w-[30%]{% if has_video %} group cursor-pointer{% endif %}"{% if card_dir != blank %} dir="{{ card_dir }}"{% endif %}
	{% if has_video %}data-ugc-card role="button" tabindex="0" aria-label="{{ 'snippets.ugc_card.play_video' | t }}"{% endif %}
>
	<div class="relative rounded-2xl overflow-hidden bg-bg-muted" style="aspect-ratio: 3 / 4;">
		{%- if has_video -%}
			{%- render 'lazy-video',
				video: m_video,
				quality: 'card',
				class: 'absolute inset-0 w-full h-full object-cover'
			-%}
			<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
				<span class="w-10 h-10 rounded-full bg-black/45 ring-1 ring-white/30 flex items-center justify-center transition-colors group-hover:bg-black/65">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
				</span>
			</div>
			<template data-ugc-modal-content>
				{%- render 'lazy-video',
					video: m_video,
					quality: 'full',
					mode: 'modal',
					class: 'w-full h-full object-contain bg-black'
				-%}
			</template>
		{%- elsif has_image -%}
			{{ m_image | image_url: width: 400 | image_tag: loading: 'lazy', decoding: 'async', class: 'absolute inset-0 w-full h-full object-cover', widths: '200, 300, 400', draggable: 'false' }}
		{%- endif -%}
	</div>
</div>
{%- else -%}
<div
	class="relative shrink-0 w-[65%] md:w-[22%] rounded-2xl overflow-hidden{% if has_video %} group cursor-pointer{% endif %}"
	style="aspect-ratio: 9 / 16;"{% if card_dir != blank %} dir="{{ card_dir }}"{% endif %}
	{% if has_video %}data-ugc-card role="button" tabindex="0" aria-label="{{ 'snippets.ugc_card.play_video' | t }}"{% endif %}
>
	{%- if has_video -%}
		{%- comment -%}
			The tile renders at 260px wide on a phone and about a fifth of the
			row on desktop, so the smallest mp4 is plenty. The lightbox below
			gets the 720p rendition. Neither loads before it is needed.
		{%- endcomment -%}
		{%- render 'lazy-video',
			video: m_video,
			quality: 'card',
			class: 'absolute inset-0 w-full h-full object-cover'
		-%}
	{%- elsif has_image -%}
		{{ m_image | image_url: width: 600 | image_tag: loading: 'lazy', decoding: 'async', class: 'absolute inset-0 w-full h-full object-cover', widths: '300, 400, 600', draggable: 'false' }}
	{%- else -%}
		<div class="absolute inset-0 bg-bg-muted"></div>
	{%- endif -%}

	<div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/30 to-transparent"></div>

	{%- if has_video -%}
		<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
			<span class="w-14 h-14 rounded-full bg-black/45 ring-1 ring-white/30 flex items-center justify-center transition-colors group-hover:bg-black/65">
				<svg width="22" height="22" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
			</span>
		</div>
		<template data-ugc-modal-content>
			{%- render 'lazy-video',
				video: m_video,
				quality: 'full',
				mode: 'modal',
				class: 'w-full h-full object-contain bg-black'
			-%}
		</template>
	{%- endif -%}

	{%- if card_quote != blank or card_name != blank -%}
		<div class="absolute bottom-0 left-0 right-0 p-4 md:p-5">
			{%- if card_quote != blank -%}
				<p class="text-white text-sm md:text-base font-medium leading-snug">"{{ card_quote }}"</p>
			{%- endif -%}
			{%- if card_name != blank -%}
				<p class="text-white/70 text-xs mt-1">{{ card_name }}</p>
			{%- endif -%}
		</div>
	{%- endif -%}
</div>
{%- endif -%}
