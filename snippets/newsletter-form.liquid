{%- comment -%}
	Newsletter form — the one email-capture form in the theme.

	Wraps Shopify's `customer` form (which is what creates the subscriber that
	Klaviyo syncs server-side). Used by the footer and by both popups;
	do not hand-roll another one.

	Parameters:
	  form_id        {String}  unique id for the form                    (required)
	  tags           {String}  comma list for contact[tags]              (default: 'newsletter')
	  heading        {String}  optional heading rendered above the field
	  heading_classes {String} classes on that heading  (default: the footer's)
	  body_html      {String}  optional supporting copy (may contain markup)
	  intro_on_success {Boolean} keep heading/body_html above the success block
	                             (default: true; false drops them once posted)
	  placeholder    {String}  email input placeholder                   (default: 'Your email')
	  button_label   {String}  submit label                              (default: 'Subscribe')
	  button_variant {String}  cta-button variant for the submit         (default: 'solid')
	  layout         {String}  'inline' (footer) | 'stacked' (popup)     (default: 'inline')
	  surface        {String}  'light' | 'dark' — passed to cta-button   (default: 'light')
	  fields_html    {String}  optional extra markup between the email field and
	                           the submit (the offer popup's client-side error line)
	  show_states    {Boolean} render success/error blocks               (default: false)
	  success_text   {String}  copy for the success block
	  success_heading {String} optional Satoshi line above success_text
	  success_html   {String}  optional markup rendered after success_text inside
	                           the success block (the offer popup's step 3)
	  success_icon   {Boolean} teal check circle above the success block (default: false)
	  success_classes {String} extra classes on the success block (e.g. 'text-center')
	  offer_code     {String}  discount code this signup earns. Rendered ONLY on
	                           the success block, as data-offer-code, so it never
	                           sits in the page source before a post succeeds.
	                           snippets/signup-offer.liquid reads it on the
	                           redirect and applies it to the checkout.
	  offer_days     {Number}  how long the popup stays away after this signup
	                           (data-offer-days, default 30)
	  attributes     {String}  raw extra attributes for the email <input>

	NOTE on `show_states`: `posted_successfully?` and `form.errors` are
	page-global — every `{% form 'customer' %}` on the page reports them after
	any customer form posts. The per-form signal is the redirect anchor
	(`#<form_id>`), which the popup and footer section scripts read to decide
	which form owns the state. Success blocks therefore render in BOTH opted-in
	forms by design (both messages are true; the non-target one is hidden or
	below the fold) — never remove one in JS, there is no form behind it to
	restore. A stray error block in the non-posting form IS removed by the
	section scripts, via [data-newsletter-error].

	Submission is a native full-page POST, never fetch: Shopify injects an
	invisible captcha into the customer form and may route the post through
	/challenge. The redirect comes back as ?customer_posted=true#<form_id>.
{%- endcomment -%}

{%- liquid
	assign nf_tags        = tags         | default: 'newsletter'
	assign nf_placeholder = placeholder  | default: 'Your email'
	assign nf_label       = button_label | default: 'Subscribe'
	assign nf_layout      = layout       | default: 'inline'
	assign nf_surface     = surface      | default: 'light'
	assign nf_variant     = button_variant | default: 'solid'
	assign nf_heading_classes = heading_classes | default: 'text-base font-semibold mb-2 text-main'
	assign nf_offer_days  = offer_days | default: 30

	if nf_layout == 'stacked'
		assign nf_wrap_classes  = 'flex flex-col gap-3'
		assign nf_input_classes = 'w-full'
		assign nf_btn_classes   = 'w-full text-center'
	else
		assign nf_wrap_classes  = 'flex flex-col sm:flex-row gap-2'
		assign nf_input_classes = 'w-full sm:w-70'
		assign nf_btn_classes   = 'shrink-0 w-full sm:w-auto text-center'
	endif
-%}

{%- form 'customer', id: form_id, class: 'newsletter-form' -%}
	{%- liquid
		# `form` only exists inside this tag, so the success test has to live here.
		# The intro sits above the success block by default, which is what the
		# footer wants. Pass intro_on_success: false where the intro is a question
		# the success state has already answered.
		assign nf_show_intro = true
		if show_states and form.posted_successfully? and intro_on_success == false
			assign nf_show_intro = false
		endif
	-%}

	<input type="hidden" name="contact[tags]" value="{{ nf_tags }}">

	{%- if nf_show_intro -%}
		{%- if heading != blank -%}
			<p class="{{ nf_heading_classes }}">{{ heading }}</p>
		{%- endif -%}

		{%- if body_html != blank -%}
			<p class="text-base text-main mb-3" style="max-width: 40ch;">{{ body_html }}</p>
		{%- endif -%}
	{%- endif -%}

	{%- if show_states and form.posted_successfully? -%}
		{%- comment -%}
			data-modal-autofocus: inside a dialog this is what assets/aira-modal.js
			focuses on open. role="status" alone will not announce content that was
			already in the DOM at load, and there is no field left to focus instead.
		{%- endcomment -%}
		{%- comment -%}
			focus:outline-none is safe here and only here: tabindex="-1" keeps this
			out of the tab order, so no keyboard user can land on it and need a
			focus ring. Without it the programmatic focus paints a heavy box.
		{%- endcomment -%}
		<div
			class="rounded-xl bg-bg p-5 text-sm text-copy focus:outline-none {{ success_classes }}"
			data-newsletter-success
			data-modal-autofocus
			role="status"
			tabindex="-1"
			{% if offer_code != blank %}data-offer-code="{{ offer_code | strip | escape }}" data-offer-days="{{ nf_offer_days }}"{% endif %}
		>
			{%- if success_icon -%}
				<span class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-teal/12 text-teal" aria-hidden="true">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="m5 13 4 4L19 7"/>
					</svg>
				</span>
			{%- endif -%}
			{%- if success_heading != blank -%}
				<p class="font-heading font-bold text-2xl leading-tight text-main mb-2">{{ success_heading }}</p>
			{%- endif -%}
			{%- if success_text != blank -%}
				{{ success_text }}
			{%- elsif success_html == blank -%}
				{{ 'snippets.newsletter_form.success_default' | t }}
			{%- endif -%}
			{{ success_html }}
		</div>
	{%- else -%}

		{%- if show_states and form.errors -%}
			<div class="rounded-xl bg-highlight/10 p-5 text-sm text-highlight mb-3" data-newsletter-error role="alert">
				{{ form.errors | default_errors }}
			</div>
		{%- endif -%}

		<div class="{{ nf_wrap_classes }}">
			<label class="sr-only" for="{{ form_id }}-email">{{ nf_placeholder }}</label>
			<input
				id="{{ form_id }}-email"
				type="email"
				inputmode="email"
				name="contact[email]"
				placeholder="{{ nf_placeholder }}"
				autocomplete="email"
				required
				class="{{ nf_input_classes }} rounded-xl px-4 py-3 text-sm text-main bg-white border border-main focus:outline-2 focus:outline-offset-2 focus:outline-highlight"
				{{ attributes }}
			>
			{{ fields_html }}
			{%- render 'cta-button',
				label: nf_label,
				element: 'button',
				button_type: 'submit',
				variant: nf_variant,
				surface: nf_surface,
				extra_classes: nf_btn_classes
			-%}
		</div>
	{%- endif -%}
{%- endform -%}
