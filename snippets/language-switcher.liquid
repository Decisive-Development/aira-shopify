{%- comment -%}
  Language switcher: English | العربية (each language's own name) as plain
  submit buttons, no JS. The current language is orange and bold. The form
  posts to /localization and Shopify redirects to the localised path.
  localization.available_languages lists PUBLISHED languages only, so this
  renders nothing until a second language is published.

  Dev-only preview: on a theme whose role is not "main" (development or
  unpublished copies) the switcher also renders with a sample Arabic entry,
  hidden, and the dev flags script in layout/theme.liquid reveals it on
  ?switcher=1 (sticky for the browser session, ?switcher=0 clears it) so it
  can be checked before a second language exists. The live theme never
  renders the preview.

  Params:
    id          unique form id per render (header-dark-desktop, header-light-desktop, header-mobile)
    text_class  the header variant's text colour utility (text-white / text-main)
    form_class  layout utilities for the form (desktop renders hide below md)

  Every form carries data-language-switcher: the header rows tighten their
  tablet spacing while one is visible (assets/critical.source.css).
{%- endcomment -%}
{%- liquid
  assign show_switcher = false
  if localization.available_languages.size > 1
    assign show_switcher = true
  endif
  assign preview = false
  if show_switcher == false and theme.role != 'main'
    assign preview = true
  endif
-%}
{%- if show_switcher or preview -%}
  {%- capture switcher_items -%}
    {%- for language in localization.available_languages -%}
      {%- assign is_current = false -%}
      {%- if language.iso_code == localization.language.iso_code -%}{%- assign is_current = true -%}{%- endif -%}
      <button
        type="submit"
        name="locale_code"
        value="{{ language.iso_code }}"
        lang="{{ language.iso_code }}"
        {% if is_current %}aria-current="true"{% endif %}
        class="text-sm cursor-pointer transition-opacity hover:opacity-60 {% if is_current %}font-bold text-highlight{% else %}{{ text_class }}{% endif %}"
      >
        {{- language.endonym_name -}}
      </button>
      {%- unless forloop.last -%}<span aria-hidden="true" class="text-sm {{ text_class }}">|</span>{%- endunless -%}
    {%- endfor -%}
    {%- if preview -%}
      {%- assign ar_current = false -%}
      {%- if localization.language.iso_code == 'ar' -%}{%- assign ar_current = true -%}{%- endif -%}
      <span aria-hidden="true" class="text-sm {{ text_class }}">|</span>
      <button type="submit" name="locale_code" value="ar" lang="ar" {% if ar_current %}aria-current="true" {% endif %}class="text-sm cursor-pointer transition-opacity hover:opacity-60 {% if ar_current %}font-bold text-highlight{% else %}{{ text_class }}{% endif %}">العربية</button>
    {%- endif -%}
  {%- endcapture -%}
  {%- if preview -%}
    {%- form 'localization', id: id, class: form_class, hidden: 'hidden', data-switcher-preview: 'true', data-language-switcher: 'true' -%}{{ switcher_items }}{%- endform -%}
  {%- else -%}
    {%- form 'localization', id: id, class: form_class, data-language-switcher: 'true' -%}{{ switcher_items }}{%- endform -%}
  {%- endif -%}
{%- endif -%}
