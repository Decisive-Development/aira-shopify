{% style %}
  {% # Self-hosted brand fonts. asset_url gives the versioned URL the preloads in layout/theme.liquid use, so each font is one request; a relative url() would break once the stylesheet is inlined. The Latin faces' unicode-range covers every character Satoshi and Nunito Sans contain and stops short of every Arabic block, so English keeps every glyph and Arabic falls through to Almarai. %}
  @font-face {
    font-family: "Satoshi";
    src: url("{{ 'satoshi-variable.woff2' | asset_url }}") format("woff2 supports variations"),
         url("{{ 'satoshi-variable.woff2' | asset_url }}") format("woff2");
    font-weight: 300 900;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-03FF, U+1E00-1EFF, U+2000-22FF, U+25A0-27BF, U+F8FF, U+FB00-FB06;
  }
  @font-face {
    font-family: "Nunito Sans";
    src: url("{{ 'nunito-sans-variable.woff2' | asset_url }}") format("woff2 supports variations"),
         url("{{ 'nunito-sans-variable.woff2' | asset_url }}") format("woff2");
    font-weight: 200 1000;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-03FF, U+1E00-1EFF, U+2000-22FF, U+25A0-27BF, U+F8FF, U+FB00-FB06;
  }
  {% # Arabic face: Almarai (SIL Open Font License, licenses/Almarai-OFL.txt), Regular and Bold subset to the Arabic blocks. Its unicode-range keeps it unfetched until an Arabic character renders. 100-500 render Regular, 600-900 render Bold, so no weight is synthesised. %}
  @font-face {
    font-family: "Almarai";
    src: url("{{ 'almarai-400.woff2' | asset_url }}") format("woff2");
    font-weight: 100 500;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+FB50-FDFF, U+FE70-FEFF;
  }
  @font-face {
    font-family: "Almarai";
    src: url("{{ 'almarai-700.woff2' | asset_url }}") format("woff2");
    font-weight: 600 900;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+FB50-FDFF, U+FE70-FEFF;
  }

  :root {
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    /* Semantic aliases (used in inline styles) */
    --color-primary: {{ settings.color_primary }};
    --color-secondary: {{ settings.color_secondary }};
    --color-accent: {{ settings.color_accent }};
    --color-text: {{ settings.color_text }};
    --color-text-inverse: {{ settings.color_text_inverse }};
    --color-background: {{ settings.background_color }};

    /* Override Tailwind theme tokens so utility classes (bg-main, bg-highlight, etc.) follow the admin Brand colours */
    --color-main: {{ settings.color_primary }};
    --color-secondary: {{ settings.color_secondary }};
    --color-highlight: {{ settings.color_accent }};
    --color-bg: {{ settings.background_color }};

    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
{% endstyle %}
