{%- comment -%}
  icon-tick — the canonical checklist tick. Thick green stroke, colour from
  the highlight-green token, size via `classes`. Output stays on one line so
  the snippet can render inside a <template> for JS cloning.
  Params:
    classes — sizing/layout classes. Default 'w-4 h-4 shrink-0 mt-0.5'.
{%- endcomment -%}
{%- assign tick_classes = classes | default: 'w-4 h-4 shrink-0 mt-0.5' -%}
<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-highlight-green {{ tick_classes }}" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
