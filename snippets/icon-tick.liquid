{%- comment -%}
  icon-tick — the canonical checklist tick. Default: thick green stroke,
  colour from the highlight-green token. Variant 'circle': a filled navy disc
  with a white tick (the kit buy box). Size via `classes`. Output stays on
  one line so the snippet can render inside a <template> for JS cloning.
  Params:
    classes — sizing/layout classes. Default 'w-4 h-4 shrink-0 mt-0.5'.
    variant — optional. 'circle' for the filled disc.
{%- endcomment -%}
{%- assign tick_classes = classes | default: 'w-4 h-4 shrink-0 mt-0.5' -%}
{%- if variant == 'circle' -%}
<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" class="text-main {{ tick_classes }}" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="currentColor"/><path d="M17 8.5 10.3 15.2 7 11.9" stroke="var(--color-bg)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- else -%}
<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-highlight-green {{ tick_classes }}" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
{%- endif -%}
