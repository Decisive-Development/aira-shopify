		font-variant-numeric: tabular-nums;
	}

	/* ---------- fallback (no JS) ---------- */
	.research-book .rb-fallback {
		max-width: 640px; margin: 0 auto; padding: 96px 24px;
		color: var(--rb-cream);
	}
	.research-book .rb-fallback h1, .research-book .rb-fallback h2 { font-family: var(--font-heading); font-weight: 500; margin: 1.5em 0 0.4em; }
	.research-book .rb-fallback ol { list-style: none; padding: 0; }
	.research-book .rb-fallback p { margin: 0.4em 0; line-height: 1.6; }
	.research-book .rb-fallback-cite { font-size: 12px; opacity: 0.65; }

	@media (max-width: 640px) {
		.research-book { --rb-ph: min(72vh, 620px); }
		.research-book .rb-pagelabel { display: none; }
	}

	@media (prefers-reduced-motion: reduce) {
		.research-book .rb-sheet { transition: transform 0.01s linear; }
		.research-book .rb-stack { transition: none; }
	}
