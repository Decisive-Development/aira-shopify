<script>
	(function () {
		function initResearchBook(root) {
			if (root.dataset.rbInit) return;
			root.dataset.rbInit = '1';

			var book = root.querySelector('[data-rb-book]');
			var sheets = Array.prototype.slice.call(book.querySelectorAll('.rb-sheet'));
			var n = sheets.length;
			var ticksWrap = root.querySelector('[data-rb-ticks]');
			var pagelabel = root.querySelector('[data-rb-pagelabel]');
			var prevBtn = root.querySelector('[data-rb-prev]');
			var nextBtn = root.querySelector('[data-rb-next]');
			var stackL = root.querySelector('[data-rb-stack-l]');
			var stackR = root.querySelector('[data-rb-stack-r]');
			var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			var STORE_KEY = 'aira-research-page';

			function readStore() {
				try { return localStorage.getItem(STORE_KEY); } catch (e) { return null; }
			}
			function writeStore(v) {
				try { localStorage.setItem(STORE_KEY, v); } catch (e) { /* private mode */ }
			}

			/* cur = index of the page currently face-up on the right stack */
			var cur = parseInt(readStore() || '0', 10);
			if (isNaN(cur) || cur < 0 || cur >= n) cur = 0;

			sheets.forEach(function (s, i) {
				var b = document.createElement('button');
				b.type = 'button';
				b.setAttribute('aria-label', s.dataset.rbTitle);
				b.addEventListener('click', function () { go(i); });
				ticksWrap.appendChild(b);
			});
			var ticks = Array.prototype.slice.call(ticksWrap.children);

			var boostTimer = null;
			var lastCounted = -1;

			function render(boostIdx) {
				sheets.forEach(function (s, i) {
					var turned = i < cur;
					s.style.transform = turned ? 'rotateY(-180deg)' : 'rotateY(0deg)';
					s.style.zIndex = (boostIdx === i) ? String(2 * n + 2) : (turned ? String(i + 1) : String(n - i));
					if (i === cur) s.setAttribute('data-active', ''); else s.removeAttribute('data-active');
				});
				ticks.forEach(function (t, i) { t.setAttribute('aria-current', i === cur ? 'true' : 'false'); });
				/* Cover and Contents carry the same label and title, so show one. */
				var pLabel = sheets[cur].dataset.rbLabel || '';
				var pTitle = sheets[cur].dataset.rbTitle || '';
				pagelabel.textContent = (pLabel.toLowerCase() === pTitle.toLowerCase())
					? pTitle
					: pLabel + '  ·  ' + pTitle;
				prevBtn.disabled = cur === 0;
				nextBtn.disabled = cur === n - 1;
				if (cur === n - 1) book.setAttribute('data-rb-last', ''); else book.removeAttribute('data-rb-last');
				/* stacks thin out / grow */
				stackR.style.transform = 'scaleX(' + Math.max(0.15, (n - cur) / n) + ')';
				stackL.style.transform = 'scaleX(' + Math.max(0.001, cur / n) + ')';
				writeStore(String(cur));
				countUps(sheets[cur]);
			}

			function go(i) {
				i = Math.max(0, Math.min(n - 1, i));
				if (i === cur) return;
				var moving = i > cur ? cur : i; /* the sheet that visually turns */
				cur = i;
				if (boostTimer) clearTimeout(boostTimer);
				render(moving);
				boostTimer = setTimeout(function () { render(); }, 1050);
			}
			function next() { go(cur + 1); }
			function prev() { go(cur - 1); }

			/* Count-ups. The stat string carries its own format: "2.4x" ->
			   target 2.4, one decimal, suffix "x". Runs once per arrival
			   (render fires again after the z-boost clears; don't restart). */
			function countUps(sheet) {
				if (lastCounted === cur) return;
				lastCounted = cur;
				sheet.querySelectorAll('.rb-count[data-rb-count]').forEach(function (el) {
					var m = /^(\d+(?:\.(\d+))?)(.*)$/.exec(el.dataset.rbCount);
					if (!m) return;
					var target = parseFloat(m[1]);
					var dec = m[2] ? m[2].length : 0;
					var suf = m[3] || '';
					if (reduce) { el.textContent = target.toFixed(dec) + suf; return; }
					var dur = 1100, t0 = performance.now();
					function tick(now) {
						var t = Math.min(1, (now - t0) / dur);
						var e = 1 - Math.pow(1 - t, 3);
						el.textContent = (target * e).toFixed(dec) + suf;
						if (t < 1) requestAnimationFrame(tick);
					}
					requestAnimationFrame(tick);
				});
			}

			prevBtn.addEventListener('click', prev);
			nextBtn.addEventListener('click', next);
			root.querySelectorAll('[data-rb-goto]').forEach(function (b) {
				b.addEventListener('click', function (e) { e.stopPropagation(); go(parseInt(b.dataset.rbGoto, 10)); });
			});

			/* click page: right side next, left side prev */
			var justDragged = 0;
			book.addEventListener('click', function (e) {
				if (Date.now() - justDragged < 300) return;
				if (e.target.closest('button, a')) return;
				var r = book.getBoundingClientRect();
				var x = (e.clientX - r.left) / r.width;
				if (x > 0.5) next(); else prev();
			});

			/* Arrow keys only: the page scrolls normally, so Space, PageUp,
			   PageDown, Home and End must keep their scrolling jobs. Ignore
			   keys while the book is off screen. */
			window.addEventListener('keydown', function (e) {
				if (!document.contains(book)) return;
				if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
				if (e.target && /input|textarea|select/i.test(e.target.tagName)) return;
				var r = book.getBoundingClientRect();
				if (r.bottom < 0 || r.top > window.innerHeight) return;
				e.preventDefault();
				if (e.key === 'ArrowRight') next(); else prev();
			});

			/* drag: live page bend, then commit past the threshold or spring back */
			var dragging = false, sx = 0, dx = 0, dragSheet = null, dragDir = 0;
			book.addEventListener('pointerdown', function (e) {
				if (e.target.closest('button, a')) return;
				dragging = true; sx = e.clientX; dx = 0; dragSheet = null; dragDir = 0;
				book.setPointerCapture(e.pointerId);
			});
			book.addEventListener('pointermove', function (e) {
				if (!dragging) return;
				dx = e.clientX - sx;
				if (!dragSheet && Math.abs(dx) > 6) {
					if (dx < 0 && cur < n - 1) { dragDir = 1; dragSheet = sheets[cur]; }
					else if (dx > 0 && cur > 0) { dragDir = -1; dragSheet = sheets[cur - 1]; }
					if (dragSheet) {
						dragSheet.classList.add('rb-no-anim');
						dragSheet.style.zIndex = String(2 * n + 2);
					}
				}
				if (!dragSheet) return;
				var deg;
				if (dragDir === 1) deg = Math.max(-180, Math.min(0, dx * 0.45));
				else deg = Math.max(-180, Math.min(0, -180 + dx * 0.45));
				dragSheet.style.transform = 'rotateY(' + deg + 'deg)';
			});
			function endDrag() {
				if (!dragging) return;
				dragging = false;
				if (!dragSheet) return;
				if (Math.abs(dx) > 8) justDragged = Date.now();
				dragSheet.classList.remove('rb-no-anim');
				var commit;
				if (dragDir === 1) commit = dx * 0.45 < -38;
				else commit = (-180 + dx * 0.45) > -142;
				if (commit) { if (dragDir === 1) next(); else prev(); }
				else {
					dragSheet.style.transform = dragDir === 1 ? 'rotateY(0deg)' : 'rotateY(-180deg)';
					setTimeout(function () { render(); }, 1050);
				}
				dragSheet = null;
			}
			book.addEventListener('pointerup', endDrag);
			book.addEventListener('pointercancel', endDrag);

			/* init: place sheets without animating the restored position */
			sheets.forEach(function (s) { s.classList.add('rb-no-anim'); });
			render();
			requestAnimationFrame(function () {
				requestAnimationFrame(function () {
					sheets.forEach(function (s) { s.classList.remove('rb-no-anim'); });
				});
			});
		}

		document.querySelectorAll('[data-research-book]').forEach(initResearchBook);
		document.addEventListener('shopify:section:load', function (e) {
			var root = e.target.querySelector('[data-research-book]');
			if (root) initResearchBook(root);
		});
	})();
</script>

