{%- comment -%}
	Research book — the /pages/backed-by-science page as a bound book.

	Reference: design_handoff_science/designs/Backed by Science.html.
	A viewport-tall desk scene in normal page flow (site header and footer
	stay). Sheets: cover, contents (auto-built from blocks), one sheet per
	study block, closing. Pages turn in 3D around the spine; drag bends the
	active sheet; pager, arrow keys, and contents rows all navigate.
	Current page persists in localStorage.

	All copy is schema-driven. Figures are deliberately schematic (the
	studies' licensed figures are not ours to reproduce): pick a shape per
	study block, label it from settings.
{%- endcomment -%}

{%- liquid
	assign studies = section.blocks | where: 'type', 'study'
	assign study_count = studies.size
	assign study_total = study_count | prepend: '0' | slice: -2, 2
-%}

<section
	class="research-book"
	data-research-book
	data-screen-label="00 Research book"
>
	<div class="rb-scene">
		<div class="rb-shift">
			<div class="rb-bookwrap" data-rb-book>
				<div class="rb-stack rb-stack--right" data-rb-stack-r></div>
				<div class="rb-stack rb-stack--left" data-rb-stack-l></div>
				<p class="rb-hint">{{ section.settings.hint_text }}</p>

				{%- comment -%} Cover {%- endcomment -%}
				<div class="rb-sheet" data-rb-title="{{ section.settings.cover_pager_title | escape }}" data-rb-label="Cover">
					<div class="rb-face rb-face--front rb-cover">
						<div class="rb-cover-in">
							<img
								class="rb-cover-logo"
								src="{{ 'aira-logo-text-blue.svg' | asset_url }}"
								alt="aira"
								width="560"
								height="144"
								loading="eager"
							>
							<div class="rb-cover-heads">
								<h1 class="rb-cover-title">
									{{- section.settings.cover_title_line -}}
									{%- if section.settings.cover_title_accent != blank -%}
										<br><em>{{ section.settings.cover_title_accent }}</em>
									{%- endif -%}
								</h1>
								{%- if section.settings.cover_subtitle != blank -%}
									<p class="rb-cover-sub">{{ section.settings.cover_subtitle }}</p>
								{%- endif -%}
							</div>
							<div class="rb-cover-meta">
								<span class="rb-cover-rule" aria-hidden="true"></span>
								{%- if section.settings.cover_meta_1 != blank -%}<p>{{ section.settings.cover_meta_1 }}</p>{%- endif -%}
								{%- if section.settings.cover_meta_2 != blank -%}<p>{{ section.settings.cover_meta_2 }}</p>{%- endif -%}
							</div>
						</div>
					</div>
					<div class="rb-face rb-face--back rb-paper">
						<div class="rb-backghost" aria-hidden="true">&#10733;</div>
						<div class="rb-backfoot">{{ section.settings.back_foot }}</div>
					</div>
				</div>

				{%- comment -%} Contents — rows build from the study blocks {%- endcomment -%}
				<div class="rb-sheet" data-rb-title="{{ section.settings.toc_pager_title | escape }}" data-rb-label="Contents">
					<div class="rb-face rb-face--front rb-paper">
						<div class="rb-pg rb-toc">
							<div class="rb-pg-head">
								<span class="rb-pg-no">{{ section.settings.toc_kicker }}</span>
								<span class="rb-pg-field">{{ section.settings.toc_field }}</span>
							</div>
							<h2 class="rb-pg-title">{{ section.settings.toc_heading }}</h2>
							<ol class="rb-toc-list">
								{%- for block in studies -%}
									<li>
										<button type="button" data-rb-goto="{{ forloop.index | plus: 1 }}">
											<span class="rb-toc-no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
											<span class="rb-toc-title">{{ block.settings.toc_title }}</span>
											<span class="rb-toc-year">{{ block.settings.toc_year }}</span>
										</button>
									</li>
								{%- endfor -%}
							</ol>
							{%- if section.settings.toc_note != blank -%}
								<p class="rb-toc-foot">{{ section.settings.toc_note }}</p>
							{%- endif -%}
						</div>
					</div>
					<div class="rb-face rb-face--back rb-paper">
						<div class="rb-backghost" aria-hidden="true">01</div>
						<div class="rb-backfoot">{{ section.settings.back_foot }}</div>
					</div>
				</div>

				{%- comment -%} One sheet per study {%- endcomment -%}
				{%- for block in studies -%}
					{%- liquid
						assign study_no = forloop.index | prepend: '0' | slice: -2, 2
						if forloop.last
							assign ghost = '&#10733;'
						else
							assign next_no = forloop.index | plus: 1 | prepend: '0' | slice: -2, 2
							assign ghost = next_no
						endif
						assign pager_label = 'Study ' | append: study_no | append: ' of ' | append: study_total
					-%}
					<div
						class="rb-sheet"
						data-rb-title="{{ block.settings.pager_title | escape }}"
						data-rb-label="{{ pager_label | escape }}"
						{{ block.shopify_attributes }}
					>
						<div class="rb-face rb-face--front rb-paper">
							<div class="rb-pg">
								<div class="rb-pg-head">
									<span class="rb-pg-no">Study {{ study_no }}</span>
									<span class="rb-pg-field">{{ block.settings.field }}</span>
								</div>
								<h2 class="rb-pg-title">{{ block.settings.headline }}</h2>
								<p class="rb-lead">
									{{- block.settings.lead_before -}}
									{%- if block.settings.stat != blank -%}
										<span class="rb-hl"><span class="rb-count" data-rb-count="{{ block.settings.stat | escape }}">{{ block.settings.stat }}</span></span>
									{%- endif -%}
									{{- block.settings.lead_after -}}
								</p>

								<div class="rb-figwrap">
									{%- case block.settings.figure -%}
										{%- when 'table' -%}
											<table class="rb-figtable">
												<thead>
													<tr>
														<th scope="col">{{ block.settings.table_head_a }}</th>
														<th scope="col">{{ block.settings.table_head_b }}</th>
													</tr>
												</thead>
												<tbody>
													<tr><td>{{ block.settings.table_r1a }}</td><td><b>{{ block.settings.table_r1b }}</b></td></tr>
													<tr><td>{{ block.settings.table_r2a }}</td><td>{{ block.settings.table_r2b }}</td></tr>
												</tbody>
											</table>
										{%- when 'bars-rise' -%}
											<svg viewBox="0 0 340 190" fill="none" aria-hidden="true" class="rb-fig">
												<line x1="60" y1="160" x2="280" y2="160" class="rb-fig-axis"/>
												<line x1="60" y1="160" x2="60" y2="26" class="rb-fig-axis"/>
												<rect x="98" y="106" width="52" height="54" rx="3" class="rb-fig-comp"/>
												<rect x="198" y="30" width="52" height="130" rx="3" class="rb-fig-data"/>
												<text x="224" y="20" text-anchor="middle" class="rb-fig-note">{{ block.settings.fig_note }}</text>
												<g class="rb-fig-xlab">
													<text x="124" y="178" text-anchor="middle">{{ block.settings.fig_label_a }}</text>
													<text x="224" y="178" text-anchor="middle">{{ block.settings.fig_label_b }}</text>
												</g>
												<text x="20" y="158" transform="rotate(-90 20 158)" class="rb-fig-ylab">{{ block.settings.fig_axis }}</text>
											</svg>
										{%- when 'bars-fall' -%}
											<svg viewBox="0 0 340 190" fill="none" aria-hidden="true" class="rb-fig">
												<line x1="60" y1="160" x2="280" y2="160" class="rb-fig-axis"/>
												<line x1="60" y1="160" x2="60" y2="26" class="rb-fig-axis"/>
												<rect x="98" y="44" width="52" height="116" rx="3" class="rb-fig-comp"/>
												<rect x="198" y="98" width="52" height="62" rx="3" class="rb-fig-data"/>
												<line x1="150" y1="44" x2="292" y2="44" class="rb-fig-ref"/>
												<text x="224" y="88" text-anchor="middle" class="rb-fig-note rb-fig-note--sm">{{ block.settings.fig_note }}</text>
												<g class="rb-fig-xlab">
													<text x="124" y="178" text-anchor="middle">{{ block.settings.fig_label_a }}</text>
													<text x="224" y="178" text-anchor="middle">{{ block.settings.fig_label_b }}</text>
												</g>
												<text x="20" y="158" transform="rotate(-90 20 158)" class="rb-fig-ylab">{{ block.settings.fig_axis }}</text>
											</svg>
										{%- when 'line' -%}
											<svg viewBox="0 0 340 190" fill="none" aria-hidden="true" class="rb-fig">
												<line x1="46" y1="160" x2="300" y2="160" class="rb-fig-axis"/>
												<line x1="46" y1="160" x2="46" y2="28" class="rb-fig-axis"/>
												<path d="M58 138 C 110 132, 150 118, 196 86 C 232 62, 262 50, 288 44" class="rb-fig-line"/>
												<circle cx="288" cy="44" r="5" class="rb-fig-dot"/>
												<g class="rb-fig-xlab">
													<text x="58" y="178">{{ block.settings.fig_label_a }}</text>
													<text x="288" y="178" text-anchor="end">{{ block.settings.fig_label_b }}</text>
												</g>
												<text x="20" y="34" transform="rotate(-90 20 34)" text-anchor="end" class="rb-fig-ylab">{{ block.settings.fig_axis }}</text>
											</svg>
										{%- when 'proportion' -%}
											{%- liquid
												assign bar_a = 268.0 | times: block.settings.fig_value_a | divided_by: 100.0 | round
												assign bar_b = 268.0 | times: block.settings.fig_value_b | divided_by: 100.0 | round
												assign note_a_x = bar_a | plus: 45
												assign note_b_x = bar_b | plus: 45
											-%}
											<svg viewBox="0 0 340 190" fill="none" aria-hidden="true" class="rb-fig">
												<g class="rb-fig-rowlab">
													<text x="36" y="52">{{ block.settings.fig_label_a }}</text>
													<text x="36" y="120">{{ block.settings.fig_label_b }}</text>
												</g>
												<rect x="36" y="60" width="268" height="14" rx="7" class="rb-fig-track"/>
												<rect x="36" y="60" width="{{ bar_a }}" height="14" rx="7" class="rb-fig-data"/>
												<text x="{{ note_a_x }}" y="72" class="rb-fig-note rb-fig-note--sm">{{ block.settings.fig_note }}</text>
												<rect x="36" y="128" width="268" height="14" rx="7" class="rb-fig-track"/>
												<rect x="36" y="128" width="{{ bar_b }}" height="14" rx="7" class="rb-fig-comp rb-fig-comp--solid"/>
												<text x="{{ note_b_x }}" y="140" class="rb-fig-note rb-fig-note--ink">{{ block.settings.fig_note_b }}</text>
											</svg>
									{%- endcase -%}
									{%- if block.settings.fig_caption != blank -%}
										<p class="rb-figcap"><b>{{ block.settings.fig_caption_label }}</b>&nbsp; {{ block.settings.fig_caption }}</p>
									{%- endif -%}
								</div>

								<p class="rb-cite">
									{%- if block.settings.citation_url != blank -%}
										<a href="{{ block.settings.citation_url }}" title="{{ block.settings.citation | escape }}" target="_blank" rel="noopener noreferrer">{{ block.settings.citation }}</a>
									{%- else -%}
										{{- block.settings.citation -}}
									{%- endif -%}
								</p>
							</div>
						</div>
						<div class="rb-face rb-face--back rb-paper">
							<div class="rb-backghost" aria-hidden="true">{{ ghost }}</div>
							<div class="rb-backfoot">{{ section.settings.back_foot }}</div>
						</div>
					</div>
				{%- endfor -%}

				{%- comment -%} Closing {%- endcomment -%}
				<div class="rb-sheet" data-rb-title="{{ section.settings.closing_pager_title | escape }}" data-rb-label="Closing note">
					<div class="rb-face rb-face--front rb-paper">
						<div class="rb-pg rb-closing">
							<div class="rb-pg-head">
								<span class="rb-pg-no">{{ section.settings.closing_kicker }}</span>
								<span class="rb-pg-field">{{ section.settings.closing_field }}</span>
							</div>
							<h2 class="rb-pg-title">{{ section.settings.closing_headline }}</h2>
							<p class="rb-lead">{{ section.settings.closing_lead }}</p>
							<div class="rb-closing-mid">
								{%- render 'cta-button',
									label: section.settings.cta_label,
									url: section.settings.cta_url,
									variant: 'shop'
								-%}
								{%- if section.settings.ship_line != blank -%}
									<p class="rb-ship">{{ section.settings.ship_line }}</p>
								{%- endif -%}
							</div>
							<p class="rb-smallprint">{{ section.settings.small_print }}</p>
						</div>
					</div>
					<div class="rb-face rb-face--back rb-paper">
						<div class="rb-backghost" aria-hidden="true">&#10733;</div>
						<div class="rb-backfoot">{{ section.settings.back_foot }}</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<nav class="rb-pager" aria-label="Pages">
		<button type="button" class="rb-arrow" data-rb-prev aria-label="Previous page">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
		</button>
		<div class="rb-ticks" data-rb-ticks></div>
		<span class="rb-pagelabel" data-rb-pagelabel></span>
		<button type="button" class="rb-arrow" data-rb-next aria-label="Next page">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
		</button>
	</nav>

	{%- comment -%}
		Without JS the book cannot turn, so ship the whole thing as a plain
		readable list instead. The noscript style hides the scene and pager
		and lets the section scroll normally.
	{%- endcomment -%}
	<noscript>
		<style>
			.research-book .rb-scene, .research-book .rb-pager { display: none; }
		</style>
		<div class="rb-fallback">
			<h1>{{ section.settings.cover_title_line }} {{ section.settings.cover_title_accent }}</h1>
			<p>{{ section.settings.cover_meta_1 }} {{ section.settings.cover_meta_2 }}</p>
			<ol>
				{%- for block in studies -%}
					<li>
						<h2>{{ block.settings.headline }}</h2>
						<p>{{ block.settings.lead_before }}{{ block.settings.stat }}{{ block.settings.lead_after }}</p>
						<p class="rb-fallback-cite">{{ block.settings.citation }}</p>
					</li>
				{%- endfor -%}
			</ol>
			<h2>{{ section.settings.closing_headline }}</h2>
			<p>{{ section.settings.closing_lead }}</p>
			<p>
				{%- render 'cta-button',
					label: section.settings.cta_label,
					url: section.settings.cta_url,
					variant: 'shop'
				-%}
			</p>
			<p>{{ section.settings.ship_line }}</p>
			<p class="rb-fallback-cite">{{ section.settings.small_print }}</p>
		</div>
	</noscript>
</section>

<style>
	.research-book {
		/* Page tokens. The first four map straight onto theme tokens; the
		   rest are defined by the design handoff for this page only (paper,
		   ink, cover cloth, spine, desk shades) and exist nowhere else in
		   the theme. Change them here, never inline below. */
		--rb-navy: var(--color-main);
		--rb-cream: var(--color-secondary);
		--rb-orange: var(--color-highlight);
		--rb-blue: var(--color-tertiary-light);
		/* Brand blue for the page-foot copy (citations, notes). Nudged toward
		   navy so it clears AA on the warm paper while reading as the token. */
		--rb-brand-blue: color-mix(in srgb, var(--color-highlight-blue) 88%, var(--color-main));
		--rb-ink: #16223A;
		--rb-paper: #FBF7EF;
		--rb-paper-2: #F4EDDF;
		--rb-cover-hi: #F7F1E6;
		--rb-cover-lo: #EBE1CD;
		--rb-spine-dark: #c33302;
		--rb-spine-lite: #d63a05;
		--rb-desk-mid: #0c2044;
		--rb-desk-deep: #081228;
		--rb-ember: #B84400;
		--rb-shade: #02060E;
		--rb-stack-a: #e9e1cf;
		--rb-stack-b: #f7f2e6;

		--rb-ink-85: color-mix(in srgb, var(--rb-ink) 85%, transparent);
		--rb-ink-70: color-mix(in srgb, var(--rb-ink) 72%, transparent);
		--rb-ink-55: color-mix(in srgb, var(--rb-ink) 55%, transparent);
		--rb-ink-12: color-mix(in srgb, var(--rb-ink) 12%, transparent);

		--rb-ph: min(74vh, 640px);
		--rb-pw: min(calc(var(--rb-ph) * 0.75), 88vw);
		--rb-turn: 1s cubic-bezier(0.65, 0.05, 0.18, 1);

		position: relative;
		overflow: hidden;
		font-family: var(--font-body);
		color: var(--rb-ink);
		background:
			radial-gradient(ellipse 90% 70% at 50% 20%, color-mix(in srgb, var(--rb-blue) 14%, transparent) 0%, transparent 60%),
			radial-gradient(ellipse 120% 90% at 50% 115%, color-mix(in srgb, var(--rb-ember) 8%, transparent) 0%, transparent 55%),
			linear-gradient(180deg, var(--rb-navy) 0%, var(--rb-desk-mid) 55%, var(--rb-desk-deep) 100%);
	}

	/* ---------- scene / book ---------- */
	.research-book .rb-scene {
		position: relative;
		min-height: 100vh;
		min-height: 100svh;
		display: flex; align-items: center; justify-content: center;
		/* Top clears the fixed site header; bottom leaves room for the pager. */
		padding: 112px 0 110px;
		/* Dragging turns pages, so text selection would fight the gesture. */
		user-select: none; -webkit-user-select: none;
	}
	.research-book .rb-shift { transform: translateX(calc(var(--rb-pw) / 2)); }
	@media (max-width: 980px) { .research-book .rb-shift { transform: none; } }

	.research-book .rb-bookwrap {
		position: relative;
		width: var(--rb-pw); height: var(--rb-ph);
		perspective: 3000px;
		/* Horizontal drags turn pages; vertical swipes keep scrolling the page. */
		touch-action: pan-y;
	}
	.research-book .rb-bookwrap::after {
		content: ""; position: absolute; left: -14%; right: -14%; bottom: -34px; height: 60px;
		background: radial-gradient(ellipse 60% 100% at 50% 50%, color-mix(in srgb, var(--rb-shade) 55%, transparent), transparent 70%);
		z-index: 0; pointer-events: none;
	}
	.research-book .rb-stack {
		position: absolute; top: 5px; bottom: 3px; width: 7px; z-index: 0;
		background: repeating-linear-gradient(90deg, var(--rb-stack-a) 0 1px, var(--rb-stack-b) 1px 2.4px);
		transition: transform 0.6s ease;
	}
	.research-book .rb-stack--right {
		right: -7px; border-radius: 0 3px 3px 0;
		box-shadow: 2px 3px 10px color-mix(in srgb, var(--rb-shade) 35%, transparent);
		transform-origin: right center;
	}
	.research-book .rb-stack--left {
		left: -7px; border-radius: 3px 0 0 3px;
		box-shadow: -2px 3px 10px color-mix(in srgb, var(--rb-shade) 35%, transparent);
		transform-origin: left center;
	}

	/* ---------- sheets ---------- */
	.research-book .rb-sheet {
		position: absolute; inset: 0;
		transform-origin: left center;
		transform-style: preserve-3d;
		transition: transform var(--rb-turn);
		will-change: transform;
	}
	.research-book .rb-sheet.rb-no-anim { transition: none; }
	.research-book .rb-face {
		position: absolute; inset: 0;
		backface-visibility: hidden; -webkit-backface-visibility: hidden;
		border-radius: 2px 6px 6px 2px;
		overflow: hidden;
	}
	.research-book .rb-face--back { transform: rotateY(180deg); border-radius: 6px 2px 2px 6px; }

	.research-book .rb-paper {
		background:
			linear-gradient(90deg, color-mix(in srgb, var(--rb-navy) 10%, transparent), color-mix(in srgb, var(--rb-navy) 2%, transparent) 26px, transparent 48px),
			linear-gradient(160deg, var(--rb-paper) 0%, var(--rb-paper-2) 100%);
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--rb-navy) 5%, transparent);
	}
	.research-book .rb-face--back.rb-paper {
		background:
			linear-gradient(-90deg, color-mix(in srgb, var(--rb-navy) 10%, transparent), color-mix(in srgb, var(--rb-navy) 2%, transparent) 26px, transparent 48px),
			linear-gradient(160deg, var(--rb-paper) 0%, var(--rb-paper-2) 100%);
	}
	.research-book .rb-backghost {
		position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
		font-family: var(--font-heading); font-weight: 700;
		font-size: calc(var(--rb-ph) * 0.3);
		color: color-mix(in srgb, var(--rb-navy) 3.5%, transparent);
		user-select: none;
	}
	.research-book .rb-backfoot {
		position: absolute; bottom: 18px; left: 0; right: 0; text-align: center;
		font-family: var(--font-heading); font-size: 12px; font-weight: 600;
		letter-spacing: 0.22em; text-transform: uppercase;
		color: color-mix(in srgb, var(--rb-navy) 18%, transparent);
	}

	/* ---------- cover ---------- */
	.research-book .rb-cover {
		background:
			radial-gradient(ellipse 120% 90% at 30% 0%, color-mix(in srgb, white 50%, transparent), transparent 55%),
			linear-gradient(160deg, var(--rb-cover-hi) 0%, var(--rb-cream) 55%, var(--rb-cover-lo) 100%);
		color: var(--rb-ink);
		display: flex; flex-direction: column;
	}
	.research-book .rb-cover::before {
		content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 12px;
		background: linear-gradient(90deg, var(--rb-spine-dark), var(--rb-orange) 55%, var(--rb-spine-lite));
		box-shadow: 4px 0 14px color-mix(in srgb, black 30%, transparent);
	}
	.research-book .rb-cover-in {
		flex: 1; display: flex; flex-direction: column; justify-content: space-between;
		padding: 12% 11% 10% 15%; position: relative;
	}
	.research-book .rb-cover-logo {
		display: block; align-self: flex-start; width: auto;
		height: clamp(32px, calc(var(--rb-ph) * 0.065), 46px);
	}
