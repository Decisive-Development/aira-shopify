		display: flex; align-items: center; justify-content: center;
		transition: background 0.25s ease, opacity 0.25s ease;
	}
	.research-book .rb-arrow:hover { background: color-mix(in srgb, var(--rb-cream) 22%, transparent); }
	.research-book .rb-arrow[disabled] { opacity: 0.3; cursor: default; }
	.research-book .rb-ticks { display: flex; gap: 5px; align-items: center; }
	.research-book .rb-ticks button {
		width: 7px; height: 12px; border-radius: 2px; border: none; cursor: pointer; padding: 0;
		background: color-mix(in srgb, var(--rb-cream) 28%, transparent);
		transition: background 0.25s ease, transform 0.25s ease;
	}
	.research-book .rb-ticks button:hover { background: color-mix(in srgb, var(--rb-cream) 60%, transparent); }
	.research-book .rb-ticks button[aria-current="true"] { background: var(--rb-orange); transform: scaleY(1.25); }
	.research-book .rb-pagelabel {
		font-family: var(--font-heading); font-weight: 600; font-size: 12px;
		letter-spacing: 0.05em; color: var(--rb-cream);
