				<p class="flex items-center gap-1.5">
					{%- render 'icon-shield', classes: 'size-3.75 shrink-0' -%}
					<strong class="font-bold">{{ 'snippets.cart_drawer.guarantee' | t }}</strong>
				</p>
			</div>
		{%- endif -%}
	</div>

	{%- comment -%}
		── Solid nav — slides in on scroll ──
		Cream on desktop. On phones it turns navy, with the white logo and
		icons, so the free shipping tab hangs from it as from the top nav.
	{%- endcomment -%}
	<div class="nav-solid absolute top-0 inset-x-0 pt-2">
		<div class="container-contained">
		<div
			class="nav-solid-bar header-shadow relative w-full bg-main md:bg-secondary rounded-2xl flex items-center gap-4 md:gap-10 px-6 py-3"
			data-header-row="solid"
		>

			{%- comment -%} Mobile: hamburger at the start side {%- endcomment -%}
