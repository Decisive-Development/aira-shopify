			>
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
				</svg>
			</button>

			{%- comment -%} Logo — centred on mobile, left on desktop {%- endcomment -%}
			<a href="{{ routes.root_url }}" class="flex items-center shrink-0 absolute left-1/2 -translate-x-1/2 md:static md:translate-x-0">
				<img
					src="{{ 'aira-logo-only-white.svg' | asset_url }}"
					alt="aira"
					class="h-7 w-auto md:hidden"
					width="28"
					height="28"
					loading="eager"
				>
				<img
					src="{{ 'aira-logo-text-blue.svg' | asset_url }}"
					alt="aira"
					class="h-7 w-auto -translate-y-0.5 hidden md:block"
					width="120"
					height="28"
					loading="eager"
				>
			</a>

