					</svg>
					<span data-cart-count-bubble class="absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-highlight text-white flex items-center justify-center text-[10px] font-bold leading-none {% if cart.item_count == 0 %}hidden{% endif %}">
