{%- comment -%}
	Policy — Content
	Renders the policy prose with a sticky TOC on desktop and a collapsed
	<details> TOC on mobile. The TOC is built client-side by
	assets/policy-page.js from the H2 headings inside .policy-prose.

	Content source, in order:
	  1. The native Shopify policy (Settings → Policies) named by the
	     "Policy" section setting. This is the source of truth: it is what
	     checkout links to, so the designed page renders the same words
	     rather than keeping a second copy that can drift.
	  2. The page body (page.content), so an editor can still override from
	     the Shopify page editor.
	  3. The verbatim HTML in the matching policy-*-default snippet, so the
	     page never goes blank while a native field is still empty.

	Tiers 2 and 3 come out in a follow-up once every native field is
	populated and verified live.
{%- endcomment -%}

{{ 'policy-page.css' | asset_url | stylesheet_tag }}

{%- comment -%}
	One setting names both the native policy and its fallback snippet, so no
	page template has to change to gain the native source.
{%- endcomment -%}
{%- case section.settings.default_content -%}
	{%- when 'terms' -%}
		{%- assign policy_body = shop.terms_of_service.body -%}
	{%- when 'returns' -%}
		{%- assign policy_body = shop.refund_policy.body -%}
	{%- when 'shipping' -%}
		{%- assign policy_body = shop.shipping_policy.body -%}
	{%- else -%}
		{%- assign policy_body = shop.privacy_policy.body -%}
{%- endcase -%}

<section class="relative bg-secondary text-main py-12 md:py-20">

	<div class="container mx-auto px-4 max-w-[1080px]">

		{%- comment -%}
			Mobile TOC — collapsed inside <details>. Hidden on ≥ md.
		{%- endcomment -%}
		<details class="md:hidden mb-8 border-b border-main/15 pb-4">
			<summary class="cursor-pointer font-body text-sm font-medium text-main flex items-center justify-between list-none">
				<span>On this page</span>
				<span class="text-main/50">▾</span>
			</summary>
			<nav class="mt-4" aria-label="On this page (mobile)" data-policy-toc></nav>
		</details>

		<div class="md:flex md:gap-12 lg:gap-16 md:items-start">

			{%- comment -%}
				Desktop TOC — sticky sidebar. Hidden on < md.
			{%- endcomment -%}
			<aside class="hidden md:block md:w-1/3 md:max-w-60 md:sticky md:top-24 md:self-start md:shrink-0">
				<nav aria-label="On this page" data-policy-toc class="policy-toc"></nav>
			</aside>

			{%- comment -%} Prose body — see content-source note above {%- endcomment -%}
			<article class="policy-prose flex-1 max-w-[720px] font-body text-base md:text-[17px] leading-[1.7] text-copy">
				{%- if policy_body != blank -%}
					{{ policy_body }}
				{%- elsif page.content != blank -%}
					{{ page.content }}
				{%- else -%}
					{%- case section.settings.default_content -%}
						{%- when 'terms' -%}
							{%- render 'policy-terms-default' -%}
						{%- when 'returns' -%}
							{%- render 'policy-returns-default' -%}
						{%- when 'shipping' -%}
							{%- render 'policy-shipping-default' -%}
						{%- else -%}
							{%- render 'policy-privacy-default' -%}
					{%- endcase -%}
				{%- endif -%}
			</article>

		</div>

	</div>

</section>

<script src="{{ 'policy-page.js' | asset_url }}" defer></script>

{% schema %}
{
	"name": "Policy — Content",
	"tag": "section",
	"class": "shopify-section",
	"settings": [
		{
			"type": "select",
			"id": "default_content",
			"label": "Policy",
			"info": "Which policy this page shows. The words come from Settings → Policies; the built-in copy is a fallback for while that field is empty.",
			"options": [
				{ "value": "privacy",  "label": "Privacy policy" },
				{ "value": "terms",    "label": "Terms of service" },
				{ "value": "returns",  "label": "Return & refund policy" },
				{ "value": "shipping", "label": "Shipping & delivery" }
			],
			"default": "privacy"
		}
	],
	"presets": [
		{ "name": "Policy — Content" }
	]
}
{% endschema %}
