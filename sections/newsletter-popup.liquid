{%- comment -%}
	Newsletter popup — email capture for the printed QR insert.

	Sells the 10% off welcome code and stays deliberately separate from the
	site-wide scratch offer popup (sections/scratch-offer-popup.liquid): this
	one is a resell lever aimed at people holding a printed insert, that one
	chases first orders. Different offer, different trigger, same modal shell.

	Opens ONLY on demand, never on a timer:
	  1. landing with ?signup=1 or #newsletter in the URL (the insert QR's
	     admin redirect appends signup=1)
	  2. a click on any element carrying [data-open-newsletter]
	  3. reopening itself after a signup post to show the result (success or
	     error), signalled by the redirect anchor #newsletter-popup

	UTM params are analytics-only: never read for logic, never stripped.

	The form is the shared `newsletter-form` snippet, tagged `newsletter, qr-insert`
	so print-sourced signups are attributable in the Customers admin. The shell
	and all its behaviour come from `modal-dialog` + assets/aira-modal.js.
{%- endcomment -%}

{%- capture newsletter_popup_body -%}
	{%- if section.settings.heading != blank -%}
		<h2 id="newsletter-popup-heading" class="font-heading heading-weight text-main text-2xl sm:text-3xl leading-tight tracking-tight pr-10">
			{{ section.settings.heading }}
		</h2>
	{%- endif -%}

	{%- if section.settings.subheading != blank -%}
		<p class="text-copy text-sm sm:text-base leading-relaxed mt-3">
			{{ section.settings.subheading }}
		</p>
	{%- endif -%}

	<div class="mt-6">
		{%- render 'newsletter-form',
			form_id: 'newsletter-popup',
			tags: 'newsletter, qr-insert',
			placeholder: section.settings.placeholder,
			button_label: section.settings.button_label,
			layout: 'stacked',
			show_states: true,
			success_text: section.settings.success_message
		-%}
	</div>
{%- endcapture -%}

{%- render 'modal-dialog',
	id: 'newsletter-popup-modal',
	labelledby: 'newsletter-popup-heading',
	body: newsletter_popup_body
-%}

<script>
(function () {
	var section = document.querySelector('#shopify-section-{{ section.id }}');
	if (!section) return;

	var card = section.querySelector('[data-modal-card]');
	if (!card) return;

	var MODAL_ID = 'newsletter-popup-modal';
	function open() { window.airaModal.open(MODAL_ID); }

	/* assets/aira-modal.js is deferred, so it has not run yet while this inline
	   script is parsed. Deferred scripts do finish before DOMContentLoaded, so
	   wait for that when the API is not up yet. */
	if (window.airaModal) { boot(); }
	else { document.addEventListener('DOMContentLoaded', boot); }

	function boot() {

		if (!window.airaModal) return;

		/* Manual hook for any future CTA. Kept as its own attribute rather than
		   the generic [data-modal-open] so existing markup keeps working. */
		document.addEventListener('click', function (e) {
			var trigger = e.target.closest('[data-open-newsletter]');
			if (!trigger) return;
			e.preventDefault();
			open();
		});

		/* Shopify redirects a signup post back with ?customer_posted=true plus the
		   posting form's anchor — the only per-form signal, since form state is
		   page-global (see snippets/newsletter-form.liquid). #newsletter-popup is
		   that internal anchor; ?signup=1 and #newsletter are the public triggers.
		   UTM params are analytics-only and never read here. */
		var params = new URLSearchParams(window.location.search);
		var hash = window.location.hash;

		/* Any other customer form's error re-render paints the page-global error
		   into this hidden card too; drop it so a manual open shows a clean form.
		   Stated as "not my anchor" rather than naming the other forms, so a
		   fourth form on the page cannot reintroduce the bug. */
		if (hash !== '#newsletter-popup') {
			var stray = card.querySelector('[data-newsletter-error]');
			if (stray) { stray.remove(); }
		}

		var shouldOpen = false;
		if (params.get('customer_posted') === 'true' && hash === '#newsletter-popup') {
			/* Post succeeded: the card holds the server-rendered success state.
			   Wins over any trigger params on the same URL. */
			shouldOpen = true;
		} else if (hash === '#newsletter-popup' && card.querySelector('[data-newsletter-error]')) {
			/* This form's post errored and it lives in a hidden modal, so reopen
			   it to show the inline error. Never fail silently. */
			shouldOpen = true;
		} else if (params.get('signup') === '1' || hash === '#newsletter') {
			shouldOpen = true;
		}

		if (shouldOpen) {
			/* Small delay so first paint lands before the popup covers it. */
			window.setTimeout(open, 300);
		}

		/* The browser's deferred scroll-to-fragment can land after open() and drop
		   focus back on the page behind the dialog; pull it back once loaded. */
		window.addEventListener('load', function () {
			if (window.airaModal.isOpen(MODAL_ID) && !card.contains(document.activeElement)) {
				var target = card.querySelector('[data-newsletter-success]') || card.querySelector('input[type="email"]');
				if (target) { target.focus(); }
			}
		});

		/* #newsletter only: the internal #newsletter-popup anchor must not reopen
		   the popup on unrelated in-page hash changes. */
		window.addEventListener('hashchange', function () {
			if (window.location.hash === '#newsletter') { open(); }
		});
	}
})();
</script>

{% schema %}
{
	"name": "Newsletter popup",
	"tag": "section",
	"class": "shopify-section",
	"settings": [
		{
			"type": "paragraph",
			"content": "The printed QR insert's 10% off popup. Hidden until someone lands with ?signup=1 or #newsletter in the URL, or clicks an element with data-open-newsletter. It reopens by itself only to show the signup result. It never opens on a plain visit or a timer. The site-wide free pouch popup is a separate section."
		},
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "Take 10% off your first kit"
		},
		{
			"type": "textarea",
			"id": "subheading",
			"label": "Supporting copy",
			"default": "Drop your email and we'll send your welcome code straight to your inbox."
		},
		{
			"type": "text",
			"id": "placeholder",
			"label": "Email field placeholder",
			"default": "Your email"
		},
		{
			"type": "text",
			"id": "button_label",
			"label": "Button label",
			"default": "Get my code"
		},
		{
			"type": "textarea",
			"id": "success_message",
			"label": "Success message",
			"info": "Shown in place of the form after a successful signup. Never show the discount code here, it arrives by email.",
			"default": "Check your inbox. Your code is on its way."
		}
	],
	"presets": [
		{
			"name": "Newsletter popup"
		}
	]
}
{% endschema %}
