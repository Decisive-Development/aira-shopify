{%- comment -%}
	Contact — WhatsApp block. The one place the number is printed as text.
	Heading and button label are locale strings (contact.whatsapp_*) so
	Translate & Adapt can carry them; the number and its display form come
	from Theme settings → Support & contact. A blank number renders nothing.
	Sits between the hero and the form. The form section's own top padding is
	the gap below the card, so this section carries no bottom padding.
{%- endcomment -%}

{%- if settings.support_whatsapp_number != blank -%}
	{%- liquid
		assign wa_label = 'contact.whatsapp_open' | t
		assign wa_msg = 'contact.whatsapp_prefill' | t
	-%}
	<section class="bg-secondary pt-16 md:pt-24">
		<div class="container mx-auto px-4 max-w-[640px]">
			<div class="rounded-2xl bg-bg p-8 md:p-10 flex flex-col items-center text-center gap-4">
				<h2 class="font-heading heading-weight text-2xl md:text-3xl text-title m-0">{{ 'contact.whatsapp_heading' | t }}</h2>
				{%- if settings.support_whatsapp_display != blank -%}
					<p class="font-heading font-semibold text-xl text-title m-0" dir="ltr">{{ settings.support_whatsapp_display }}</p>
				{%- endif -%}
				{%- render 'whatsapp-link', source: 'contact', variant: 'button', label: wa_label, message: wa_msg -%}
			</div>
		</div>
	</section>
{%- endif -%}

{% schema %}
{
	"name": "Contact - WhatsApp",
	"settings": [
		{ "type": "paragraph", "content": "The number, its display form and the product-page switch live in Theme settings → Support & contact. A blank number hides this block. Wording comes from the theme's locale strings (contact.whatsapp_*), editable in Translate & Adapt." }
	],
	"presets": [{ "name": "Contact - WhatsApp" }]
}
{% endschema %}
