{%- comment -%}
	The /cart page. Visitors land here when they add to cart or tap the cart
	icon before the drawer's script has loaded (slow signal) or without JS,
	so the page is a plain form that works on its own: quantities post to
	the cart with Update, Remove is Shopify's own link, and Checkout submits
	the form with name="checkout" so a changed quantity is saved on the way.
	Every amount is Shopify's (line prices, the cart's order-level discounts,
	its total discount and total), so the page matches the drawer and
	checkout.

	With JS on, the drawer's script (snippets/cart-drawer.liquid, "The cart
	page") adds the free pouches the kits are owed once on load, notes a
	visitor who takes pouches below the kits as saying no to the gift, and
	draws this section again from Shopify whenever its cart differs from
	the one written here (data-cart-sig: variant, quantity and price per
	line, then the total, the way the script writes it).

	The header's top nav is white on a transparent bar outside product
	pages, so the page opens with a navy band like the site's other pages.
	Thumbnails: the product's cart thumbnail (custom.cart_thumbnail), as in
	the drawer, else the line's image, at a fixed 80px (96px from md) and
	requested at twice that, so a photo can never paint at full size.
{%- endcomment -%}
{%- liquid
	assign kit_product = all_products['aira-kit']
	capture cart_sig
		for item in cart.items
			echo item.variant_id | append: ':' | append: item.quantity | append: ':' | append: item.final_line_price | append: ','
		endfor
		echo cart.total_price
	endcapture
	assign chip_classes = 'inline-flex items-center gap-1 rounded-md bg-tertiary-light/15 px-2 py-0.5 text-xs font-semibold text-main'
-%}
<div data-cart-page data-section-url="{{ routes.cart_url }}?section_id={{ section.id }}" data-cart-sig="{{ cart_sig }}">
	<section class="bg-main text-secondary pt-28 md:pt-36 pb-8 md:pb-12">
		<div class="container-contained">
			<h1 class="font-heading font-bold text-secondary text-3xl md:text-5xl">{{ 'snippets.cart_drawer.your_cart' | t }}</h1>
		</div>
	</section>

	<section class="bg-bg py-8 md:py-14">
		<div class="container-contained">
			{%- if cart.item_count > 0 -%}
				<form action="{{ routes.cart_url }}" method="post" class="grid gap-8 lg:grid-cols-3 lg:gap-12 lg:items-start" data-cart-page-form>
					<ul role="list" class="lg:col-span-2 divide-y divide-bg-muted border-y border-bg-muted">
						{%- for item in cart.items -%}
							{%- assign line_thumb = item.product.metafields.custom.cart_thumbnail.value | default: item.image -%}
							{%- assign line_id = 'cart-line-' | append: forloop.index -%}
							<li class="flex items-start gap-4 py-5 md:gap-6 md:py-6" data-cart-page-line data-variant-id="{{ item.variant_id }}" data-handle="{{ item.product.handle }}">
								<div class="shrink-0 size-20 md:size-24 overflow-hidden rounded-xl border border-bg-muted bg-bg">
									{%- if line_thumb -%}
										{%- render 'image', image: line_thumb, width: 192, alt: '', class: 'size-full *:size-full *:object-contain' -%}
									{%- endif -%}
								</div>
								<div class="flex-1 min-w-0">
									<div class="flex items-start justify-between gap-3">
										<div class="min-w-0">
											{%- comment -%} The drawer's naming: the product's short name when it has one, and the variant only when there are several. {%- endcomment -%}
											{%- assign line_name = item.product.metafields.custom.short_name.value | default: item.product.title -%}
											<a href="{{ item.url }}" id="{{ line_id }}-title" class="font-heading font-semibold text-title text-base md:text-lg leading-snug hover:underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-main">
												{%- render 'product-title', title: line_name -%}
											</a>
											{%- if item.product.variants.size > 1 -%}
												<p class="text-copy text-sm mt-0.5">{{ item.variant.title }}</p>
											{%- endif -%}
											{%- if item.selling_plan_allocation -%}
												<p class="text-copy text-sm mt-0.5">{{ item.selling_plan_allocation.selling_plan.name }}</p>
											{%- endif -%}
											{%- comment -%}
												Discount labels come off the line's allocations, as before: a
												zeroed gift line shows only the title of the offer that freed
												it; a paid line shows each discount with its amount.
											{%- endcomment -%}
											{%- if item.final_line_price == 0 and item.line_level_total_discount > 0 -%}
												{%- assign gift_alloc = item.line_level_discount_allocations | sort: 'amount' | last -%}
												{%- if gift_alloc.amount > 0 -%}
													<p class="mt-1.5"><span class="{{ chip_classes }}">{%- render 'icon-tag', classes: 'size-3 shrink-0' -%}<span>{{ gift_alloc.discount_application.title | escape }}</span></span></p>
												{%- endif -%}
											{%- else -%}
												{%- for alloc in item.line_level_discount_allocations -%}
													{%- if alloc.amount > 0 -%}
														<p class="mt-1.5"><span class="{{ chip_classes }}">{%- render 'icon-tag', classes: 'size-3 shrink-0' -%}<span>{{ alloc.discount_application.title | escape }} <bdi>−{%- render 'price', cents: alloc.amount -%}</bdi></span></span></p>
													{%- endif -%}
												{%- endfor -%}
											{%- endif -%}
										</div>
										<div class="shrink-0 text-end leading-snug">
											{%- if item.original_line_price > item.final_line_price -%}
												<s class="block text-xs text-copy"><bdi>{%- render 'price', cents: item.original_line_price -%}</bdi></s>
											{%- endif -%}
											{%- if item.final_line_price == 0 -%}
												<span class="block font-heading font-bold text-base text-highlight">{{ 'snippets.cart_drawer.free' | t }}</span>
											{%- else -%}
												<span class="block font-heading font-bold text-base text-title"><bdi>{%- render 'price', cents: item.final_line_price -%}</bdi></span>
											{%- endif -%}
										</div>
									</div>
									<div class="mt-3 flex flex-wrap items-center gap-3">
										<label for="{{ line_id }}-qty" class="sr-only">{{ 'cart.quantity' | t }}</label>
										<input
											id="{{ line_id }}-qty"
											type="number"
											name="updates[]"
											value="{{ item.quantity }}"
											min="0"
											inputmode="numeric"
											aria-describedby="{{ line_id }}-title"
											class="h-11 w-16 rounded-xl border border-main/20 bg-bg px-2 text-center text-base text-main focus:outline-none focus:border-main"
										>
										{%- assign update_label = 'cart.update' | t -%}
										{%- render 'cta-button', label: update_label, variant: 'outline', size: 'sm', element: 'button', button_type: 'submit' -%}
										<a href="{{ item.url_to_remove }}" aria-describedby="{{ line_id }}-title" class="inline-flex min-h-11 items-center text-sm text-copy underline underline-offset-2 transition-colors hover:text-highlight focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-main" data-cart-page-remove>{{ 'cart.remove' | t }}</a>
									</div>
								</div>
							</li>
						{%- endfor -%}
					</ul>

					<div class="flex flex-col gap-3 rounded-2xl bg-cream-light p-5 md:p-6 lg:sticky lg:top-28">
						{%- comment -%}
							Order-level discounts, as the drawer's rows: the automatic
							offers first, then codes, each with what it took off the
							order. A code is told apart by its type alone (Shopify does
							not reliably label the automatic ones), so the first pass
							takes everything that is not a code.
						{%- endcomment -%}
						{%- for pass in (1..2) -%}
							{%- for app in cart.cart_level_discount_applications -%}
								{%- liquid
									assign is_code = false
									if app.type == 'discount_code'
										assign is_code = true
									endif
									if pass == 1 and is_code
										continue
									endif
									if pass == 2 and is_code == false
										continue
									endif
									if app.total_allocated_amount <= 0
										continue
									endif
								-%}
								{%- capture app_label -%}<bdi>{{ app.title | strip | escape }}</bdi>{%- endcapture -%}
								{%- if is_code and app.value_type == 'percentage' -%}
									{%- assign app_percent = app.value | append: '' -%}
									{%- assign app_percent_tail = app_percent | slice: -2, 2 -%}
									{%- if app_percent_tail == '.0' -%}{%- assign app_percent = app_percent | remove_last: '.0' -%}{%- endif -%}
									{%- assign app_label = 'snippets.cart_drawer.code_percent_off' | t: code: '__CODE__', percent: app_percent | replace: '__CODE__', app_label -%}
								{%- endif -%}
								<div class="flex items-center justify-between gap-3">
									<span class="{{ chip_classes }}">{%- render 'icon-tag', classes: 'size-3 shrink-0' -%}<span>{{ app_label }}</span></span>
									<span class="shrink-0 font-heading font-semibold text-base text-title"><bdi>−{%- render 'price', cents: app.total_allocated_amount -%}</bdi></span>
								</div>
							{%- endfor -%}
						{%- endfor -%}
						<div class="flex items-center justify-between gap-3">
							<div class="flex flex-wrap items-center gap-x-2 gap-y-1 min-w-0">
								<span class="font-heading font-semibold text-title text-base">{{ 'snippets.cart_drawer.subtotal' | t }}</span>
								{%- if cart.total_discount > 0 -%}
									{%- comment -%} `t` escapes what it interpolates, so the <bdi> amount goes in after it. {%- endcomment -%}
									{%- capture saved_html -%}<bdi>{%- render 'price', cents: cart.total_discount -%}</bdi>{%- endcapture -%}
									<span class="rounded-md bg-highlight px-2 py-0.5 text-xs font-bold text-white">{{ 'snippets.cart_drawer.you_save' | t: amount: '__AMOUNT__' | replace: '__AMOUNT__', saved_html }}</span>
								{%- endif -%}
							</div>
							<span class="shrink-0 font-heading font-bold text-title text-2xl"><bdi>{%- render 'price', cents: cart.total_price -%}</bdi></span>
						</div>
						{%- capture checkout_label -%}
							{%- render 'icon-lock' -%}
							{{- 'cart.checkout' | t -}}
						{%- endcapture -%}
						{%- render 'cta-button',
							label: checkout_label,
							variant: 'solid',
							size: 'lg',
							element: 'button',
							button_type: 'submit',
							full_width: true,
							attributes: 'name="checkout"',
							extra_classes: '!px-6 !text-base !font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-main'
						-%}
						<p class="flex items-center justify-center gap-1.5 text-center text-sm text-copy">
							{%- render 'icon-truck' -%}
							{{- 'general.free_shipping' | t -}}
						</p>
					</div>
				</form>
			{%- else -%}
				{%- render 'cart-empty-state', url: kit_product.url -%}
			{%- endif -%}
		</div>
	</section>
</div>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
