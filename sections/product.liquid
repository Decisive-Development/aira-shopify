{%- liquid
	assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
	assign has_selling_plans = false
	if product.selling_plan_groups.size > 0
		assign has_selling_plans = true
		assign sp_group = product.selling_plan_groups.first
		assign sp_first = sp_group.selling_plans.first
		assign sp_allocation = nil
		for alloc in current_variant.selling_plan_allocations
			if alloc.selling_plan.id == sp_first.id
				assign sp_allocation = alloc
				break
			endif
		endfor
	endif

	comment
		Launch offer: the Buy X Get Y automatic discount only zeroes the gift if
		the gift is in the cart, so the add-to-cart carries the gift variant id
		and cart-drawer adds it. Untick "Offer is running" to end it.
	endcomment
	assign gift_variant = nil
	assign gift_product = section.settings.gift_product | default: all_products['aira-refill-tabs']
	assign gift_variant_title = section.settings.gift_variant_title | default: '30'
	if section.settings.offer_enabled and gift_product != blank
		for v in gift_product.variants
			if v.title == gift_variant_title
				assign gift_variant = v
				break
			endif
		endfor
		if gift_variant == nil
			assign gift_variant = gift_product.first_available_variant
		endif
	endif

	comment
		2-kit offer (Theme settings > Offers). The picker renders on the kit
		alone, the one product the automatic discount "2 kits for $69.99" is
		limited to. Its prices are the kit's price and the saving setting,
		never typed: two kits minus the saving. With the picker on, its radios
		are the form's quantity field, so the hidden quantity input renders
		only without it, and the sticky bar carries data-sticky-* hooks for
		the script to swap its name, price and offer text.
	endcomment
	assign bundle_picker = false
	if settings.bundle_picker_enabled and product.handle == 'aira-kit' and has_selling_plans == false
		assign bundle_saving_cents = settings.bundle_saving | times: 100 | round
		if bundle_saving_cents > 0
			assign bundle_picker = true
			assign bundle_price = current_variant.price | times: 2 | minus: bundle_saving_cents
			# The second card's full value, struck through: two kits and their two free pouches.
			assign bundle_full_value = current_variant.price | times: 2
			if gift_variant
				assign bundle_gift_value = gift_variant.price | times: 2
				assign bundle_full_value = bundle_full_value | plus: bundle_gift_value
			endif
		endif
	endif
-%}

<style>
	/* .plan-card and .plan-perks live in assets/critical.source.css, shared with
	   sections/product-refill.liquid. They used to be defined here too and the
	   two copies drifted. */

	/* Accordion content — bullet lists */
	.product-info-content ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}
	.product-info-content li {
		display: flex;
		align-items: flex-start;
		gap: 0.625rem;
	}
	.product-info-content li > .bullet-icon {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		margin-top: 2px;
	}

	/* Step numbers in How to use — bold orange */
	.product-info-content li strong {
		font-weight: 700;
		color: var(--color-highlight, #FF4000);
	}

	/* Tutorial link below the How to use steps */
	.product-info-content ul + p {
		margin-top: 0.875rem;
	}
	.product-info-content a {
		font-weight: 600;
		color: var(--color-main);
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color 0.2s ease;
	}
	.product-info-content a:hover {
		color: var(--color-highlight);
	}
</style>


{%- comment -%} Top padding clears the nav plus the free shipping tab (28px, phones) or strip (36px, desktop) from the header. {%- endcomment -%}
<section class="bg-bg pt-24.5 md:pt-33 pb-8 md:pb-12" data-product-section>
	<div class="container-contained">

		{%- comment -%} ══════ Buy box ══════ {%- endcomment -%}
		<div class="grid lg:grid-cols-2 gap-3 lg:gap-14">

			{%- comment -%} ── Left: Media gallery (sticky on desktop) ── {%- endcomment -%}
			{%- render 'product-gallery', media: product.media, badge: section.settings.image_badge -%}

			{%- comment -%}
				── Right: Product info + form ──
				min-w-0: as a grid item the column would otherwise grow to the widest
				no-wrap line inside it (the community eyebrow row, the review card) and
				push the whole page past the phone width.
			{%- endcomment -%}
			<div class="flex flex-col gap-5 min-w-0">

				{%- comment -%}
					Rating line when Theme settings > Reviews holds a rating and a review
					count (the cart drawer reads the same two, so they always match),
					otherwise the guarantee badge. The line links to the reviews section
					on the page (sections/custom-reviews carries id="reviews"). Under it, the
					featured review card (Tom, 2026-10-11): one real review with the
					reviewer's photo, linking to the same place; hidden until a quote
					and a name are set.
				{%- endcomment -%}
				<div class="flex flex-col gap-3">
					{%- if settings.reviews_rating_value != blank and settings.reviews_rating_count != blank -%}
						{%- render 'rating-summary', rating: settings.reviews_rating_value, count: settings.reviews_rating_count, url: '#reviews' -%}
					{%- else -%}
						{%- render 'pretitle-badge', text: section.settings.pretitle_badge -%}
					{%- endif -%}
					{%- render 'featured-review',
						quote: section.settings.review_quote,
						body: section.settings.review_body,
						name: section.settings.review_name,
						image: section.settings.review_image,
						verified: section.settings.review_verified,
						url: '#reviews',
						product_id: product.id
					-%}
				</div>

				{%- comment -%}
					Title + description. With a headline set it is the large line and the
					h1, and the product name is screen-reader only, so the buy box starts
					about 40px higher on phones (Tom, 2026-10-11; overrides the SEO plan's
					h1). Without one the product name takes the line. The sticky bar
					still shows the product name.
				{%- endcomment -%}
				<div>
					{%- assign product_name = section.settings.hero_heading | default: product.title -%}
					{%- if section.settings.headline != blank -%}
						{%- comment -%}
							On desktop (lg and up) the headline is 2rem on a 2.25rem line, which
							puts "Experience life changing breathing," on the first line and the
							rest on the second in the 564px column, and the subtitle drops its
							width cap so it stays on one line there (Tom, 2026-10-21).
						{%- endcomment -%}
						<h1 class="font-heading font-semibold text-[2rem] md:text-5xl lg:text-[2rem] text-title leading-tight lg:leading-9">{{ section.settings.headline }}</h1>
						<p class="sr-only">{{ product_name }}</p>
					{%- else -%}
						<h1 class="font-heading font-semibold text-[2rem] md:text-5xl lg:text-[2rem] text-title leading-tight lg:leading-9">{{ product_name }}</h1>
					{%- endif -%}
					{%- if section.settings.product_subtitle != blank -%}
						<p class="text-copy text-base leading-relaxed mt-3 max-w-lg lg:max-w-none">{{ section.settings.product_subtitle }}</p>
					{%- elsif product.description != blank -%}
						<p class="text-copy text-base leading-relaxed mt-3 max-w-lg lg:max-w-none">{{ product.description }}</p>
					{%- endif -%}

					{%- comment -%}
						Info blocks ticked "Show under the headline" print their answer here
						as an open list (no title, no dropdown). The script below adds the
						tick icons, as it does for the dropdown lists.
					{%- endcomment -%}
					{%- for block in section.blocks -%}
						{%- if block.type == 'product_faq' and block.settings.show_under_headline -%}
							<div class="product-info-content text-copy text-sm leading-relaxed mt-4" {{ block.shopify_attributes }}>{{ block.settings.answer }}</div>
						{%- endif -%}
					{%- endfor -%}
				</div>

				<form action="{{ routes.cart_add_url }}" method="post" class="flex flex-col gap-5"{% if gift_variant %} data-gift-variant-id="{{ gift_variant.id }}"{% endif %}>
					<input type="hidden" name="id" value="{{ current_variant.id }}">
					{% unless bundle_picker -%}
					<input type="hidden" name="quantity" value="1">
					{%- endunless %}

					{%- comment -%} ── PLAN selector — only when a selling plan exists ── {%- endcomment -%}
					{%- if has_selling_plans -%}
						<input type="hidden" name="selling_plan" value="" data-selling-plan-input>
					{%- endif -%}

						<div class="flex flex-col gap-3">

						{%- if has_selling_plans -%}
						{%- comment -%} ── Subscription card ── {%- endcomment -%}
						<button
							type="button"
							class="plan-card relative flex flex-col gap-3 p-5 rounded-2xl border border-border bg-bg text-left"
							data-plan-btn="subscribe"
							data-selling-plan-id="{{ sp_first.id }}"
						>
							{%- if section.settings.plan_badge != blank -%}
								<span class="absolute -top-3 left-4 px-3 py-1 rounded-full bg-main text-white text-xs font-bold">
									{{ section.settings.plan_badge }}
								</span>
							{%- endif -%}

							<div class="flex items-center justify-between gap-4">
								<div>
									<span class="font-heading font-bold text-title text-lg leading-tight block">{{ section.settings.plan_title | default: 'The aira kit + monthly refills' }}</span>
									{%- if has_selling_plans and sp_allocation -%}
										{%- assign save_amount = current_variant.price | minus: sp_allocation.per_delivery_price -%}
										{%- if save_amount > 0 -%}
											{%- assign save_money = save_amount | money -%}<p class="text-highlight text-sm font-bold mt-0.5">{{ 'sections.product.save_on_refills' | t: amount: save_money }}</p>
										{%- endif -%}
									{%- elsif section.settings.plan_save_text != blank -%}
										<p class="text-highlight text-sm font-bold mt-0.5">{{ section.settings.plan_save_text }}</p>
									{%- endif -%}
								</div>
								<div class="text-right shrink-0">
									{%- if has_selling_plans and sp_allocation -%}
										<span class="text-copy text-sm line-through">{{ current_variant.price | money }}</span>
										<span class="font-heading font-bold text-title text-xl md:text-2xl block">{{ sp_allocation.per_delivery_price | money }}</span>
									{%- else -%}
										{%- if section.settings.plan_compare_price != blank -%}
											<span class="text-copy text-sm line-through">{{ section.settings.plan_compare_price }}</span>
										{%- endif -%}
										<span class="font-heading font-bold text-title text-xl md:text-2xl block">{{ section.settings.plan_price | default: current_variant.price | money }}</span>
									{%- endif -%}
								</div>
							</div>

							{%- comment -%} Plan perks checklist {%- endcomment -%}
							{%- assign perk_blocks = section.blocks | where: "type", "plan_perk" -%}
							{%- if perk_blocks.size > 0 -%}
								<ul class="plan-perks flex flex-col gap-2 mt-1">
									{%- for block in perk_blocks -%}
										<li class="flex items-start gap-2.5 text-sm text-copy" {{ block.shopify_attributes }}>
											{%- render 'icon-tick' -%}
											{{ block.settings.text }}
										</li>
									{%- endfor -%}
								</ul>
							{%- endif -%}
						</button>
						{%- endif -%}

						{%- comment -%}
							── One-time purchase card (default selected) ──
							A button while there is a plan to toggle between, a plain
							panel when the buy box has collapsed to one-time only.
						{%- endcomment -%}
						{%- comment -%}
							While the launch offer runs (gift_variant set), the card states the
							free pouch under the name, its worth and the struck bundle value,
							all from the two variants' prices, never typed (Tom, 2026-10-11).
						{%- endcomment -%}
						{%- comment -%}
							The ids exist only with the 1 kit / 2 kits cards, where the card is a
							radio's label: they give the radio a short name (name and price) and
							a description (the gift line) instead of the whole card.
						{%- endcomment -%}
						{%- capture onetime_card -%}
							<div class="flex items-start justify-between gap-4">
								<div>
									<span class="font-heading font-bold text-title text-lg leading-tight block"{% if bundle_picker %} id="kit-card-one-title"{% endif %}>{{ product_name }}</span>
									{%- if gift_variant -%}
										{%- assign gift_price = gift_variant.price | money -%}
										<span class="text-highlight text-sm font-bold block mt-0.5"{% if bundle_picker %} id="kit-card-one-line"{% endif %}>{{ 'sections.product.onetime_gift_line' | t: amount: gift_price }}</span>
									{%- endif -%}
								</div>
								<div class="text-end shrink-0">
									{%- if gift_variant -%}
										{%- assign bundle_value = current_variant.price | plus: gift_variant.price -%}
										<span class="text-highlight text-sm font-semibold line-through block">{{ bundle_value | money }}</span>
									{%- endif -%}
									<span class="font-heading font-bold text-title text-xl md:text-2xl block"{% if bundle_picker %} id="kit-card-one-price"{% endif %}>{{ current_variant.price | money }}</span>
								</div>
							</div>
							<div class="h-px bg-border"></div>
							{%- comment -%}
								What is in the box as one row (PDP clean brief, 22 Oct): the two
								items spread across the card with a hairline between them, 13px
								on screens under 380px. A container query stacks them, centred
								and without the divider, where even that will not fit, so the
								row never runs outside the card. A query cannot measure text, so
								the width it stacks below comes from the two lines' length: a
								short pair like the English (42 characters, 255px at 13px and
								281px at 14.5px) stacks below 16rem; a longer pair, like the
								Arabic as it reads today (63 characters, 439px at 14.5px), below
								28rem. Both class sets are written out whole for Tailwind.
							{%- endcomment -%}
							{%- liquid
								assign contents_strips = 'sections.product.contents_strips' | t
								assign contents_tabs = 'sections.product.contents_tabs' | t
								assign contents_chars = contents_strips.size | plus: contents_tabs.size
								if contents_chars > 46
									assign contents_stack = '@max-[28rem]:flex-col @max-[28rem]:gap-y-1'
									assign contents_divider = '@max-[28rem]:hidden'
								else
									assign contents_stack = '@max-[16rem]:flex-col @max-[16rem]:gap-y-1'
									assign contents_divider = '@max-[16rem]:hidden'
								endif
							-%}
							<div class="@container">
								<div class="flex items-center justify-around gap-x-3 font-body text-[14.5px] max-[380px]:text-[13px] leading-snug text-main/72 {{ contents_stack }}">
									<span class="whitespace-nowrap">{{ contents_strips }}</span>
									<span class="w-px h-4 shrink-0 bg-border {{ contents_divider }}" aria-hidden="true"></span>
									<span class="whitespace-nowrap">{{ contents_tabs }}</span>
								</div>
							</div>
						{%- endcapture -%}
						{%- if has_selling_plans -%}
							<button
								type="button"
								class="plan-card relative mb-1.5 flex flex-col gap-3 p-5 rounded-2xl border border-main bg-bg-soft text-left is-selected"
								data-plan-btn="onetime"
							>
								{{ onetime_card }}
							</button>
						{%- elsif bundle_picker -%}
							{%- comment -%}
								── 1 kit / 2 kits (Theme settings > Offers; design approved 21 Oct) ──
								The price card and a second card under it, each a <label> around
								a visually hidden native radio that IS the form's quantity field:
								the checked one is what Add to cart submits, arrow keys move the
								choice, and the card's has-checked utilities draw the navy edge on
								the checked card. The script swaps the button and sticky bar
								labels and notes the choice on the form for the cart drawer.
								Nothing reaches the cart until the button is pressed. One value
								message per card, the strike-through; amounts sit in <bdi>.
								PDP clean brief (22 Oct): 2 kits is checked on load, the cards
								sit 32px apart and card 2 sits 32px above the button (its 12px
								margin plus the form's 20px gap); only card 2 carries a pill.
							{%- endcomment -%}
							{%- liquid
								assign kit_price_money = current_variant.price | money
								assign bundle_price_money = bundle_price | money
							-%}
							{%- capture bundle_gift_html -%}<bdi>{{ bundle_gift_value | money }}</bdi>{%- endcapture -%}
							<div
								role="radiogroup"
								aria-label="{{ 'products.kit_page.picker_group_label' | t | escape }}"
								class="flex flex-col gap-8"
								data-bundle-picker
								data-price-one="{{ kit_price_money }}"
								data-price-two="{{ bundle_price_money }}"
								data-i18n-add-one="{{ 'products.kit_page.add_to_cart_price' | t: price: kit_price_money | escape_once }}"
								data-i18n-add-two="{{ 'products.kit_page.add_two_to_cart' | t: price: bundle_price_money | escape_once }}"
								data-i18n-sticky-one="{{ product_name | escape_once }}"
								data-i18n-sticky-two="{{ 'products.kit_page.sticky_two_kits' | t | escape_once }}"
							>
								{%- comment -%}
									The checked card's edge: the navy border plus a 1px ring, so the
									box never moves, on a white ground; the other card keeps its
									hairline. Keyboard focus on the input draws the focus ring on the
									card. Utilities, because the card's own border and shadow
									utilities would outrank a component rule.
								{%- endcomment -%}
								{%- assign kit_card_classes = 'relative flex flex-col gap-3 p-5 rounded-2xl border border-border bg-bg-soft shadow-sm cursor-pointer transition-[border-color,box-shadow,background-color] duration-200 motion-reduce:transition-none has-checked:border-main has-checked:ring-1 has-checked:ring-main has-checked:bg-bg has-focus-visible:outline-2 has-focus-visible:outline-offset-3 has-focus-visible:outline-main' -%}
								<label class="{{ kit_card_classes }}" data-kit-card>
									<input type="radio" name="quantity" value="1" class="sr-only" data-bundle-option aria-labelledby="kit-card-one-title kit-card-one-price"{% if gift_variant %} aria-describedby="kit-card-one-line"{% endif %}>
									{{ onetime_card }}
								</label>
								<label class="{{ kit_card_classes }} mb-3" data-kit-card>
									<input type="radio" name="quantity" value="2" class="sr-only" checked data-bundle-option aria-labelledby="kit-card-two-title kit-card-two-price"{% if gift_variant %} aria-describedby="kit-card-two-line"{% endif %}>
									{%- assign best_value_pill = 'products.kit_page.pill_best_value' | t -%}
									{%- render 'pill-badge', label: best_value_pill, classes: '-bottom-3 left-1/2 -translate-x-1/2' -%}
									<div class="flex items-start justify-between gap-4">
										<div>
											<span class="font-heading font-bold text-title text-lg leading-tight block" id="kit-card-two-title">{{ 'products.kit_page.two_kits_title' | t }}</span>
											{%- if gift_variant -%}
												{%- comment -%} `t` escapes what it interpolates, so the <bdi> goes in after it. {%- endcomment -%}
												<span class="text-highlight text-sm font-bold block mt-0.5" id="kit-card-two-line">{{ 'products.kit_page.two_kits_line' | t: amount: '__AMOUNT__' | replace: '__AMOUNT__', bundle_gift_html }}</span>
											{%- endif -%}
										</div>
										<div class="text-end shrink-0">
											{%- if gift_variant -%}
												<span class="text-highlight text-sm font-semibold line-through block"><bdi>{{ bundle_full_value | money }}</bdi></span>
											{%- endif -%}
											<span class="font-heading font-bold text-title text-xl md:text-2xl block" id="kit-card-two-price"><bdi>{{ bundle_price_money }}</bdi></span>
										</div>
									</div>
								</label>
							</div>
						{%- else -%}
							<div class="relative mb-1.5 flex flex-col gap-3 p-5 rounded-2xl border border-border bg-bg-soft shadow-sm">
								{{ onetime_card }}
							</div>
						{%- endif -%}

					</div>

					{%- comment -%}
						── Launch offer block ──
						Informational only. Prices come from the variants, never typed.
					{%- endcomment -%}
					{%- if section.settings.offer_enabled and section.settings.offer_box -%}
						{%- comment -%}
							The accent is highlighted inside the headline rather than sitting on
							its own line above it, the same `replace` the footer uses on "10% off
							your first kit". One plain-text setting, so the editor cannot leave
							two fields disagreeing with each other.
						{%- endcomment -%}
						{%- liquid
							assign offer_headline_html = section.settings.offer_headline
							assign offer_accent = section.settings.offer_headline_accent
							if offer_accent != blank
								assign offer_accent_html = offer_accent | prepend: '<span class="text-highlight">' | append: '</span>'
								assign offer_headline_html = offer_headline_html | replace: offer_accent, offer_accent_html
							endif
							# Line breaks last, so the accent match is never split across one.
							# The headline is a textarea: where it wraps is a copy decision, so
							# it belongs to whoever writes it, not to the viewport.
							assign offer_headline_html = offer_headline_html | newline_to_br
						-%}
						<div class="rounded-xl bg-tertiary-light/20 px-5 py-5 shadow-sm text-center">
							{%- if section.settings.offer_eyebrow != blank -%}
								<p class="font-body text-xs font-extrabold uppercase tracking-[0.14em] text-main">{{ section.settings.offer_eyebrow }}</p>
							{%- endif -%}

							{%- if section.settings.offer_headline != blank -%}
								<p class="font-body text-xl font-extrabold leading-snug text-main{% if section.settings.offer_eyebrow != blank %} mt-2{% endif %}">{{ offer_headline_html }}</p>
							{%- endif -%}

							{%- if section.settings.offer_footnote != blank -%}
								<p class="mt-2 text-sm text-copy">{{ section.settings.offer_footnote }}</p>
							{%- endif -%}
						</div>
					{%- endif -%}

					{%- comment -%} ── Add to cart (cta-button shop/lg) ── {%- endcomment -%}
					{%- liquid
						assign atc_label = 'general.sold_out' | t
						assign atc_disabled = true
						if current_variant.available
							assign atc_label = 'general.add_to_cart' | t
							assign atc_disabled = false
							# With the 1 kit / 2 kits cards the label carries the price of the
							# choice, and 2 kits is the choice on load.
							if bundle_picker
								assign atc_label = 'products.kit_page.add_two_to_cart' | t: price: bundle_price_money
							endif
						endif
					-%}
					{%- render 'cta-button',
						label: atc_label,
						variant: 'shop',
						size: 'lg',
						element: 'button',
						button_type: 'submit',
						full_width: true,
						disabled: atc_disabled,
						attributes: 'data-add-to-cart',
						extra_classes: 'disabled:opacity-40 disabled:cursor-not-allowed'
					-%}

					{%- comment -%}
						── Delivery countdown (Theme settings > Delivery countdown) ──
						"Order in the next 43:12 for delivery by Thu 23 Oct", worked
						out in the browser from the cut-off, time zone, working days
						and delivery days in the settings, for the storefront's
						country (UAE unless it is Saudi Arabia). Liquid renders the
						same sentence first, in the shop's time zone and invisible,
						so the line already has its height when the script swaps the
						words in: no layout shift, and nothing shows if the script
						does not run. The script gets every setting as data
						attributes and does the maths itself.
					{%- endcomment -%}
					{%- if settings.countdown_enabled -%}
						{%- liquid
							assign cd_mode = settings.countdown_mode | default: 'rolling'
							assign cd_country = localization.country.iso_code | upcase
							if cd_country != 'SA'
								assign cd_country = 'AE'
							endif
							assign cd_days_ae = settings.delivery_days_ae | default: 2
							assign cd_days_sa = settings.delivery_days_sa | default: 3
							assign cd_work_ae = settings.working_days_ae | default: 'Mon,Tue,Wed,Thu,Fri,Sat'
							assign cd_work_sa = settings.working_days_sa | default: 'Sun,Mon,Tue,Wed,Thu'
							if cd_country == 'SA'
								assign cd_days = cd_days_sa | plus: 0
								assign cd_work = cd_work_sa
							else
								assign cd_days = cd_days_ae | plus: 0
								assign cd_work = cd_work_ae
							endif
							assign cd_work_list = cd_work | remove: ' ' | split: ','
							assign cd_day_names = 'Sun,Mon,Tue,Wed,Thu,Fri,Sat' | split: ','
							assign cd_cutoff = settings.countdown_cutoff | default: '14:00' | strip
							assign cd_cutoff_parts = cd_cutoff | split: ':'
							assign cd_cutoff_h = cd_cutoff_parts[0] | plus: 0
							assign cd_cutoff_m = cd_cutoff_parts[1] | plus: 0
							assign cd_cutoff_min = cd_cutoff_h | times: 60 | plus: cd_cutoff_m

							# Today, in the shop's time zone: the minute of the day and the epoch second.
							assign cd_now = 'now' | date: '%s' | plus: 0
							assign cd_now_h = 'now' | date: '%H' | plus: 0
							assign cd_now_m = 'now' | date: '%M' | plus: 0
							assign cd_now_min = cd_now_h | times: 60 | plus: cd_now_m
							assign cd_today_wd = 'now' | date: '%w' | plus: 0
							assign cd_today_name = cd_day_names[cd_today_wd]

							# Dispatch day: today before the cut-off on a working day, else the next working day.
							assign cd_dispatch = 0
							if cd_now_min < cd_cutoff_min and cd_work_list contains cd_today_name
								assign cd_dispatch = 0
							else
								for cd_i in (1..14)
									assign cd_t = cd_i | times: 86400 | plus: cd_now
									assign cd_wd = cd_t | date: '%w' | plus: 0
									assign cd_name = cd_day_names[cd_wd]
									if cd_work_list contains cd_name
										assign cd_dispatch = cd_i
										break
									endif
								endfor
							endif

							# Delivery: the order day (today in rolling mode, the dispatch day in daily
							# cut-off mode) plus the country's delivery days, as calendar days (Tom, 2026-10-21).
							if cd_mode == 'rolling'
								assign cd_delivery = cd_days
							else
								assign cd_delivery = cd_dispatch | plus: cd_days
							endif
							assign cd_delivery_t = cd_delivery | times: 86400 | plus: cd_now
							assign cd_delivery_wd = cd_delivery_t | date: '%a'
							assign cd_delivery_day = cd_delivery_t | date: '%d' | plus: 0
							assign cd_delivery_mon = cd_delivery_t | date: '%b'
							assign cd_date_text = cd_delivery_wd | append: ' ' | append: cd_delivery_day | append: ' ' | append: cd_delivery_mon

							# "2pm" from "14:00"; the script writes the Arabic form.
							assign cd_time_h12 = cd_cutoff_h | modulo: 12
							if cd_time_h12 == 0
								assign cd_time_h12 = 12
							endif
							assign cd_time_text = cd_time_h12
							if cd_cutoff_m > 0
								assign cd_time_mm = cd_cutoff_parts[1]
								assign cd_time_text = cd_time_text | append: ':' | append: cd_time_mm
							endif
							if cd_cutoff_h < 12
								assign cd_time_text = cd_time_text | append: 'am'
							else
								assign cd_time_text = cd_time_text | append: 'pm'
							endif

							# What shows: the timer (the rolling hour, or the last hour before the cut-off) or "by 2pm today / tomorrow / on Sunday".
							assign cd_until = cd_cutoff_min | minus: cd_now_min
							if cd_mode == 'rolling'
								assign cd_kind = 'timer'
							elsif cd_dispatch == 0 and cd_until > 60
								assign cd_kind = 'by'
								assign cd_day_text = 'products.kit_page.day_today' | t
							elsif cd_dispatch == 0
								assign cd_kind = 'timer'
							elsif cd_dispatch == 1
								assign cd_kind = 'by'
								assign cd_day_text = 'products.kit_page.day_tomorrow' | t
							else
								assign cd_kind = 'by'
								assign cd_dispatch_t = cd_dispatch | times: 86400 | plus: cd_now
								assign cd_dispatch_weekday = cd_dispatch_t | date: '%A'
								assign cd_day_text = 'products.kit_page.day_on' | t: weekday: cd_dispatch_weekday
							endif
						-%}
						{%- comment -%}
							The sentence: the line under the timer, or the whole "Order by"
							sentence when the timer is not running (daily cut-off mode outside
							its last hour). `t` escapes what it interpolates, so the bold
							spans go in after it.
						{%- endcomment -%}
						{%- capture cd_date_html -%}<span class="font-bold">{{ cd_date_text }}</span>{%- endcapture -%}
						{%- capture cd_time_html -%}<span class="font-bold">{{ cd_time_text }}</span>{%- endcapture -%}
						{%- if cd_kind == 'timer' -%}
							{%- capture cd_text_html -%}{{ 'products.kit_page.countdown_left' | t: date: '__DATE__' | replace: '__DATE__', cd_date_html }}{%- endcapture -%}
						{%- else -%}
							{%- capture cd_text_html -%}{{ 'products.kit_page.countdown_by' | t: time: '__TIME__', day: cd_day_text, date: '__DATE__' | replace: '__TIME__', cd_time_html | replace: '__DATE__', cd_date_html }}{%- endcapture -%}
						{%- endif -%}
						{%- capture cd_digit_html -%}<span class="countdown-slot"><span class="countdown-digit">0</span></span>{%- endcapture -%}
						<div
							class="invisible -mt-0.5 flex flex-col items-center gap-1 text-center text-main"
							data-delivery-countdown
							data-mode="{{ cd_mode }}"
							data-cutoff="{{ cd_cutoff | escape }}"
							data-tz="{{ settings.countdown_timezone | default: 'Asia/Dubai' | strip | escape }}"
							data-country="{{ cd_country }}"
							data-days-ae="{{ cd_days_ae }}"
							data-days-sa="{{ cd_days_sa }}"
							data-work-ae="{{ cd_work_ae | escape }}"
							data-work-sa="{{ cd_work_sa | escape }}"
							data-i18n-by="{{ 'products.kit_page.countdown_by' | t: time: '__TIME__', day: '__DAY__', date: '__DATE__' | escape_once }}"
							data-i18n-left="{{ 'products.kit_page.countdown_left' | t: date: '__DATE__' | escape_once }}"
							data-i18n-today="{{ 'products.kit_page.day_today' | t | escape_once }}"
							data-i18n-tomorrow="{{ 'products.kit_page.day_tomorrow' | t | escape_once }}"
							data-i18n-on="{{ 'products.kit_page.day_on' | t: weekday: '__WEEKDAY__' | escape_once }}"
						>
							{%- comment -%}
								The timer row: the stopwatch, then minutes and seconds as digit
								slots the script rolls like a clock (each new digit slides in
								from above, the old one drops out below; see .countdown-slot in
								critical.source.css), with the sentence under it. The number
								spans are dir="ltr" so the slots keep their order in Arabic.
								When the timer is not running the row is hidden and the sentence
								carries the small stopwatch instead, inline so a long sentence
								wraps after it. Nothing in it is red. Half its first size since the
								PDP clean brief (22 Oct): 17px stopwatch whose hand ticks once a
								second, 17px digits (18px on desktop), "min" and "sec" in the body
								face; the form's 20px gap less 2px leaves 18px under the button.
							{%- endcomment -%}
							<p class="flex items-center justify-center gap-x-1.5 font-heading leading-none"{% if cd_kind != 'timer' %} hidden{% endif %} data-countdown-clock>
								{%- render 'icon-stopwatch', classes: 'size-4.25 shrink-0', ticking: true -%}
								<span class="flex items-baseline gap-x-2" role="timer">
									<span class="flex items-baseline gap-x-1">
										<span class="text-[17px] lg:text-lg font-bold tabular-nums" dir="ltr" data-countdown-minutes>{{ cd_digit_html }}{{ cd_digit_html }}</span>
										<span class="font-body text-[13px] font-medium">{{ 'products.kit_page.countdown_min' | t }}</span>
									</span>
									<span class="flex items-baseline gap-x-1">
										<span class="text-[17px] lg:text-lg font-bold tabular-nums" dir="ltr" data-countdown-seconds>{{ cd_digit_html }}{{ cd_digit_html }}</span>
										<span class="font-body text-[13px] font-medium">{{ 'products.kit_page.countdown_sec' | t }}</span>
									</span>
								</span>
							</p>
							<p class="text-sm lg:text-[14.5px]" data-countdown-line>
								<span class="inline-flex align-middle me-1.5"{% if cd_kind == 'timer' %} hidden{% endif %} data-countdown-line-icon>{%- render 'icon-stopwatch', classes: 'size-4' -%}</span>
								<span data-countdown-text>{{ cd_text_html }}</span>
							</p>
						</div>
					{%- endif -%}

					{%- comment -%}
						Accepted payment marks, marks only (brief of 22 Oct). The form's
						gap is 20px; the negative margin leaves 12px above the row on
						phones and 16px on desktop, under the countdown or, with that
						off, under Add to cart. Not in the sticky bar.
					{%- endcomment -%}
					{%- render 'payment-marks', classes: '-mt-2 lg:-mt-1', id_scope: 'buybox' -%}

				</form>

				{%- comment -%}
					── Community strip (Tom, 2026-10-11) ──
					The shared UGC testimonials (the ugc_testimonial metaobject list, the
					same entries the ugc-gallery section shows elsewhere) as compact cards
					under the add to cart button, so the kit page carries them inside the
					buy box instead of as a full section further down. No heading row.
					The admin cannot reorder metaobjects (Shopify returns them newest
					first), so the "Community videos, in order" setting picks and orders
					them for this page; empty falls back to the whole list.
				{%- endcomment -%}
				{%- liquid
					assign ugc_entries = section.settings.ugc_entries
					if ugc_entries == blank or ugc_entries.size == 0
						assign ugc_entries = metaobjects.ugc_testimonial.values
					endif
				-%}
				{%- if section.settings.show_ugc and ugc_entries.size > 0 -%}
					{%- capture ugc_card_dir -%}{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}{%- endcapture -%}
					<div class="mt-2">
						{%- render 'ugc-strip', id: 'buy-box', entries: ugc_entries, layout: 'compact', card_dir: ugc_card_dir -%}
					</div>
				{%- endif -%}

				{%- comment -%} ── Trust badges ── {%- endcomment -%}
				{%- assign trust_blocks = section.blocks | where: "type", "trust_badge" -%}
				{%- render 'trust-badges', blocks: trust_blocks -%}

				{%- comment -%} ── Inline info accordions ── {%- endcomment -%}
				{%- assign faq_blocks = section.blocks | where: "type", "product_faq" -%}
				{%- if faq_blocks.size > 0 -%}
					<div class="flex flex-col gap-0 mt-2 [&>:last-child]:border-b-0">
						{%- for block in faq_blocks -%}
							{%- if block.settings.show_under_headline -%}{%- continue -%}{%- endif -%}
							<div class="border-b border-border" {{ block.shopify_attributes }}>
								<button
									type="button"
									class="group w-full flex items-center justify-between gap-4 py-4 text-left cursor-pointer"
									aria-expanded="false"
									data-faq-toggle
								>
									<span class="font-heading font-semibold text-title text-sm">{{ block.settings.question }}</span>
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="shrink-0 text-copy transition-transform duration-200 group-aria-expanded:rotate-45" aria-hidden="true">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/>
									</svg>
								</button>
								<div class="overflow-hidden transition-all duration-300 product-info-content" style="max-height: 0;">
									<div class="pb-4 text-copy text-sm leading-relaxed">{{ block.settings.answer }}</div>
								</div>
							</div>
						{%- endfor -%}
					</div>
					<template data-tick-template>{%- render 'icon-tick', variant: 'circle', classes: 'bullet-icon' -%}</template>
				{%- endif -%}

				{%- comment -%} ── Static FAQ pairs ── {%- endcomment -%}
				<div class="flex flex-col gap-4 pt-2">
					<div>
						<p class="font-heading font-semibold text-title text-sm">{{ 'sections.product.faq_snoring_question' | t }}</p>
						<p class="text-copy text-sm leading-relaxed mt-1">{{ 'sections.product.faq_snoring_answer' | t }}</p>
					</div>
					<div>
						<p class="font-heading font-semibold text-title text-sm">{{ 'sections.product.faq_fall_off_question' | t }}</p>
						<p class="text-copy text-sm leading-relaxed mt-1">{{ 'sections.product.faq_fall_off_answer' | t }}</p>
					</div>
				</div>

			</div>
		</div>

	</div>
</section>

{%- comment -%}
	══════ Sticky mobile add-to-cart bar ══════
	One line of name, offer note and prices, then a full-width button that
	also carries the free shipping line (Tom, 2026-10-11). The struck value is
	the kit plus the gift pouch, from the variants, like the card above.
{%- endcomment -%}
<div
	class="fixed bottom-0 inset-x-0 z-40 bg-secondary px-4 py-2 flex flex-col gap-2 lg:hidden translate-y-full transition-transform duration-300"
	data-sticky-bar
	style="box-shadow: 0 -4px 24px rgba(10,26,52,0.1);"
>
	<div class="flex items-baseline justify-between gap-3">
		<p class="min-w-0 truncate">
			<span class="font-heading font-semibold text-main text-sm"{% if bundle_picker %} data-sticky-name{% endif %}>{{ section.settings.hero_heading | default: product.title }}</span>
			{%- if section.settings.offer_enabled and section.settings.sticky_offer_text != blank -%}
				<span class="text-xs font-bold text-highlight ms-1"{% if bundle_picker %} data-sticky-offer{% endif %}>{{ section.settings.sticky_offer_text }}</span>
			{%- endif -%}
		</p>
		<p class="shrink-0 flex items-baseline gap-1.5">
			{%- if gift_variant -%}
				{%- assign sticky_bundle_value = current_variant.price | plus: gift_variant.price -%}
				<span class="text-base font-semibold text-highlight line-through"{% if bundle_picker %} data-sticky-struck{% endif %}>{{ sticky_bundle_value | money }}</span>
			{%- endif -%}
			<span class="font-heading font-bold text-main text-lg"{% if bundle_picker %} data-sticky-price{% endif %}>{{ current_variant.price | money }}</span>
		</p>
	</div>
	{%- liquid
		assign sticky_disabled = true
		if current_variant.available
			assign sticky_disabled = false
		endif
		assign sticky_shipping = 'general.free_shipping_short' | t
		assign sticky_atc = 'general.add_to_cart' | t
		assign sticky_label = sticky_shipping | append: ' · ' | append: sticky_atc
		if sticky_disabled
			assign sticky_label = 'general.sold_out' | t
		endif
	-%}
	{%- render 'cta-button',
		label: sticky_label,
		variant: 'shop',
		element: 'button',
		full_width: true,
		disabled: sticky_disabled,
		attributes: 'data-sticky-atc',
		extra_classes: 'disabled:opacity-40 disabled:cursor-not-allowed'
	-%}
</div>

<script>
(function () {
	var section = document.querySelector('[data-product-section]');
	if (!section) return;

	var sellingPlanInput = section.querySelector('[data-selling-plan-input]');
	var addBtn = section.querySelector('[data-add-to-cart]');
	var stickyBar = document.querySelector('[data-sticky-bar]');
	var stickyAtc = stickyBar ? stickyBar.querySelector('[data-sticky-atc]') : null;

	/* ── Rating line and featured review card: ease down to the reviews ──
	   On desktop assets/smooth-scroll.js already eases in-page links through
	   Lenis. Where Lenis is off (touch, small screens) the plain link would
	   jump, so scroll smoothly here instead. Reduced motion keeps the jump. */
	section.querySelectorAll('[data-rating-link]').forEach(function (ratingLink) {
		ratingLink.addEventListener('click', function (e) {
			if (window.lenis) return;
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			var target = document.getElementById((ratingLink.getAttribute('href') || '').slice(1));
			if (!target) return;
			e.preventDefault();
			target.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	});

	/* ── Featured review: slide through the posted reviews ──
	   The custom-reviews section embeds Judge.me's widget data for this
	   product (jdgm.data.reviewWidget), so the card can show the other reviews
	   after the one set in the editor: every few seconds the media, quote and
	   name slide out towards the start and the next review slides in from the
	   end (mirrored under dir=rtl). Reviews rated under four stars, anonymous
	   ones, video reviews, reviews without a photo and the one already on the
	   card are skipped. Reduced motion keeps
	   the card still, as does hovering it or a hidden tab. */
	var featured = section.querySelector('[data-featured-review]');
	if (featured && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		var track = featured.querySelector('[data-review-track]');
		var quoteEl = featured.querySelector('[data-review-quote]');
		var bodyEl = featured.querySelector('[data-review-body]');
		var nameEl = featured.querySelector('[data-review-name]');
		var initialTemplate = featured.querySelector('[data-review-initial-template]');
		var verifiedTemplate = featured.getAttribute('data-verified-template') || '%NAME%';
		var slideOut = document.documentElement.dir === 'rtl' ? 100 : -100;

		function postedReviews() {
			var all = window.jdgm && jdgm.data && jdgm.data.reviewWidget;
			if (!all) return [];
			var widget = all[featured.getAttribute('data-product-id')] || all[Object.keys(all)[0]];
			if (!widget || !widget.reviews) return [];
			var own = (featured.getAttribute('data-review-name') || '').toLowerCase();
			return widget.reviews.filter(function (r) {
				var hasVideo = (r.video_external_ids && r.video_external_ids.length) || (r.media_platform_hosted_video_infos && r.media_platform_hosted_video_infos.length);
				var hasPhoto = r.pictures_urls && r.pictures_urls.length;
				return Number(r.rating) >= 4 && r.reviewer_name && !r.is_anonymous_reviewer && (r.title || r.body) && hasPhoto && !hasVideo && r.reviewer_name.toLowerCase() !== own;
			}).map(function (r) {
				var pic = r.pictures_urls && r.pictures_urls[0];
				return {
					quote: r.title || (r.body || '').split(/[.!?]/)[0],
					body: r.title ? (r.body || '') : '',
					name: r.reviewer_name,
					initial: r.reviewer_initial || r.reviewer_name.charAt(0),
					image: pic ? (pic.small || pic.original) : '',
					verified: !!r.verified_buyer
				};
			});
		}

		function show(slide) {
			var oldMedia = track.querySelector('[data-review-media]');
			var media = null;
			if (slide.node) {
				media = slide.node;
			} else if (slide.image) {
				media = document.createElement('img');
				media.className = 'w-24 h-24 shrink-0 self-center object-cover';
				media.width = 192; media.height = 192; media.alt = ''; media.draggable = false; media.loading = 'lazy';
				media.setAttribute('data-review-media', '');
				media.src = slide.image;
			} else if (initialTemplate) {
				media = initialTemplate.content.firstElementChild.cloneNode(true);
				media.textContent = slide.initial;
			}
			if (oldMedia) oldMedia.remove();
			if (media) track.insertBefore(media, track.firstChild);
			if (slide.quoteHTML != null) {
				quoteEl.innerHTML = slide.quoteHTML;
				if (bodyEl) bodyEl.innerHTML = slide.bodyHTML;
				nameEl.innerHTML = slide.nameHTML;
			} else {
				quoteEl.textContent = slide.quote;
				if (bodyEl) bodyEl.textContent = slide.body;
				nameEl.textContent = slide.verified ? verifiedTemplate.split('%NAME%').join(slide.name) : slide.name;
			}
		}

		function startSlider() {
			var others = postedReviews();
			if (!others.length) return;
			var firstMedia = track.querySelector('img');
			if (firstMedia) firstMedia.setAttribute('data-review-media', '');
			var first = { node: firstMedia, quoteHTML: quoteEl.innerHTML, bodyHTML: bodyEl ? bodyEl.innerHTML : '', nameHTML: nameEl.innerHTML };
			var slides = [first].concat(others);
			var index = 0;
			setInterval(function () {
				if (document.hidden || featured.matches(':hover') || featured.matches(':focus-within')) return;
				var next = (index + 1) % slides.length;
				track.addEventListener('transitionend', function settle() {
					track.removeEventListener('transitionend', settle);
					track.style.transition = 'none';
					show(slides[next]);
					index = next;
					track.style.transform = 'translateX(' + (-slideOut) + '%)';
					void track.offsetWidth;
					track.style.transition = '';
					track.style.transform = '';
					track.style.opacity = '';
				});
				track.style.transform = 'translateX(' + slideOut + '%)';
				track.style.opacity = '0';
			}, 5000);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', startSlider);
		} else {
			startSlider();
		}
	}

	/* ── Selling plan toggle ── */
	var planBtns = section.querySelectorAll('[data-plan-btn]');
	var subscribeBtn = section.querySelector('[data-plan-btn="subscribe"]');

	function setPlan(type) {
		planBtns.forEach(function (b) {
			var isThis = b.getAttribute('data-plan-btn') === type;
			if (isThis) {
				b.classList.add('is-selected');
			} else {
				b.classList.remove('is-selected');
			}
		});

		if (sellingPlanInput) {
			if (type === 'subscribe' && subscribeBtn) {
				sellingPlanInput.value = subscribeBtn.getAttribute('data-selling-plan-id') || '';
			} else {
				sellingPlanInput.value = '';
			}
		}
	}

	planBtns.forEach(function (btn) {
		btn.addEventListener('click', function () {
			setPlan(btn.getAttribute('data-plan-btn'));
		});
	});

	/* ── Product FAQ accordion ── */
	var faqToggles = section.querySelectorAll('[data-faq-toggle]');
	faqToggles.forEach(function (btn) {
		btn.addEventListener('click', function () {
			var expanded = btn.getAttribute('aria-expanded') === 'true';
			var content = btn.nextElementSibling;
			btn.setAttribute('aria-expanded', !expanded);
			if (!expanded) {
				content.style.maxHeight = content.scrollHeight + 'px';
				content.addEventListener('transitionend', function handler() {
					content.style.maxHeight = 'none';
					content.removeEventListener('transitionend', handler);
				});
			} else {
				content.style.maxHeight = content.scrollHeight + 'px';
				requestAnimationFrame(function () {
					content.style.maxHeight = '0';
				});
			}
		});
	});

	/* ── Inject tick icons into accordion list items ── */
	var tickTemplate = section.querySelector('[data-tick-template]');
	if (tickTemplate) {
		section.querySelectorAll('.product-info-content li').forEach(function (li) {
			if (li.querySelector('strong')) return;
			li.insertBefore(tickTemplate.content.firstElementChild.cloneNode(true), li.firstChild);
		});
	}

	/* ── Sticky mobile bar ── */
	if (stickyBar && addBtn) {
		var observer = new IntersectionObserver(function (entries) {
			entries.forEach(function (entry) {
				if (entry.isIntersecting) {
					stickyBar.classList.add('translate-y-full');
					stickyBar.classList.remove('translate-y-0');
					document.dispatchEvent(new CustomEvent('aira:sticky-bar', { detail: { visible: false, bar: stickyBar } }));
				} else {
					stickyBar.classList.remove('translate-y-full');
					stickyBar.classList.add('translate-y-0');
					document.dispatchEvent(new CustomEvent('aira:sticky-bar', { detail: { visible: true, bar: stickyBar } }));
				}
			});
		}, { threshold: 0 });

		observer.observe(addBtn);

		stickyAtc.addEventListener('click', function () {
			addBtn.click();
		});
	}

	/* Microsoft Clarity tags, when its script is on the page. */
	function clarity(key, value) {
		if (typeof window.clarity === 'function') window.clarity('set', key, value);
	}

	/* ── 1 kit / 2 kits cards ──
	   The radios are the form's quantity field, so the choice reaches the
	   cart without this script, and the checked card's edge is CSS. What
	   the script adds: the Add to cart label with its price, the sticky
	   bar's name and price, and a note on the form that the cart drawer
	   turns into the cart attribute `_aira_bundle` once a 2-kit add has gone
	   through. The drawer restores the button's label from the markup it
	   finds at submit, so the swapped label survives an add. */
	var picker = section.querySelector('[data-bundle-picker]');
	var form = addBtn ? addBtn.closest('form') : null;
	if (picker && form) {
		var pickerI18n = picker.dataset;
		var stickyName = stickyBar ? stickyBar.querySelector('[data-sticky-name]') : null;
		var stickyPrice = stickyBar ? stickyBar.querySelector('[data-sticky-price]') : null;
		var stickyStruck = stickyBar ? stickyBar.querySelector('[data-sticky-struck]') : null;
		var stickyOffer = stickyBar ? stickyBar.querySelector('[data-sticky-offer]') : null;

		function pickedQty() {
			var on = picker.querySelector('[data-bundle-option]:checked');
			return on && on.value === '2' ? 2 : 1;
		}

		function applyPick() {
			var two = pickedQty() === 2;
			if (addBtn && !addBtn.disabled) addBtn.textContent = two ? pickerI18n.i18nAddTwo : pickerI18n.i18nAddOne;
			if (stickyName) stickyName.textContent = two ? pickerI18n.i18nStickyTwo : pickerI18n.i18nStickyOne;
			if (stickyPrice) stickyPrice.textContent = picker.getAttribute(two ? 'data-price-two' : 'data-price-one');
			/* For 2 kits the bar reads "2 kits $69.99" alone: no second
			   strike-through (the card's own strike-through is the value
			   message) and no singular "+ free refill pouch". */
			if (stickyStruck) stickyStruck.hidden = two;
			if (stickyOffer) stickyOffer.hidden = two;
			if (two) form.setAttribute('data-cart-attributes', JSON.stringify({ _aira_bundle: '2' }));
			else form.removeAttribute('data-cart-attributes');
		}

		picker.addEventListener('change', applyPick);
		/* Also after a return from the back-forward cache or a reload, where a
		   browser can restore the checked radio without firing change, and
		   once the drawer hands the button back after an add (a card changed
		   during the add would otherwise leave the old label). */
		window.addEventListener('pageshow', applyPick);
		form.addEventListener('aira:add-settled', applyPick);
		applyPick();
		/* Before the drawer's own submit handler (it listens on the document). */
		form.addEventListener('submit', function () { clarity('bundle_picker', String(pickedQty())); });
	}

	/* ── Delivery countdown ──
	   Every figure comes from the line's data attributes (see its markup).
	   The clock is read in the time zone given, calendar days are counted
	   in UTC (which has no daylight saving) and the line only shows once a
	   sentence has been worked out. A bad setting, a browser without Intl
	   or any other throw leaves it invisible: never "0:00". */
	var countdownEl = section.querySelector('[data-delivery-countdown]');
	if (countdownEl) {
		try { startCountdown(countdownEl); } catch (e) {}
	}

	function startCountdown(el) {
		var d = el.dataset;
		var DAY_NAMES = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
		var DAY_MS = 864e5;
		if (d.mode !== 'rolling' && d.mode !== 'cutoff') throw new Error('mode');
		var mode = d.mode;
		var cut = /^(\d{1,2}):(\d{2})$/.exec(d.cutoff || '');
		if (!cut) throw new Error('cutoff');
		var cutH = parseInt(cut[1], 10);
		var cutM = parseInt(cut[2], 10);
		if (cutH > 23 || cutM > 59) throw new Error('cutoff');
		var cutSec = cutH * 3600 + cutM * 60;
		var saudi = d.country === 'SA';
		var days = parseInt(saudi ? d.daysSa : d.daysAe, 10);
		if (!(days >= 0 && days <= 60)) throw new Error('days');
		var work = String(saudi ? d.workSa : d.workAe).replace(/\s/g, '').split(',').filter(function (name) {
			return DAY_NAMES.indexOf(name) > -1;
		});
		if (!work.length) throw new Error('working days');
		var arabic = (document.documentElement.lang || '').toLowerCase().indexOf('ar') === 0;
		/* Gregorian calendar and Western digits either way: plain ar-SA would
		   give a Hijri date, and the rest of the page counts in Western digits. */
		var locale = arabic ? 'ar-AE-u-ca-gregory-nu-latn' : 'en-GB';
		/* Throws a RangeError on a time zone the browser does not know. */
		var clockFmt = new Intl.DateTimeFormat('en-US', { timeZone: d.tz, hourCycle: 'h23', year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric', second: 'numeric' });
		var dateFmt = new Intl.DateTimeFormat(locale, { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
		var weekdayFmt = new Intl.DateTimeFormat(locale, { weekday: 'long', timeZone: 'UTC' });
		var timeText = arabic
			? new Intl.DateTimeFormat('ar-AE-u-nu-latn', cutM ? { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'UTC' } : { hour: 'numeric', hour12: true, timeZone: 'UTC' }).format(new Date(Date.UTC(2000, 0, 1, cutH, cutM)))
			: (cutH % 12 || 12) + (cutM ? ':' + pad(cutM) : '') + (cutH < 12 ? 'am' : 'pm');
		var clockEl = el.querySelector('[data-countdown-clock]');
		var lineIcon = el.querySelector('[data-countdown-line-icon]');
		var textEl = el.querySelector('[data-countdown-text]');
		var reduceMotion = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
		/* The four digit slots: minutes tens and units, then seconds. */
		var slots = Array.prototype.slice.call(el.querySelectorAll('.countdown-slot')).map(function (slot) {
			return { el: slot, cur: slot.querySelector('.countdown-digit'), value: '' };
		});
		if (slots.length !== 4 || !clockEl || !lineIcon || !textEl) throw new Error('markup');
		var last = '';

		function pad(n) {
			return (n < 10 ? '0' : '') + n;
		}

		/* The wall clock in the shop's zone, as numbers. */
		function clock() {
			var p = {};
			clockFmt.formatToParts(new Date()).forEach(function (part) {
				if (part.type !== 'literal') p[part.type] = parseInt(part.value, 10);
			});
			return p;
		}

		function isWorkDay(utcMidnight) {
			return work.indexOf(DAY_NAMES[new Date(utcMidnight).getUTCDay()]) > -1;
		}

		/* Dispatch day: today before the cut-off on a working day, else the
		   next working day. Then what the line says for this moment. */
		function state() {
			var p = clock();
			var today = Date.UTC(p.year, p.month - 1, p.day);
			var nowSec = p.hour * 3600 + p.minute * 60 + p.second;
			var dispatch = 0;
			if (!(nowSec < cutSec && isWorkDay(today))) {
				dispatch = 1;
				while (!isWorkDay(today + dispatch * DAY_MS) && dispatch < 14) dispatch += 1;
			}
			/* Delivery: the order day (today in rolling mode, the dispatch day
			   in daily cut-off mode) plus the country's delivery days, as
			   calendar days (Tom, 2026-10-21). */
			var delivery = (mode === 'rolling' ? 0 : dispatch) + days;
			var s = { date: dateFmt.format(new Date(today + delivery * DAY_MS + DAY_MS / 2)) };
			if (mode === 'rolling') {
				/* To the top of the clock hour: 60:00 on the hour, 00:01 just before it. */
				s.timer = 3600 - (p.minute * 60 + p.second);
			} else if (dispatch === 0 && cutSec - nowSec > 3600) {
				s.day = d.i18nToday;
			} else if (dispatch === 0) {
				s.timer = cutSec - nowSec;
			} else if (dispatch === 1) {
				s.day = d.i18nTomorrow;
			} else {
				s.day = d.i18nOn.replace('__WEEKDAY__', weekdayFmt.format(new Date(today + dispatch * DAY_MS + DAY_MS / 2)));
			}
			return s;
		}

		/* A sentence from its template: the time and the date in bold,
		   everything else as text nodes. */
		function sentence(template, values) {
			var frag = document.createDocumentFragment();
			String(template).split(/(__TIME__|__DAY__|__DATE__)/).forEach(function (part) {
				if (!part) return;
				if (part === '__TIME__' || part === '__DATE__') {
					var span = document.createElement('span');
					span.className = 'font-bold';
					span.textContent = values[part];
					frag.appendChild(span);
				} else {
					frag.appendChild(document.createTextNode(values[part] !== undefined ? values[part] : part));
				}
			});
			return frag;
		}

		/* One digit slot. The new digit slides in from above while the old
		   one drops out below, clipped by the slot (the clock-timer roll); a
		   plain swap when the visitor prefers reduced motion or the whole
		   number resets (the first draw, a change of sentence). A catch-up
		   after the tab was hidden rolls once. The leaving digit goes at the
		   end of its animation, or after it should the event never come; the
		   arriving digit sheds its animation class then too, so no finished
		   animation lingers on it. */
		function roll(slot, digit, instant) {
			if (slot.value === digit) return;
			slot.value = digit;
			if (instant || reduceMotion) {
				slot.cur.textContent = digit;
				return;
			}
			var stale = slot.el.querySelector('.countdown-digit-out');
			if (stale) stale.parentNode.removeChild(stale);
			var old = slot.cur;
			var next = document.createElement('span');
			next.className = 'countdown-digit countdown-digit-in';
			next.textContent = digit;
			old.className = 'countdown-digit countdown-digit-out';
			old.setAttribute('aria-hidden', 'true');
			slot.el.insertBefore(next, old);
			slot.cur = next;
			next.addEventListener('animationend', function () { next.classList.remove('countdown-digit-in'); });
			var gone = false;
			function remove() {
				if (gone) return;
				gone = true;
				if (old.parentNode) old.parentNode.removeChild(old);
			}
			old.addEventListener('animationend', remove);
			window.setTimeout(remove, 800);
		}

		/* Writes the sentence, and shows or hides the timer row, only when
		   the words change; between those, each tick only moves the digits
		   that changed. */
		function draw() {
			var s = state();
			var timer = s.timer != null;
			var key = (timer ? 't' : 'b' + s.day) + '|' + s.date;
			var changed = key !== last;
			if (changed) {
				last = key;
				var values = { __TIME__: timeText, __DAY__: s.day || '', __DATE__: s.date };
				textEl.textContent = '';
				textEl.appendChild(sentence(timer ? d.i18nLeft : d.i18nBy, values));
				clockEl.hidden = !timer;
				lineIcon.hidden = timer;
			}
			if (timer) {
				var digits = pad(Math.floor(s.timer / 60)) + pad(s.timer % 60);
				for (var i = 0; i < 4; i += 1) roll(slots[i], digits.charAt(i), changed);
			}
		}

		draw();
		el.classList.remove('invisible');
		clarity('countdown', mode);
		window.setInterval(function () {
			if (!document.hidden) { try { draw(); } catch (e) {} }
		}, 1000);
		document.addEventListener('visibilitychange', function () {
			if (!document.hidden) { try { draw(); } catch (e) {} }
		});
	}
})();
</script>

