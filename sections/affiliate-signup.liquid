{%- comment -%}
	Affiliate signup (brief v4, 25 November 2026). Shopify only.

	A creator opens their invite link, reads the agreement, picks a code name,
	signs, and is sent to a free Shopify checkout for one kit. The only section
	of templates/page.affiliate.json. Reached by link only (noindex in
	meta-tags.liquid).

	  /pages/affiliate?i=KIT-XXXXXXXX&h=<instagram handle>

	`i` is a one-use discount code for one free kit. The page asks the
	Storefront API whether that code can still be used (assets/affiliate-signup.js)
	and shows, in this order:
	  1. `i` missing or malformed: the private-link state.
	  2. The invite can be used: the agreement and the form.
	  3. It cannot, and this browser signed with it before: the "you're in" state.
	  4. It cannot, and there is no record: the private-link state.
	  5. No answer within 4 seconds: the agreement and the form. Checkout is the
	     real gate.
	The hero shows at once. Nothing shows below it until the state is known.
	With JavaScript off the page shows the private-link state.

	On submit the script opens a cart permalink: one kit (the product setting),
	the invite code, and six cart attributes that travel with the order. A
	Shopify Flow workflow reads them, so the attribute names are a contract:
	affiliate_code, client_code, instagram, signed_by, signed_at,
	agreement_version. Do not rename them.

	Nothing here posts to the theme or to any outside service. Checkout takes
	the email, phone and address.

	Navy from header to footer, a white card around every block of text. The
	agreement is English only (snippets/affiliate-agreement), so it sits in
	dir="ltr" islands. Everything else is translated. Codes, handles and links
	are Latin: dir="ltr".
{%- endcomment -%}

{%- liquid
	assign card_class = 'rounded-3xl bg-bg text-main p-6 md:p-10'
	assign heading_class = 'font-heading heading-weight text-2xl md:text-3xl text-title m-0'
	assign field_class = 'flex flex-col gap-1.5'
	assign label_class = 'text-xs font-semibold uppercase ltr:tracking-widest text-title'
	assign input_class = 'rounded-xl border border-main/20 px-4 py-3 text-base text-main bg-bg focus:outline-none focus:border-main focus:ring-2 focus:ring-main/20 aria-invalid:border-highlight read-only:bg-bg-muted'
	assign hint_class = 'text-sm text-copy'
	assign error_class = 'text-sm font-semibold text-main'
	assign panel_label_class = 'text-xs font-semibold uppercase ltr:tracking-widest text-secondary/70 m-0'

	comment
		Hero text: the section settings when filled, otherwise the locale
		strings, so Arabic works without a per-theme translation.
	endcomment
	assign hero_eyebrow = section.settings.eyebrow
	if hero_eyebrow == blank
		assign hero_eyebrow = 'sections.affiliate_signup.hero_eyebrow' | t
	endif
	assign hero_heading = section.settings.heading
	if hero_heading == blank
		assign hero_heading = 'sections.affiliate_signup.hero_heading' | t
	endif
	assign hero_description = section.settings.description
	if hero_description == blank
		assign hero_description = 'sections.affiliate_signup.hero_description' | t
	endif

	comment
		Each sentence keeps its placeholder in the locale file, so a translator
		can move it; the markup the script fills goes in after translation.
	endcomment
	assign handle_slot = '<span dir="ltr">@<span data-affiliate-handle></span></span>'
	assign invitation = 'sections.affiliate_signup.invitation' | t: handle: '%handle%' | replace: '@%handle%', handle_slot | replace: '%handle%', handle_slot
	assign success_code = 'sections.affiliate_signup.success_code' | t: code: '%code%' | replace: '%code%', '<strong class="block mt-2 font-heading heading-weight text-4xl md:text-5xl tracking-normal text-secondary break-all" dir="ltr" data-affiliate-code></strong>'
	assign success_link = 'sections.affiliate_signup.success_link' | t: link: '%link%' | replace: '%link%', '<strong class="block mt-1 text-title break-all" dir="ltr" data-affiliate-link></strong>'
	assign success_team = 'sections.affiliate_signup.success_team' | t: team_code: '%team%' | replace: '%team%', '<strong class="text-title" dir="ltr" data-affiliate-team-code></strong>'

	assign share_base = shop.url | remove: 'https://' | remove: 'http://' | append: '/discount/'

	comment
		The kit that goes to checkout: the product setting's first variant that
		can be bought. No id is written into the theme.
	endcomment
	assign kit = section.settings.kit
	assign kit_variant = kit.first_available_variant | default: kit.variants.first
-%}

{%- capture hero_footnote -%}
	<p class="m-0 mt-6" data-affiliate-invitation hidden>
		<span class="inline-block rounded-full border border-secondary/30 px-4 py-1.5 text-sm font-semibold text-secondary">{{ invitation }}</span>
	</p>
{%- endcapture -%}

{%- capture private_card -%}
	<h2 class="{{ heading_class }}">{{ 'sections.affiliate_signup.private_heading' | t }}</h2>
	<p class="text-base text-copy m-0 mt-3">{{ 'sections.affiliate_signup.private_body' | t }}</p>
{%- endcapture -%}

<div
	class="bg-main text-secondary"
	data-affiliate-signup
	data-variant-id="{{ kit_variant.id }}"
	data-cart-url="{{ routes.cart_url }}"
	data-country="{{ localization.country.iso_code }}"
	data-locale="{{ request.locale.iso_code }}"
	data-agreement-version="{{ section.settings.agreement_version | escape }}"
	data-share-base="{{ share_base | escape }}"
	data-msg-required="{{ 'sections.affiliate_signup.error_required' | t | escape_once }}"
	data-msg-handle="{{ 'sections.affiliate_signup.error_handle' | t | escape_once }}"
	data-msg-code-checking="{{ 'sections.affiliate_signup.code_checking' | t | escape_once }}"
	data-msg-code-available="{{ 'sections.affiliate_signup.code_available' | t: code: '%code%' | escape_once }}"
	data-msg-code-taken="{{ 'sections.affiliate_signup.code_taken' | t: code: '%code%' | escape_once }}"
	data-msg-code-invalid="{{ 'sections.affiliate_signup.code_invalid' | t | escape_once }}"
	data-msg-code-unknown="{{ 'sections.affiliate_signup.code_unknown' | t | escape_once }}"
>
	{%- render 'page-hero',
		image: section.settings.hero_image,
		eyebrow: hero_eyebrow,
		heading: hero_heading,
		description: hero_description,
		height: 'tall',
		scrim: 'main',
		footnote: hero_footnote
	-%}

	<div class="mx-auto flex min-h-[40svh] max-w-2xl flex-col gap-4 px-4 pt-2 pb-16 md:gap-6 md:pb-24">

		{%- comment -%} Without JavaScript nothing can be checked, so the page stays closed. {%- endcomment -%}
		<noscript>
			<div class="{{ card_class }} text-center">{{ private_card }}</div>
		</noscript>

		<div class="{{ card_class }} text-center" data-affiliate-state="private" hidden>{{ private_card }}</div>

		{%- comment -%} "You're in": this browser signed with this invite, and the invite has been used. {%- endcomment -%}
		<div class="{{ card_class }}" data-affiliate-state="success" hidden>
			<h2 class="font-heading heading-weight text-3xl md:text-4xl text-title m-0">{{ 'sections.affiliate_signup.success_heading' | t }}</h2>

			<div class="mt-6 rounded-2xl bg-main p-6 md:p-8 text-center text-secondary">
				<p class="{{ panel_label_class }}">{{ success_code }}</p>
				<div class="mt-5">
					{%- capture copy_code_label -%}<span aria-live="polite" data-affiliate-copy-label>{{ 'sections.affiliate_signup.copy_code' | t }}</span>{%- endcapture -%}
					{%- capture copy_attributes -%}data-affiliate-copy="code" data-copied="{{ 'sections.affiliate_signup.copied' | t | escape_once }}"{%- endcapture -%}
					{%- render 'cta-button',
						label: copy_code_label,
						element: 'button',
						variant: 'outline',
						surface: 'dark',
						size: 'sm',
						attributes: copy_attributes
					-%}
				</div>
			</div>

			<p class="text-base text-copy m-0 mt-6">{{ 'sections.affiliate_signup.success_line' | t }}</p>

			<div class="mt-6 flex flex-col items-start gap-3 rounded-2xl bg-bg-muted p-5">
				<p class="text-base text-copy m-0">{{ success_link }}</p>
				{%- capture copy_link_label -%}<span aria-live="polite" data-affiliate-copy-label>{{ 'sections.affiliate_signup.copy_link' | t }}</span>{%- endcapture -%}
				{%- capture copy_attributes -%}data-affiliate-copy="link" data-copied="{{ 'sections.affiliate_signup.copied' | t | escape_once }}"{%- endcapture -%}
				{%- render 'cta-button',
					label: copy_link_label,
					element: 'button',
					variant: 'outline',
					size: 'sm',
					attributes: copy_attributes
				-%}
			</div>

			<p class="text-base text-copy m-0 mt-6" data-affiliate-team hidden>{{ success_team }}</p>

			<ol class="list-decimal ps-5 m-0 mt-8 flex flex-col gap-2 text-base text-copy">
				<li>{{ 'sections.affiliate_signup.success_step_1' | t }}</li>
				<li>{{ 'sections.affiliate_signup.success_step_2' | t }}</li>
				<li>{{ 'sections.affiliate_signup.success_step_3' | t }}</li>
				<li>{{ 'sections.affiliate_signup.success_step_4' | t }}</li>
			</ol>
		</div>

		<div class="flex flex-col gap-4 md:gap-6" dir="ltr" lang="en" data-affiliate-part="agreement" hidden>
			{%- render 'affiliate-agreement', card_class: card_class, heading_class: heading_class -%}
		</div>

		{%- comment -%}
			The form never posts: the script turns it into a checkout link. So it
			is a plain form, with no action and no Shopify form tag.
		{%- endcomment -%}
		<form id="affiliate-signup-form" class="flex flex-col gap-4 md:gap-6" novalidate data-affiliate-part="form" hidden>

			{%- comment -%}
				Card 1: Your code, the high point of the form. The creator types a
				name, the code shows large, and Shopify is asked whether it is free.
			{%- endcomment -%}
			<div class="{{ card_class }} flex flex-col gap-5" role="group" aria-labelledby="affiliate-card-code">
				<h2 id="affiliate-card-code" class="{{ heading_class }}">{{ 'sections.affiliate_signup.card_code' | t }}</h2>

				<div class="{{ field_class }}">
					<label for="affiliate-code-name" class="{{ label_class }}">{{ 'sections.affiliate_signup.code_name' | t }}</label>
					<input type="text" id="affiliate-code-name" required maxlength="12" autocomplete="off" autocapitalize="characters" autocorrect="off" spellcheck="false" dir="ltr" aria-describedby="affiliate-code-name-hint affiliate-code-status" class="{{ input_class }} uppercase">
					<span id="affiliate-code-name-hint" class="{{ hint_class }}">{{ 'sections.affiliate_signup.code_name_hint' | t }}</span>
				</div>

				<div class="rounded-2xl bg-main p-6 md:p-8 text-center text-secondary" data-affiliate-preview hidden>
					<p class="{{ panel_label_class }}">{{ 'sections.affiliate_signup.code_label' | t }}</p>
					<p class="m-0 mt-2 font-heading heading-weight text-4xl md:text-5xl text-secondary break-all" dir="ltr" data-affiliate-preview-code></p>
					<div class="mt-6 border-t border-secondary/20 pt-5" data-affiliate-preview-team hidden>
						<p class="{{ panel_label_class }}">{{ 'sections.affiliate_signup.team_code_label' | t }}</p>
						<p class="m-0 mt-2 font-heading heading-weight text-2xl md:text-3xl text-secondary break-all" dir="ltr" data-affiliate-preview-team-code></p>
						<p class="m-0 mt-2 text-sm text-secondary/70">{{ 'sections.affiliate_signup.team_code_note' | t }}</p>
					</div>
				</div>

				<p id="affiliate-code-status" class="m-0 flex items-start gap-2 text-sm font-semibold text-title" aria-live="polite" data-affiliate-code-status hidden>
					<span data-affiliate-code-ok hidden>{%- render 'icon-tick' -%}</span>
					<span data-affiliate-code-status-text></span>
				</p>

				<label class="flex items-start gap-3 cursor-pointer">
					<input type="checkbox" class="mt-1" data-affiliate-coach>
					<span class="text-base text-copy">{{ 'sections.affiliate_signup.coach' | t }}</span>
				</label>
			</div>

			{%- comment -%} Card 2: Sign. The agreement's closing line sits at the top. {%- endcomment -%}
			<div class="{{ card_class }} flex flex-col gap-5" role="group" aria-labelledby="affiliate-card-sign">
				<h2 id="affiliate-card-sign" class="{{ heading_class }}">{{ 'sections.affiliate_signup.card_sign' | t }}</h2>

				<div dir="ltr" lang="en">
					{%- render 'affiliate-agreement', part: 'closing' -%}
				</div>

				{%- comment -%} Prefilled and read-only when the link carries the handle; otherwise the creator types it. {%- endcomment -%}
				<div class="{{ field_class }}">
					<label for="affiliate-instagram" class="{{ label_class }}">{{ 'sections.affiliate_signup.instagram' | t }}</label>
					<div class="flex gap-2" dir="ltr">
						<span class="flex shrink-0 items-center rounded-xl border border-main/20 bg-bg-muted px-4 py-3 text-base text-copy" aria-hidden="true">@</span>
						<input type="text" id="affiliate-instagram" required maxlength="31" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" aria-describedby="affiliate-instagram-error" class="{{ input_class }} min-w-0 flex-1">
					</div>
					<span id="affiliate-instagram-error" class="{{ error_class }}" hidden></span>
				</div>

				<div class="{{ field_class }}">
					<label class="flex items-start gap-3 cursor-pointer">
						<input type="checkbox" id="affiliate-agreed" required aria-describedby="affiliate-agreed-error" class="mt-1">
						<span class="text-base text-copy">{{ 'sections.affiliate_signup.agree' | t }}</span>
					</label>
					<span id="affiliate-agreed-error" class="{{ error_class }}" hidden></span>
				</div>

				<div class="{{ field_class }}">
					<label for="affiliate-signature" class="{{ label_class }}">{{ 'sections.affiliate_signup.signature' | t }}</label>
					<input type="text" id="affiliate-signature" required minlength="2" maxlength="80" autocomplete="name" aria-describedby="affiliate-signature-error" class="{{ input_class }}">
					<span id="affiliate-signature-error" class="{{ error_class }}" hidden></span>
				</div>

				<div class="pt-1">
					{%- assign submit_label = 'sections.affiliate_signup.submit' | t -%}
					{%- render 'cta-button',
						label: submit_label,
						element: 'button',
						button_type: 'submit',
						variant: 'shop',
						size: 'lg',
						extra_classes: 'w-full text-center'
					-%}
				</div>
				<p class="m-0 {{ hint_class }}">{{ 'sections.affiliate_signup.submit_note' | t }}</p>
			</div>
		</form>

	</div>
</div>

<script src="{{ 'affiliate-signup.js' | asset_url }}" defer></script>

{% schema %}
{
	"name": "Affiliate signup",
	"tag": "section",
	"class": "shopify-section",
	"settings": [
		{
			"type": "image_picker",
			"id": "hero_image",
			"label": "Hero photo",
			"info": "Shown behind the heading, fading into navy. Best at 2000 px wide or more."
		},
		{
			"type": "text",
			"id": "eyebrow",
			"label": "Eyebrow",
			"info": "Leave empty to use the built-in wording, which is also translated into Arabic."
		},
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"info": "Leave empty to use the built-in wording."
		},
		{
			"type": "text",
			"id": "description",
			"label": "Description",
			"info": "Leave empty to use the built-in wording."
		},
		{
			"type": "product",
			"id": "kit",
			"label": "Free kit",
			"info": "The product the signed creator is sent to checkout with, one unit. The invite code makes it free."
		},
		{
			"type": "text",
			"id": "agreement_version",
			"label": "Agreement version",
			"default": "2.0",
			"info": "Travels with every signed order. Change it only when the agreement wording and its PDF change."
		}
	],
	"presets": [
		{ "name": "Affiliate signup" }
	]
}
{% endschema %}
