{%- comment -%}
	How it works — Hero
	Dark navy hero. Left: pill-free headline + lead. Right: portrait tutorial video
	(filmed on a phone) that opens in a popup/lightbox on click. Chapter strip seeks
	into the popup. Trust strip spans full width beneath.
{%- endcomment -%}

{%- liquid
	assign chapter_blocks = section.blocks | where: 'type', 'chapter'
	assign trust_blocks   = section.blocks | where: 'type', 'trust'
-%}

{%- liquid
	assign hl_text = section.settings.headline
	assign hl_accent = section.settings.headline_accent
	if hl_text != blank and hl_accent != blank and hl_text contains hl_accent
		assign hl_accent_wrapped = '<span class="text-tertiary-light/85">' | append: hl_accent | append: '</span>'
		assign hl_html = hl_text | replace: hl_accent, hl_accent_wrapped
	else
		assign hl_html = hl_text
	endif

	comment
		Resolve a single playable source: prefer an uploaded Shopify video
		(grab its mp4 source), otherwise fall back to the pasted MP4 URL.
	endcomment
	assign video_src = ''
	if section.settings.video != blank
		assign mp4_source = section.settings.video.sources | where: 'format', 'mp4' | first
		if mp4_source != blank
			assign video_src = mp4_source.url
		else
			assign video_src = section.settings.video.sources.first.url
		endif
	elsif section.settings.video_url != blank
		assign video_src = section.settings.video_url
	endif

	assign has_video = false
	if video_src != blank
		assign has_video = true
	endif

	comment
		Poster falls back to the uploaded video's preview frame.
	endcomment
	assign poster_image = section.settings.video_poster
	if poster_image == blank and section.settings.video != blank
		assign poster_image = section.settings.video.preview_image
	endif

	comment
		The poster is the cover frame of the tutorial, not decoration, so it
		carries a description. The image's own alt field in Shopify Files wins;
		the fallback describes the frame currently in the slot and should be
		replaced in Files whenever the tutorial is refilmed.
	endcomment
	assign poster_image_alt = poster_image.alt | default: 'Side profile of a woman pressing an aira tab into place just above her nostril'
-%}

<section class="relative overflow-hidden bg-main text-secondary pt-32 md:pt-40 pb-16 md:pb-25">

	{%- comment -%} Atmospheric radial washes (matching Our Story hero) {%- endcomment -%}
	<div
		class="absolute inset-0 pointer-events-none"
		style="background:
			radial-gradient(ellipse 60% 50% at 80% 20%, rgba(155,183,212,0.22), transparent 65%),
			radial-gradient(ellipse 60% 50% at 15% 90%, rgba(80,162,167,0.22), transparent 70%);"
	></div>

	<div class="container-contained relative z-10">

		<div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">

			{%- comment -%} Left — headline + lead {%- endcomment -%}
			<div class="text-center lg:text-left max-w-xl mx-auto lg:mx-0 reveal">
				{%- if hl_text != blank -%}
					<h1 class="font-heading heading-weight text-secondary text-4xl md:text-5xl lg:text-6xl leading-[1.05] tracking-tight">
						{{ hl_html }}
					</h1>
				{%- endif -%}

				{%- if section.settings.lead != blank -%}
					<p class="text-secondary/70 text-base md:text-lg leading-relaxed mt-5">
						{{ section.settings.lead }}
					</p>
				{%- endif -%}

				{%- comment -%} Chapter strip — 3 buttons under the hero copy {%- endcomment -%}
				{%- if chapter_blocks.size > 0 -%}
					<div class="mt-8 grid grid-cols-3 gap-2 md:gap-3">
						{%- for block in chapter_blocks -%}
							<button
								type="button"
								class="flex flex-col gap-1 text-left rounded-xl px-3 py-3 md:px-4 md:py-3.5 transition min-w-0 cursor-pointer border border-transparent hover:border-highlight"
								style="background: rgba(241, 235, 225, 0.06);"
								data-chapter-btn
								data-time="{{ block.settings.time_seconds }}"
								{{ block.shopify_attributes }}
							>
								<span class="font-heading font-bold text-secondary/70 text-[11px] md:text-xs leading-none tracking-wider">{{ block.settings.timestamp }}</span>
								<span class="text-secondary text-xs md:text-sm font-semibold leading-snug">{{ block.settings.title }}</span>
								{%- if block.settings.subtitle != blank -%}
									<span class="text-secondary/55 text-[10px] md:text-xs leading-snug hidden md:block">{{ block.settings.subtitle }}</span>
								{%- endif -%}
							</button>
						{%- endfor -%}
					</div>
				{%- endif -%}
			</div>

			{%- comment -%} Right — portrait video + chapter strip {%- endcomment -%}
			<div class="reveal">
				<div class="max-w-[320px] mx-auto">
					<div class="video-frame video-frame--portrait{% if has_video %} cursor-pointer{% endif %}" id="tutorialVideo" data-tutorial-video>
						{%- if poster_image != blank -%}
							<img
								class="video-cover"
								src="{{ poster_image | image_url: width: 800 }}"
								alt="{{ poster_image_alt | escape }}"
								width="320"
								height="569"
								loading="lazy"
							>
						{%- elsif has_video -%}
							<video class="video-cover" preload="metadata" muted playsinline>
								<source src="{{ video_src }}#t=0.1" type="video/mp4">
							</video>
						{%- else -%}
							<div class="video-placeholder">Tutorial video. Filmed in portrait.</div>
						{%- endif -%}

						{%- if has_video -%}
							<button class="video-play-big" data-tutorial-play aria-label="Play tutorial video">
								<span class="ring">
									<svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M8 5v14l11-7z"/>
									</svg>
								</span>
							</button>
							<div class="video-overlay"></div>
						{%- endif -%}
					</div>
				</div>
			</div>

		</div>

		{%- comment -%} Trust strip {%- endcomment -%}
		{%- if trust_blocks.size > 0 -%}
			<div class="mt-12 md:mt-16 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-secondary/60 text-xs uppercase tracking-widest">
				{%- for block in trust_blocks -%}
					<span {{ block.shopify_attributes }}>
						{{ block.settings.label }}
					</span>
					{%- unless forloop.last -%}
						<span class="hidden md:block w-1 h-1 rounded-full bg-highlight"></span>
					{%- endunless -%}
				{%- endfor -%}
			</div>
		{%- endif -%}

	</div>

	{%- comment -%}
		Popup / lightbox. Kept as a direct child of the section (outside any .reveal
		element) because .reveal uses a transform, which would make position:fixed
		resolve against it instead of the viewport.
	{%- endcomment -%}
	{%- if has_video -%}
		<div class="video-modal" data-video-modal hidden>
			<div class="video-modal__backdrop" data-video-close></div>
			<div class="video-modal__player" role="dialog" aria-modal="true" aria-label="Tutorial video">
				<button type="button" class="video-modal__close" data-video-close aria-label="Close video">&times;</button>
				<video
					controls
					playsinline
					preload="none"
					data-modal-video
					{% if poster_image != blank %}poster="{{ poster_image | image_url: width: 800 }}"{% endif %}
				>
					<source src="{{ video_src }}" type="video/mp4">
				</video>

				{%- comment -%}
					Shown only when the video was started muted (an arrival from the
					printed insert QR), because mobile browsers block un-muted
					programmatic playback. Tapping it restores sound. Sits top-left to
					mirror the close button and keep the portrait frame clear.
				{%- endcomment -%}
				<button
					type="button"
					class="absolute top-5 left-5 z-10 hidden items-center gap-2 rounded-xl bg-main/90 px-4 py-2.5 text-sm font-semibold text-secondary cursor-pointer transition hover:bg-main"
					data-video-unmute
				>
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M11 5 6 9H2v6h4l5 4V5z"/>
						<path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
						<path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
					</svg>
					Tap for sound
				</button>
			</div>
		</div>
	{%- endif -%}

</section>

<script>
(function () {
	var section = document.querySelector('#shopify-section-{{ section.id }}');
	if (!section) return;

	var modal    = section.querySelector('[data-video-modal]');
	var video    = modal ? modal.querySelector('[data-modal-video]') : null;
	var frameEl  = section.querySelector('[data-tutorial-video]');
	var chapters = section.querySelectorAll('[data-chapter-btn]');
	var unmuteBtn = modal ? modal.querySelector('[data-video-unmute]') : null;
	var STORAGE_KEY = 'aira.howItWorks.video.t';
	var lastFocus = null;

	if (!modal || !video) return;

	function seek(to) {
		if (typeof to !== 'number' || !isFinite(to) || to <= 0) return;
		var apply = function () {
			try { video.currentTime = video.duration ? Math.min(to, video.duration - 0.5) : to; } catch (e) {}
		};
		if (video.readyState >= 1) { apply(); }
		else { video.addEventListener('loadedmetadata', apply, { once: true }); }
	}

	function showUnmute(show) {
		if (!unmuteBtn) return;
		unmuteBtn.classList.toggle('hidden', !show);
		unmuteBtn.classList.toggle('flex', show);
	}

	/* startMuted: mobile browsers block un-muted programmatic playback, so an
	   arrival that is not a user gesture (the #video QR landing) must start
	   silent and offer a tap to restore sound. */
	function open(seekTo, startMuted) {
		lastFocus = document.activeElement;
		modal.hidden = false;
		document.body.classList.add('video-modal-open');
		seek(seekTo);
		video.muted = !!startMuted;
		showUnmute(!!startMuted);
		var p = video.play();
		if (p && p.catch) { p.catch(function () { /* autoplay blocked, controls are shown */ }); }
		var closeBtn = modal.querySelector('.video-modal__close');
		if (closeBtn) { closeBtn.focus(); }
	}

	function close() {
		document.body.classList.remove('video-modal-open');
		try {
			localStorage.setItem(STORAGE_KEY, String(video.currentTime || 0));
			video.pause();
		} catch (e) {}
		modal.hidden = true;
		video.muted = false;
		showUnmute(false);
		if (lastFocus && lastFocus.focus) { lastFocus.focus(); }
	}

	/* Clicking anywhere on the video frame opens the popup, resuming where you left off */
	if (frameEl) {
		frameEl.addEventListener('click', function () {
			var saved = parseFloat(localStorage.getItem(STORAGE_KEY) || '0');
			open(saved > 1 && isFinite(saved) ? saved : 0);
		});
	}

	/* Chapters open the popup and jump to their timestamp */
	chapters.forEach(function (b) {
		b.addEventListener('click', function () {
			chapters.forEach(function (x) { x.style.background = 'rgba(241, 235, 225, 0.06)'; });
			b.style.background = 'rgba(241, 235, 225, 0.18)';
			var t = parseFloat(b.getAttribute('data-time') || '0');
			open(isFinite(t) ? t : 0);
		});
	});

	/* Close: backdrop, close button, Escape */
	modal.querySelectorAll('[data-video-close]').forEach(function (el) {
		el.addEventListener('click', close);
	});
	document.addEventListener('keydown', function (e) {
		if ((e.key === 'Escape' || e.key === 'Esc') && !modal.hidden) { close(); }
	});

	/* Tap-to-unmute */
	if (unmuteBtn) {
		unmuteBtn.addEventListener('click', function () {
			video.muted = false;
			showUnmute(false);
			var p = video.play();
			if (p && p.catch) { p.catch(function () {}); }
		});
	}

	/* Arriving from the printed insert QR opens the tutorial from the start and
	   plays it muted. Any other visit behaves exactly as before.

	   The QR is printed as /qr/tutorial with no fragment and the inserts are
	   already in boxes, so the URL can never change. The 301 to this page does
	   carry utm_campaign, so that is the trigger that actually fires in the
	   wild; #video is kept as a shareable/manual entry point. Params are read
	   only, never stripped or rewritten, so Shopify Analytics is untouched.
	   (Signed off by Tom, 2026-07-19, as a deviation from brief §0/§3.) */
	function fromInsertCampaign() {
		try {
			return new URLSearchParams(window.location.search).get('utm_campaign') === 'insert_tutorial';
		} catch (e) { return false; }
	}

	function openFromHash() {
		if (window.location.hash === '#video' && modal.hidden) { open(0, true); }
	}

	window.setTimeout(function () {
		if (modal.hidden && (window.location.hash === '#video' || fromInsertCampaign())) {
			open(0, true);
		}
	}, 300);

	/* Hash only: the campaign param stays in the URL after a dismiss, so
	   re-checking it here would reopen the video on unrelated anchor clicks
	   (the final CTA links to #tutorialVideo). */
	window.addEventListener('hashchange', openFromHash);
})();
</script>

{% schema %}
{
	"name": "How it works — Hero",
	"tag": "section",
	"class": "shopify-section",
	"settings": [
		{
			"type": "text",
			"id": "headline",
			"label": "Headline",
			"default": "Three steps to life-changing breathing."
		},
		{
			"type": "text",
			"id": "headline_accent",
			"label": "Headline accent phrase",
			"info": "Phrase from the headline to highlight in soft light blue (must match exactly).",
			"default": "life-changing breathing"
		},
		{
			"type": "textarea",
			"id": "lead",
			"label": "Lead paragraph",
			"default": "Watch the 50-second tutorial, then walk through each step at your own pace. The whole routine takes under a minute once you've got it."
		},
		{
			"type": "header",
			"content": "Video"
		},
		{
			"type": "video",
			"id": "video",
			"label": "Upload video",
			"info": "Upload a Shopify-hosted video, filmed in portrait (phone). Opens in a popup on click. Takes priority over the URL below."
		},
		{
			"type": "url",
			"id": "video_url",
			"label": "Or paste an MP4 URL",
			"info": "Alternative to uploading. Use a Shopify-hosted .mp4 file URL. Ignored when a video is uploaded above."
		},
		{
			"type": "image_picker",
			"id": "video_poster",
			"label": "Video poster image",
			"info": "Portrait (9:16) thumbnail shown before the popup opens. Falls back to the uploaded video's preview frame when blank."
		}
	],
	"blocks": [
		{
			"type": "chapter",
			"name": "Chapter",
			"limit": 3,
			"settings": [
				{ "type": "text",   "id": "timestamp",     "label": "Timestamp",          "default": "00:00" },
				{ "type": "number", "id": "time_seconds",  "label": "Seek time (seconds)","default": 0 },
				{ "type": "text",   "id": "title",         "label": "Title",              "default": "Find your size" },
				{ "type": "text",   "id": "subtitle",      "label": "Subtitle (md+ only)","default": "L1–L4" }
			]
		},
		{
			"type": "trust",
			"name": "Trust item",
			"limit": 6,
			"settings": [
				{
					"type": "select",
					"id": "icon",
					"label": "Icon",
					"options": [
						{ "value": "star",  "label": "Star (hypoallergenic)" },
						{ "value": "moon",  "label": "Moon (drug-free)" },
						{ "value": "clock", "label": "Clock (60 seconds)" },
						{ "value": "check", "label": "Check (reusable)" }
					],
					"default": "star"
				},
				{ "type": "text", "id": "label", "label": "Label", "default": "Hypoallergenic" }
			]
		}
	],
	"presets": [
		{
			"name": "How it works — Hero",
			"blocks": [
				{ "type": "chapter", "settings": { "timestamp": "00:00", "time_seconds": 0,  "title": "Find your size",     "subtitle": "L1–L4" } },
				{ "type": "chapter", "settings": { "timestamp": "00:32", "time_seconds": 32, "title": "Prep your skin",     "subtitle": "Clean, dry, gentle" } },
				{ "type": "chapter", "settings": { "timestamp": "00:58", "time_seconds": 58, "title": "Apply tabs & strip",  "subtitle": "Shark fins up" } },
				{ "type": "trust", "settings": { "icon": "star",  "label": "Hypoallergenic" } },
				{ "type": "trust", "settings": { "icon": "moon",  "label": "Drug-free" } },
				{ "type": "trust", "settings": { "icon": "clock", "label": "Sets up in 60 seconds" } },
				{ "type": "trust", "settings": { "icon": "check", "label": "Reusable strip" } }
			]
		}
	]
}
{% endschema %}
