<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    {% # Charset and viewport first, then title, SEO and social tags %}
    {% render 'meta-tags' %}

    {% # Inlined CSS variables and @font-face %}
    {% render 'css-variables' %}

    {% # Inlined critical CSS, generated by scripts/build-critical-snippet.js %}
    <style>{% render 'critical-css' %}</style>

    {{ content_for_header }}
  </head>

  <body>
    {{ content_for_layout }}
  </body>
</html>
